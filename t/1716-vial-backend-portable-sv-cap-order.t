#!/usr/bin/env perl

use strict;
use warnings;

use File::Spec;
use FindBin;
use Test::More;

use lib File::Spec->catdir($FindBin::Bin, '..', 'perl');

use FSM::VIAL::ArchitectureScaleBackendEmission;
use FSM::VIAL::Backend::SVPortableVerilator;

my $scale_class = 'FSM::VIAL::ArchitectureScaleBackendEmission';
my $backend_class = 'FSM::VIAL::Backend::SVPortableVerilator';
my $construction = $scale_class->construct({
    backend_profile => 'sv_portable_verilator',
    level => 'reference_v1',
    reference_hial_text => slurp_raw(repo_path(
        'ppif', 'ahb_lite_subordinate.ppif')),
    reference_vial_text => slurp_raw(repo_path(
        'vial', 'ahb_subordinate_base_output_arbitration.vial')),
});
ok($construction->{ok}, 'portable-SystemVerilog reference construction succeeds');
my $route = $scale_class->build({construction => $construction});
ok($route->{ok}, 'portable-SystemVerilog reference route builds');

my $original_preflight =
    \&FSM::VIAL::Backend::SVPortableVerilator::_preflight_source_map_entry_count;
my $original_entries =
    \&FSM::VIAL::Backend::SVPortableVerilator::_source_map_entries;
my $original_command =
    \&FSM::VIAL::Backend::SVPortableVerilator::_command_record;

my ($accepted_preflight, $accepted_entry_calls) = (undef, 0);
my $accepted;
{
    no warnings 'redefine';
    local *FSM::VIAL::Backend::SVPortableVerilator::_preflight_source_map_entry_count = sub {
        $accepted_preflight = $original_preflight->(@_);
        return $accepted_preflight;
    };
    local *FSM::VIAL::Backend::SVPortableVerilator::_source_map_entries = sub {
        ++$accepted_entry_calls;
        return $original_entries->(@_);
    };
    $accepted = emit_reference();
}
ok($accepted->{ok}, 'accepted portable-SystemVerilog emission remains successful');
is($accepted_preflight, 54,
    'compact source-map preflight derives the exact accepted cardinality');
is($accepted_entry_calls, 1,
    'accepted emission materializes source-map entries exactly once');
is(scalar(@{$accepted->{source_map}{entries}}), $accepted_preflight,
    'materialized source map matches its compact preflight');
is(scalar(@{$accepted->{artifacts}}), 8,
    'accepted artifact inventory remains unchanged');

my ($byte_preflight_calls, $byte_entry_calls, $byte_command_calls) = (0, 0, 0);
my $byte_rejected;
{
    no warnings 'redefine';
    local *FSM::VIAL::Backend::SVPortableVerilator::_render_fixture = sub {
        return ('x' x 16_777_217, []);
    };
    local *FSM::VIAL::Backend::SVPortableVerilator::_preflight_source_map_entry_count = sub {
        ++$byte_preflight_calls;
        return $original_preflight->(@_);
    };
    local *FSM::VIAL::Backend::SVPortableVerilator::_source_map_entries = sub {
        ++$byte_entry_calls;
        return $original_entries->(@_);
    };
    local *FSM::VIAL::Backend::SVPortableVerilator::_command_record = sub {
        ++$byte_command_calls;
        return $original_command->(@_);
    };
    $byte_rejected = emit_reference();
}
ok(!$byte_rejected->{ok}, 'exact generated-source byte excess is rejected');
is_deeply($byte_rejected->{diagnostics}, [{
    code => 'VIAL_BACKEND_LIMIT_EXCEEDED',
    severity => 'error',
    message => 'generated SystemVerilog exceeds the 16 MiB backend cap',
    path => '/artifacts',
}], 'generated-source excess retains its exact diagnostic');
is($byte_preflight_calls, 0,
    'exact generated bytes retain precedence over source-map admission');
is($byte_entry_calls, 0,
    'generated-source excess creates no source-map entries');
is($byte_command_calls, 0,
    'generated-source excess creates no command records');
is_deeply($byte_rejected->{artifacts}, [],
    'generated-source excess publishes no partial artifact graph');

my ($map_entry_calls, $map_command_calls) = (0, 0);
my $map_rejected;
{
    no warnings 'redefine';
    local *FSM::VIAL::Backend::SVPortableVerilator::_preflight_source_map_entry_count = sub {
        return 1_000_001;
    };
    local *FSM::VIAL::Backend::SVPortableVerilator::_source_map_entries = sub {
        ++$map_entry_calls;
        return $original_entries->(@_);
    };
    local *FSM::VIAL::Backend::SVPortableVerilator::_command_record = sub {
        ++$map_command_calls;
        return $original_command->(@_);
    };
    $map_rejected = emit_reference();
}
ok(!$map_rejected->{ok}, 'known source-map cardinality excess is rejected');
is_deeply($map_rejected->{diagnostics}, [{
    code => 'VIAL_BACKEND_LIMIT_EXCEEDED',
    severity => 'error',
    message => 'backend source map exceeds its record cap',
    path => '/source_map/entries',
}], 'source-map excess retains its exact diagnostic');
is($map_entry_calls, 0,
    'known source-map excess is rejected before entry materialization');
is($map_command_calls, 0,
    'known source-map excess is rejected before command construction');
is($map_rejected->{source_map}, undef,
    'source-map excess returns no partial source map');
is_deeply($map_rejected->{artifacts}, [],
    'source-map excess publishes no partial artifact graph');

done_testing();

sub emit_reference {
    return $backend_class->emit({
        execution_ir => $route->{execution_ir},
        bridge_manifest => $route->{bridge_manifest},
        backend_inputs => $route->{backend_inputs},
        artifact_root => '.artifacts/tmp/vial/backend-cap-order',
        backend_profile => 'sv_portable_verilator',
    });
}

sub repo_path {
    return File::Spec->catfile($FindBin::Bin, '..', @_);
}

sub slurp_raw {
    my ($path) = @_;
    open my $fh, '<:raw', $path or die "Cannot read $path: $!";
    local $/;
    my $text = <$fh>;
    close $fh or die "Cannot close $path: $!";
    return $text;
}
