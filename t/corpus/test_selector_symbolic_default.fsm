(?fsm:test_selector_symbolic_default
  (+system
    (clock clk)
    (sreset reset)
  )

  (+size
    (MODE 2)
    (OTHER 2)
    (FLAG 1)
    (A 1)
    (B 1)
    (C 1)
    (D 1)
  )

  (idle
    (?MODE
      (=OTHER
        (= (A 1))
      )
      (default
        (= (B 1))
      )
    )
    (?FLAG
      (=0
        (= (C 1))
      )
      (_
        (= (D 1))
      )
    )
  )
)
