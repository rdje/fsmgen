(?top:standalone_dtc_explicit_system_autowire
  (?ports:public_io
    clk
    rst_n
    data_in<8
    result_data>8
  )
  (?dtc:router standalone_route_src)
)

(?dt:standalone_route_src
  (+system
    (clock clk)
    (areset rst_n)
  )

  (+size
    (data_in 8)
    (result_data 8)
  )

  (:= (result_data 8'0))

  (-capture
    (<= (result_data data_in))
  )
)
