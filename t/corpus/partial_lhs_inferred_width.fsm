(?fsm:partial_lhs_inferred_width
  (+system
    (clock clk)
    (sreset reset)
  )
  (+size
    (COND 1)
  )
  (idle
    (<COND
      (= (OUT[3:2] 2'b10))
      (= (OUT[1] 1'b1))
      (= (OUT[0] 1'b0))
      (<-= (ROD[3:2] 2'b10))
      (<-= (ROD[1] 1'b1))
      (<-= (ROD[0] 1'b0))
      (<=- (RIP[3:2] 2'b10))
      (<=- (RIP[1] 1'b1))
      (<=- (RIP[0] 1'b0))
      (<=+ (RID[3:2] 2'b10))
      (<=+ (RID[1] 1'b1))
      (<=+ (RID[0] 1'b0))
      (= (IDXOUT[4] 1'b1))
      (= (IDXOUT[0] 1'b1))
      (<-= (IDXRO[4] 1'b1))
      (<-= (IDXRO[0] 1'b1))
      (<=- (IDXRIP[4] 1'b1))
      (<=- (IDXRIP[0] 1'b1))
      (<=+ (IDXRI[4] 1'b1))
      (<=+ (IDXRI[0] 1'b1))
    )
  )
)
