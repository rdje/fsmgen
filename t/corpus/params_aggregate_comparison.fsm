(?fsm:params_aggregate_comparison
  (+constants
    (LANES (8'hA5 8'h3C))
    (LANES_COPY (8'hA5 8'h3C))
    (LANES_MASK (8'hF0 8'h0F))
    (FRAME ((mode 2'b10) (flag 1)))
    (FRAME_COPY ((mode 2'b10) (flag 1)))
    (FRAME_MASK ((mode 2'b01) (flag 0)))
  )
  (+params
    (P_EQ_LIST (== LANES LANES_COPY))
    (P_NE_LIST (!= LANES LANES_MASK))
    (P_EQ_RECORD (== FRAME FRAME_COPY))
    (P_NE_RECORD (!= FRAME FRAME_MASK))
    (P_EQ_RECORD_FALSE (== FRAME FRAME_MASK))
    (P_NE_LIST_FALSE (!= LANES LANES_COPY))
  )
  (+size
    (OUT_EQ_LIST 1)
    (OUT_NE_LIST 1)
    (OUT_EQ_RECORD 1)
    (OUT_NE_RECORD 1)
    (OUT_EQ_RECORD_FALSE 1)
    (OUT_NE_LIST_FALSE 1)
  )
  (-dt
    (= (OUT_EQ_LIST P_EQ_LIST))
    (= (OUT_NE_LIST P_NE_LIST))
    (= (OUT_EQ_RECORD P_EQ_RECORD))
    (= (OUT_NE_RECORD P_NE_RECORD))
    (= (OUT_EQ_RECORD_FALSE P_EQ_RECORD_FALSE))
    (= (OUT_NE_LIST_FALSE P_NE_LIST_FALSE))
  )
)
