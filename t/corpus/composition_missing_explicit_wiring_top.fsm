(?top:composition_missing_explicit_wiring_top
  (?ports:public_io
    clk
    rst_n
    result_data>8
  )
  (?fsmc:producer producer_src)
  (?fsmc:consumer consumer_src)
)

(?fsm:producer_src
  (+system
    (clock clk)
    (areset rst_n)
  )
  (+size
    (output_data 8)
  )
  (idle
    (output_data> <= 8'3)
  )
)

(?fsm:consumer_src
  (+system
    (clock clk)
    (areset rst_n)
  )
  (+size
    (final_data 8)
  )
  (idle
    (final_data> <= 8'5)
  )
)
