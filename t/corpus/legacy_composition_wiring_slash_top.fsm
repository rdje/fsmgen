(?top:legacy_composition_wiring_slash_top
  (?ports:public_io
    clk
    rst_n
    result_data>8
  )
  (?fsmc:producer legacy_composition_wiring_slash_producer)
  (?fsmc:consumer legacy_composition_wiring_slash_consumer)
  (?wiring:wiring
    /producer.output_data/consumer.input_data/
    /consumer.result_data/result_data/
  )
)

(?fsm:legacy_composition_wiring_slash_producer
  (+size
    (output_data 8)
  )

  (-drive_outputs
    (= (output_data> 8'hA5))
  )
)

(?fsm:legacy_composition_wiring_slash_consumer
  (+size
    (input_data 8)
    (result_data 8)
  )

  (-drive_outputs
    (= (result_data> input_data))
  )
)
