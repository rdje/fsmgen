(actor width_bindings (clock clk) (reset rst_n)
  (imports (package shared))
  (enums (mode (EIGHT 8)))
  (constants (FIXED 8))
  (params (BASE 8) (ALIAS BASE) (LANES (4 8)))
  (interface (input start) (input direct_start) (input data (width ALIAS))
    (output result (width 4)) (output direct_result (width 8))
    (output done) (output direct_done))
  (storage (var saved (width BASE)))
  (transaction worker
    (params (BASE 4) (LOCAL_ALIAS BASE))
    (ports (input payload (width LOCAL_ALIAS)) (input inherited (width ALIAS))
      (input fixed (width FIXED)) (input packaged (width shared.WIDTH))
      (output response (width BASE)))
    (update response payload) (complete done))
  (transaction direct (on direct_start)
    (params (W ALIAS) (CHAIN W) (C FIXED) (P shared.WIDTH) (E mode.EIGHT)
      (PE shared.mode.EIGHT) (LIT 8))
    (ports (input payload (width CHAIN)) (input fixed (width C))
      (input packaged (width P)) (input enumerated (width E))
      (input package_enumerated (width PE)) (input literal_param (width LIT))
      (output answer (width W)))
    (update answer payload) (complete direct_done))
  (transaction parent (on start)
    (spawn worker as first
      (bind (input payload 0) (input inherited 0) (input fixed 0)
        (input packaged 0) (output response result)))
    (await_all first) (complete done)))
