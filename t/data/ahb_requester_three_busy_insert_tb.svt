module ahb_requester_three_busy_insert_tb;
  logic clk = 0;
  logic rst_n = 0;
  logic HGRANT = 1;
  logic [31:0] HRDATA = 0;
  logic HREADY = 1;
  logic [1:0] HRESP = 0;
  logic [31:0] cmd_addr = 32'h00000100;
  logic [2:0] cmd_burst = 3'b011;
  logic [4:0] cmd_len = 4;
  logic cmd_lock = 1;
  logic [3:0] cmd_prot = 4'b1010;
  logic [2:0] cmd_size = 0;
  logic cmd_valid = 0;
  logic [31:0] cmd_wdata = 32'h11110000;
  logic [31:0] cmd_wdata_step = 1;
  logic cmd_write = 1;
  wire [31:0] HADDR;
  wire [2:0] HBURST;
  wire HBUSREQ;
  wire HLOCK;
  wire [3:0] HPROT;
  wire [2:0] HSIZE;
  wire [1:0] HTRANS;
  wire [31:0] HWDATA;
  wire HWRITE;
  wire [31:0] active_addr;
  wire [2:0] active_hburst;
  wire beat_done;
  wire [4:0] beat_index;
  wire [4:0] beats_remaining;
  wire burst_active;
  wire busy;
  wire cmd_ready;
  wire done;
  wire last_error;
  wire [31:0] last_read_data;
  wire [1:0] last_resp;
  wire last_retry;
  wire last_split;
  wire wrap_active;

  amba_requester_busy_insert_three dut (.*);
  always #5 clk = ~clk;

  integer cycles;
  integer transfer_count;
  integer beat_count;
  integer busy_count;
  integer qualified_busy_count;
  integer stall_mode;
  integer stall_clocks;
  logic stall_injected;
  logic previous_beat_done;
  logic [1:0] previous_htrans;
  logic [31:0] busy_addr;
  logic busy_write;
  logic [2:0] busy_size;
  logic [2:0] busy_burst;
  logic [3:0] busy_prot;
  logic [31:0] busy_wdata;
  logic [4:0] busy_index;
  logic [4:0] busy_remaining;

  task automatic check_transfer;
    begin
      if (!HBUSREQ)
        $fatal(1, "non-IDLE transfer did not hold HBUSREQ");
      case (transfer_count)
        0: begin
          if (HTRANS !== 2'b10 || beat_index !== 0 || beats_remaining !== 4)
            $fatal(1, "first presentation was not NONSEQ index=0 remaining=4");
        end
        1: begin
          if (HTRANS !== 2'b11 || beat_index !== 1 || beats_remaining !== 3)
            $fatal(1, "second presentation HTRANS=%b index=%0d remaining=%0d", HTRANS, beat_index, beats_remaining);
        end
        2: begin
          if (HTRANS !== 2'b01 || beat_index !== 2 || beats_remaining !== 2)
            $fatal(1, "third presentation was not held BUSY before index=2");
          busy_count = busy_count + 1;
          busy_addr = HADDR;
          busy_write = HWRITE;
          busy_size = HSIZE;
          busy_burst = HBURST;
          busy_prot = HPROT;
          busy_wdata = HWDATA;
          busy_index = beat_index;
          busy_remaining = beats_remaining;
        end
        3: begin
          if (HTRANS !== 2'b11)
            $fatal(1, "BUSY was not followed by resumed SEQ");
          if (HADDR !== busy_addr || HWRITE !== busy_write ||
              HSIZE !== busy_size || HBURST !== busy_burst ||
              HPROT !== busy_prot || HWDATA !== busy_wdata)
            $fatal(1, "BUSY did not hold the pending SEQ address/control/data");
          if (beat_index !== busy_index || beats_remaining !== busy_remaining)
            $fatal(1, "BUSY advanced beat counters before resumed SEQ");
          if (dut.ahb_busy_remaining_q !== 0)
            $fatal(1, "resumed SEQ retained BUSY count=%0d", dut.ahb_busy_remaining_q);
        end
        4: begin
          if (HTRANS !== 2'b11 || beat_index !== 3 || beats_remaining !== 1)
            $fatal(1, "final presentation was not SEQ index=3 remaining=1");
        end
        default: $fatal(1, "unexpected extra non-IDLE transfer presentation");
      endcase
      transfer_count = transfer_count + 1;
    end
  endtask

  initial begin
    stall_mode = 0;
    void'($value$plusargs("STALL_MODE=%d", stall_mode));
    stall_injected = 0;
    forever begin
      @(negedge clk);
      if (rst_n && !stall_injected && stall_mode != 0 && HTRANS === 2'b01) begin
        stall_injected = 1;
        case (stall_mode)
          1: HREADY = 0;
          2: HGRANT = 0;
          default: $fatal(1, "unsupported STALL_MODE=%0d", stall_mode);
        endcase
        repeat (32) @(negedge clk);
        HREADY = 1;
        HGRANT = 1;
      end
    end
  end

  initial begin
    transfer_count = 0;
    beat_count = 0;
    busy_count = 0;
    qualified_busy_count = 0;
    stall_clocks = 0;
    previous_beat_done = 0;
    previous_htrans = 0;

    repeat (3) @(negedge clk);
    rst_n = 1;
    @(negedge clk);
    cmd_valid = 1;
    @(negedge clk);
    cmd_valid = 0;

    cycles = 0;
    while (!done && cycles < 500) begin
      @(posedge clk);
      if (HTRANS != 2'b00 && (previous_htrans == 2'b00 || HTRANS != previous_htrans))
        check_transfer();
      if (HTRANS == 2'b01) begin
        if (HGRANT && HREADY) begin
          case (qualified_busy_count)
            0: if (dut.ahb_busy_remaining_q !== 3)
                 $fatal(1, "first qualified BUSY saw remaining=%0d expected=3", dut.ahb_busy_remaining_q);
            1: if (dut.ahb_busy_remaining_q !== 2)
                 $fatal(1, "second qualified BUSY saw remaining=%0d expected=2", dut.ahb_busy_remaining_q);
            2: if (dut.ahb_busy_remaining_q !== 1)
                 $fatal(1, "third qualified BUSY saw remaining=%0d expected=1", dut.ahb_busy_remaining_q);
            default: $fatal(1, "unexpected extra qualified BUSY event");
          endcase
          qualified_busy_count = qualified_busy_count + 1;
        end else begin
          if (dut.ahb_busy_remaining_q !== 3)
            $fatal(1, "stalled BUSY changed remaining=%0d expected=3", dut.ahb_busy_remaining_q);
          stall_clocks = stall_clocks + 1;
        end
        if (beat_done)
          $fatal(1, "BUSY presentation completed a data beat");
        if (busy_count != 0) begin
          if (HADDR !== busy_addr || HWRITE !== busy_write ||
              HSIZE !== busy_size || HBURST !== busy_burst ||
              HPROT !== busy_prot || HWDATA !== busy_wdata)
            $fatal(1, "BUSY episode changed pending address/control/data");
          if (beat_index !== busy_index || beats_remaining !== busy_remaining)
            $fatal(1, "BUSY episode changed pending beat counters");
        end
      end
      if (beat_done && !previous_beat_done) begin
        if (beat_index !== beat_count[4:0])
          $fatal(1, "accepted beat index=%0d expected=%0d", beat_index, beat_count);
        beat_count = beat_count + 1;
      end
      previous_beat_done = beat_done;
      previous_htrans = HTRANS;
      cycles = cycles + 1;
    end

    if (!done)
      $fatal(1, "exact-three BUSY-insertion request did not complete");
    if (transfer_count != 5 || beat_count != 4 || busy_count != 1 || qualified_busy_count != 3)
      $fatal(1, "counts transfers=%0d beats=%0d busy=%0d qualified_busy=%0d", transfer_count, beat_count, busy_count, qualified_busy_count);
    if ((stall_mode == 0 && (stall_injected || stall_clocks != 0)) ||
        (stall_mode != 0 && (!stall_injected || stall_clocks != 32)))
      $fatal(1, "stall mode=%0d injected=%0d clocks=%0d", stall_mode, stall_injected, stall_clocks);
    if (beats_remaining != 0)
      $fatal(1, "completion left burst remaining=%0d", beats_remaining);
    if (dut.ahb_busy_remaining_q !== 0)
      $fatal(1, "completion left BUSY remaining=%0d", dut.ahb_busy_remaining_q);
    $display("PASS transfers=%0d beats=%0d busy=%0d qualified_busy=%0d stall_mode=%0d stall_clocks=%0d busy_remaining=%0d", transfer_count, beat_count, busy_count, qualified_busy_count, stall_mode, stall_clocks, dut.ahb_busy_remaining_q);
    $finish;
  end
endmodule
