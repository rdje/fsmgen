(actor unary_reduction_runtime
  (clock clk)
  (reset (rst_n sync active_low))
  (interface
    (input valid)
    (input data (width 8))
    (input other (width 8))
    (input scalar)
    (input intermediate_xor_data_other_1)
    (output out_xor)
    (output out_and)
    (output out_or)
    (output out_odd)
    (output out_scalar_xor)
    (output out_scalar_and)
    (output out_scalar_or)
    (output out_bit)
    (output out_slice)
    (output out_nested (width 4))
    (output out_binary_xor (width 8))
    (output out_binary_and (width 8))
    (output out_binary_or (width 8))
    (output out_unrolled)
    (output out_label))
  (rule binary_xor valid (out_binary_xor (^ data other)))
  (rule xor_rule valid (out_xor (^ data)))
  (rule and_rule valid (out_and (& data)))
  (rule or_rule valid (out_or (| data)))
  (rule odd_rule valid (out_odd (! (^ data))))
  (rule scalar_xor valid (out_scalar_xor (^ scalar)))
  (rule scalar_and valid (out_scalar_and (& scalar)))
  (rule scalar_or valid (out_scalar_or (| scalar)))
  (rule bit_rule valid (out_bit (& data[3])))
  (rule slice_rule valid (out_slice (^ data[7:4])))
  (rule nested_rule valid
    (out_nested (concat (! (^ data)) (^ data[3:0]) (& scalar) (| data[0]))))
  (rule binary_and valid (out_binary_and (& data other)))
  (rule binary_or valid (out_binary_or (| data other)))
  (rule unrolled valid
    (out_unrolled (^ (^ (^ (^ (^ (^ (^ data[0] data[1]) data[2]) data[3]) data[4]) data[5]) data[6]) data[7])))
  (rule label_rule valid (out_label intermediate_xor_data_other_1)))
