(actor constant_false_guards (clock clk) (reset (rst_n async active_low))
 (interface (input data (width 8)) (input allow)
  (output disabled (width 8) (reset 0)) (output enabled (width 8) (reset 0))
  (output symbolic (width 8) (reset 0)) (output captured (width 8) (reset 0))
  (output observed (width 8) (reset 0)))
 (transaction main (when 0 (sample data as captured)) (set observed 9))
 (rule never (when 0) (set disabled 5))
 (rule always (when 1) (set enabled 6))
 (rule requested (when allow) (set symbolic 7)))
