(actor generated_width_ir (clock clk) (reset rst_n)
  (params (W 8) (ACTOR_ALIAS W) (OTHER 8))
  (constants (FIXED 8)) (types (type word_t (bits 8)))
  (interface (input start) (input data (width W)) (input pin (width W))
    (input unused (width W)) (input saved (width W))
    (output result (width 4)) (output result6 (width 6))
    (output inherited (width W)) (output from_storage (width W)) (output done))
  (storage (var stored (width ACTOR_ALIAS) (reset 3))
    (var unused_storage (width OTHER)))
  (transaction worker (params (W 4) (ALIAS W) (OTHER 4))
    (ports (input payload (width ACTOR_ALIAS)) (input data (width W))
      (input unused_formal (width ALIAS)) (input saved (width OTHER))
      (input fixed (width FIXED)) (input typed (type word_t))
      (input literal (width 8)) (output response (width ALIAS))
      (output inherited (width ACTOR_ALIAS)) (output from_storage (width ACTOR_ALIAS)))
    (update response data) (update inherited (^ pin payload))
    (update from_storage stored) (complete done))
  (transaction sibling (params (W 6) (ALIAS W))
    (ports (input data (width ALIAS)) (output response (width W)))
    (update response data) (complete done))
  (transaction parent (on start)
    (spawn worker as first (bind (input payload data) (input data 0)
      (input unused_formal 0) (input saved 0) (input fixed 0)
      (input typed 0) (input literal 0) (output response result)
      (output inherited inherited) (output from_storage from_storage)))
    (await_all first)
    (spawn sibling as second (bind (input data 0) (output response result6)))
    (await_all second) (complete done)))
