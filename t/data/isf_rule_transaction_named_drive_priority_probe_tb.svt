module named_drive_priority_probe_tb;
  logic clk = 0;
  logic reset = 1;
  logic start = 0;
  logic override_req = 0;
  logic done;
  logic out;
  logic side;

  named_drive_priority_probe dut (
    .clk(clk),
    .reset(reset),
    .start(start),
    .override_req(override_req),
    .done(done),
    .out(out),
    .side(side)
  );

  always #5 clk = ~clk;

  initial begin
    repeat (2) @(negedge clk);
    reset = 0;
    start = 1;
    @(negedge clk);
    start = 0;
    override_req = 1;
    @(posedge clk);
    #1;
    if (out !== 1'b1)
      $fatal(1, "higher-priority rule did not win named-drive overlap");
    if (side !== 1'b1)
      $fatal(1, "non-conflicting named-drive output was suppressed");
    $display("PASS named-drive rule priority out=%0d side=%0d", out, side);
    $finish;
  end

  initial begin
    #200;
    $fatal(1, "named-drive priority probe timed out");
  end
endmodule
