(actor packed_input_runtime
 (clock clk) (reset (rst_n async active_low))
 (types (type frame (record (tag (bits 2))
  (payload (record (data (signed (four_state (bits 5))))
   (flags (list (two_state bit) (two_state (bits 2)))))))))
 (interface
  (input start) (input packet (type frame))
  (output phase (width 2) (reset 0))
  (output live (width 5) (reset 0))
  (output captured (width 5) (reset 0))
  (output stored (width 5) (reset 0))
  (output copied_tag (width 2) (reset 0))
  (output flag (reset 0)) (output piece (width 2) (reset 0))
  (output negative (reset 0)) (output done (reset 0))
  (output reset_seen (width 5) (reset 0)))
 (storage (var held (type frame) (reset 149)))
 (transaction main
  (on start (sample packet.payload.data as accepted))
  (set reset_seen held.payload.data)
  (set phase 1) (wait 3)
  (set held packet) (set phase 2) (wait 3)
  (set live packet.payload.data)
  (set captured accepted)
  (set stored held.payload.data)
  (set copied_tag held.tag)
  (set flag packet.payload.flags[0])
  (set piece packet.payload.flags[1])
  (set negative (< packet.payload.data 0))
  (complete done)))
