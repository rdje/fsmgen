module ahb_interconnect_output_arbitration_two_window_tb;
  logic clk = 0;
  logic rst_n = 0;
  logic [31:0] HADDR = 0;
  logic [2:0] HBURST = 0;
  logic HBUSREQ = 1;
  logic HLOCK = 0;
  logic [3:0] HPROT = 0;
  logic [31:0] HRDATA_CONTROL = 0;
  logic [31:0] HRDATA_STATUS = 0;
  logic HREADYOUT_CONTROL = 1;
  logic HREADYOUT_STATUS = 1;
  logic HRESP_CONTROL = 0;
  logic HRESP_STATUS = 0;
  logic [2:0] HSIZE = 2;
  logic [1:0] HTRANS = 0;
  logic [31:0] HWDATA = 0;
  logic HWRITE = 0;
  wire [31:0] HADDR_CONTROL;
  wire [31:0] HADDR_STATUS;
  wire HGRANT;
  wire [31:0] HRDATA;
  wire HREADY;
  wire [1:0] HRESP;
  wire HSEL_CONTROL;
  wire HSEL_STATUS;

  ahb_interconnect dut (
    .clk(clk),
    .rst_n(rst_n),
    .HADDR(HADDR),
    .HBURST(HBURST),
    .HBUSREQ(HBUSREQ),
    .HLOCK(HLOCK),
    .HPROT(HPROT),
    .HRDATA_CONTROL(HRDATA_CONTROL),
    .HRDATA_STATUS(HRDATA_STATUS),
    .HREADYOUT_CONTROL(HREADYOUT_CONTROL),
    .HREADYOUT_STATUS(HREADYOUT_STATUS),
    .HRESP_CONTROL(HRESP_CONTROL),
    .HRESP_STATUS(HRESP_STATUS),
    .HSIZE(HSIZE),
    .HTRANS(HTRANS),
    .HWDATA(HWDATA),
    .HWRITE(HWRITE),
    .HADDR_CONTROL(HADDR_CONTROL),
    .HADDR_STATUS(HADDR_STATUS),
    .HGRANT(HGRANT),
    .HRDATA(HRDATA),
    .HREADY(HREADY),
    .HRESP(HRESP),
    .HSEL_CONTROL(HSEL_CONTROL),
    .HSEL_STATUS(HSEL_STATUS)
  );

  always #5 clk = ~clk;

  task automatic expect_global(
    input logic expected_ready,
    input logic [1:0] expected_resp,
    input logic [31:0] expected_data
  );
    begin
      #1;
      if (HGRANT !== 1'b1 || HREADY !== expected_ready ||
          HRESP !== expected_resp || HRDATA !== expected_data)
        $fatal(1, "global grant=%b ready=%b resp=%b data=%h expected=1/%b/%b/%h",
               HGRANT, HREADY, HRESP, HRDATA,
               expected_ready, expected_resp, expected_data);
    end
  endtask

  task automatic expect_decode(
    input logic expected_status_select,
    input logic [31:0] expected_status_address,
    input logic expected_control_select,
    input logic [31:0] expected_control_address
  );
    begin
      #1;
      if (HSEL_STATUS !== expected_status_select ||
          HADDR_STATUS !== expected_status_address ||
          HSEL_CONTROL !== expected_control_select ||
          HADDR_CONTROL !== expected_control_address)
        $fatal(1, "decode status=%b/%h control=%b/%h expected=%b/%h %b/%h",
               HSEL_STATUS, HADDR_STATUS, HSEL_CONTROL, HADDR_CONTROL,
               expected_status_select, expected_status_address,
               expected_control_select, expected_control_address);
    end
  endtask

  initial begin
    repeat (3) @(negedge clk);
    rst_n = 1;

    @(negedge clk);
    expect_decode(0, 0, 0, 0);
    expect_global(1, 2'b00, 0);

    // Status address zero captures owner zero and can hold a wait response.
    HADDR = 0;
    HTRANS = 2'b10;
    HREADYOUT_STATUS = 0;
    HRDATA_STATUS = 32'h11112222;
    expect_decode(1, 0, 0, 0);
    expect_global(1, 2'b00, 0);
    @(posedge clk);
    #1;
    if (dut.ahb_data_owner_0_q !== 1'b1 || dut.ahb_data_owner_1_q !== 1'b0)
      $fatal(1, "status address zero did not capture only owner zero");
    expect_global(0, 2'b00, 32'h11112222);

    @(negedge clk);
    HTRANS = 2'b00;
    expect_decode(0, 0, 0, 0);
    expect_global(0, 2'b00, 32'h11112222);
    HREADYOUT_STATUS = 1;
    HRDATA_STATUS = 32'h33334444;
    expect_global(1, 2'b00, 32'h33334444);
    @(posedge clk);
    #1;
    if (dut.ahb_data_owner_0_q !== 1'b0 || dut.ahb_data_owner_1_q !== 1'b0)
      $fatal(1, "status success did not clear owner zero");
    expect_global(1, 2'b00, 0);

    // Nonzero status local address remains a direct zero-base translation.
    @(negedge clk);
    HADDR = 2;
    HTRANS = 2'b10;
    HREADYOUT_STATUS = 0;
    HRDATA_STATUS = 32'h55556666;
    expect_decode(1, 2, 0, 0);
    @(posedge clk);
    #1;
    if (dut.ahb_data_owner_0_q !== 1'b1 || dut.ahb_data_owner_1_q !== 1'b0)
      $fatal(1, "status address two did not capture only owner zero");

    // Complete status while accepting control; owner replacement is cross-window.
    @(negedge clk);
    HADDR = 7;
    HTRANS = 2'b10;
    HREADYOUT_STATUS = 1;
    HRDATA_STATUS = 32'h77778888;
    HREADYOUT_CONTROL = 0;
    HRDATA_CONTROL = 32'h9999aaaa;
    expect_decode(0, 0, 1, 3);
    expect_global(1, 2'b00, 32'h77778888);
    @(posedge clk);
    #1;
    if (dut.ahb_data_owner_0_q !== 1'b0 || dut.ahb_data_owner_1_q !== 1'b1)
      $fatal(1, "same-edge status-to-control replacement did not select only owner one");
    expect_global(0, 2'b00, 32'h9999aaaa);

    @(negedge clk);
    HTRANS = 2'b00;
    expect_decode(0, 0, 0, 0);
    expect_global(0, 2'b00, 32'h9999aaaa);
    HREADYOUT_CONTROL = 1;
    HRESP_CONTROL = 1;
    HRDATA_CONTROL = 32'hdeadbeef;
    expect_global(1, 2'b01, 32'hdeadbeef);
    @(posedge clk);
    #1;
    if (dut.ahb_data_owner_0_q !== 1'b0 || dut.ahb_data_owner_1_q !== 1'b0)
      $fatal(1, "control ERROR did not clear owner one");
    HRESP_CONTROL = 0;
    expect_global(1, 2'b00, 0);

    // Address eight is outside both windows and completes a two-cycle ERROR.
    @(negedge clk);
    HADDR = 8;
    HTRANS = 2'b10;
    expect_decode(0, 0, 0, 0);
    expect_global(0, 2'b01, 0);
    @(posedge clk);
    #1;
    expect_decode(0, 0, 0, 0);
    expect_global(1, 2'b01, 0);
    @(negedge clk);
    HTRANS = 2'b00;
    expect_global(1, 2'b01, 0);
    @(posedge clk);
    #1;
    expect_decode(0, 0, 0, 0);
    expect_global(1, 2'b00, 0);

    $display("PASS two-window status control local wait success error replacement unmapped");
    $finish;
  end
endmodule
