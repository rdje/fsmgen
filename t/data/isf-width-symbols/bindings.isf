(actor width_symbols (clock clk) (reset rst_n)
  (imports (package shared))
  (types (type FIXED (bits 4)) (type isf_width_capture_2 (bits 8)) (type isf_width_static_3 (bits 8)))
  (enums (isf_width_capture_3 (ONE 1)) (mode (EIGHT 8) (FOUR 4)))
  (constants (isf_width_static_1 8) (FIXED 8) (SHADOW 8))
  (params (shared 4) (mode 4) (isf_width_static_2 4) (BASE 8) (ACTOR_ALIAS BASE) (C FIXED) (P shared.WIDTH)
    (E mode.EIGHT) (PE shared.mode.EIGHT)
    (LANES (BASE FIXED shared.WIDTH mode.EIGHT (8 BASE))))
  (interface (input start) (input direct_start)
    (output result (width 4)) (output direct_result (width 8))
    (output done) (output direct_done))
  (transaction worker
    (params (shared 4) (mode 4) (isf_width_static_2 4) (isf_width_capture_4 4) (BASE 4) (LOCAL_ALIAS BASE) (A ACTOR_ALIAS) (C FIXED)
      (P shared.WIDTH) (E mode.EIGHT) (PE shared.mode.EIGHT)
      (SHADOW 4) (SHADOW_ALIAS SHADOW)
      (LANES (BASE ACTOR_ALIAS FIXED shared.WIDTH mode.EIGHT (8 SHADOW))))
    (ports (input ISF_WIDTH_CAPTURE_1) (input fixed (width FIXED)) (input data (width LOCAL_ALIAS)) (output response (width BASE)))
    (update response data) (complete done))
  (transaction direct (on direct_start)
    (params (W ACTOR_ALIAS) (LOCAL_ALIAS W))
    (ports (input payload (width LOCAL_ALIAS)) (output answer (width W)))
    (update answer payload) (complete direct_done))
  (transaction parent (on start)
    (spawn worker as first (bind (input ISF_WIDTH_CAPTURE_1 0) (input fixed 0) (input data 0) (output response result)))
    (await_all first) (complete done)))
