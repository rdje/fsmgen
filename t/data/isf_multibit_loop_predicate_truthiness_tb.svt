module isf_multibit_loop_predicate_truthiness_tb;
  logic clk = 0;
  logic rst_n = 0;
  logic start = 0;
  logic [2:0] seed = 0;
  wire done;

  isf_multibit_loop_predicate_truthiness dut (.*);
  always #5 clk = ~clk;

  task automatic run_seed(input logic [2:0] value);
    integer cycles;
    begin
      @(negedge clk);
      seed = value;
      start = 1;
      @(negedge clk);
      start = 0;
      cycles = 0;
      while (!done && cycles < 200) begin
        @(posedge clk);
        cycles = cycles + 1;
      end
      if (!done)
        $fatal(1, "seed %0d did not complete", value);
      if (dut.while_count_q != 0)
        $fatal(1, "seed %0d while count=%0d expected=0", value, dut.while_count_q);
      if (dut.until_count_q == 0)
        $fatal(1, "seed %0d until condition did not become nonzero", value);
      if (dut.until_pass_q != (value == 0 ? 2 : 1))
        $fatal(1, "seed %0d until passes=%0d", value, dut.until_pass_q);
      @(posedge clk);
    end
  endtask

  initial begin
    repeat (3) @(negedge clk);
    rst_n = 1;
    for (integer value = 0; value < 8; value = value + 1)
      run_seed(value[2:0]);
    $display("PASS seeds=8");
    $finish;
  end
endmodule
