module ahb_pipelined_active_transfer_audit_tb;
  logic clk = 0;
  logic rst_n = 0;
  logic [31:0] HADDR = 0;
  logic [2:0] HBURST = 3'b011;
  wire HREADY;
  logic HSEL = 0;
  logic [2:0] HSIZE = 0;
  logic [1:0] HTRANS = 2'b00;
  logic [31:0] HWDATA = 0;
  logic HWRITE = 1;
  logic [3:0] wait_cycles = 0;
  wire [31:0] HRDATA;
  wire HREADYOUT;
  wire HRESP;

  assign HREADY = HREADYOUT;

  ahb_lite_subordinate_byte_lane_hburst_seq_busy_park dut (.*);
  always #5 clk = ~clk;

  integer cycles;
  integer bus_accept_count;
  integer internal_admit_count;
  integer internal_completion_count;
  integer ready_low_cycles;
  integer response_error_cycles;
  integer first_accept_cycle;
  integer second_accept_cycle;
  integer first_completion_cycle;
  logic release_observed;
  logic previous_done;

  initial begin
    cycles = 0;
    bus_accept_count = 0;
    internal_admit_count = 0;
    internal_completion_count = 0;
    ready_low_cycles = 0;
    response_error_cycles = 0;
    first_accept_cycle = -1;
    second_accept_cycle = -1;
    first_completion_cycle = -1;
    release_observed = 0;
    previous_done = 0;

    repeat (3) @(negedge clk);
    rst_n = 1;

    // First address phase: selected INCR4 NONSEQ byte write to lane zero.
    @(negedge clk);
    HSEL = 1;
    HADDR = 32'h00000000;
    HTRANS = 2'b10;
    HWDATA = 32'h00000011;

    while (bus_accept_count < 2 && cycles < 1000) begin
      @(posedge clk);

      // AHB accepts the currently presented address phase when HREADY is high.
      if (HSEL && HREADY && HTRANS[1]) begin
        bus_accept_count = bus_accept_count + 1;
        case (bus_accept_count)
          1: begin
            first_accept_cycle = cycles;
            if (HADDR !== 32'h00000000 || HTRANS !== 2'b10)
              $fatal(1, "first accepted phase addr=%h trans=%b", HADDR, HTRANS);
          end
          2: begin
            second_accept_cycle = cycles;
            if (HADDR !== 32'h00000001 || HTRANS !== 2'b11)
              $fatal(1, "second accepted phase addr=%h trans=%b", HADDR, HTRANS);
            if (!dut.ahb_access_active_q)
              $fatal(1, "ownership cleared before the boundary-free SEQ phase");
            if (dut.addr_q !== 32'h00000000 || dut.trans_q !== 2'b10)
              $fatal(1, "captured phase changed before second acceptance addr=%h trans=%b", dut.addr_q, dut.trans_q);
          end
          default: $fatal(1, "unexpected extra accepted active phase");
        endcase
      end

      if (dut.ahb_access_admit_en)
        internal_admit_count = internal_admit_count + 1;
      if (dut.ahb_access_done_q && !previous_done) begin
        internal_completion_count = internal_completion_count + 1;
        first_completion_cycle = cycles;
      end
      if (!HREADYOUT)
        ready_low_cycles = ready_low_cycles + 1;
      if (HRESP)
        response_error_cycles = response_error_cycles + 1;
      previous_done = dut.ahb_access_done_q;

      @(negedge clk);
      if (bus_accept_count == 1 && HADDR == 32'h00000000) begin
        // The first data phase now stalls HREADY. Present and hold the next
        // distinct active address phase until the subordinate raises ready.
        HADDR = 32'h00000001;
        HTRANS = 2'b11;
      end
      if (bus_accept_count == 2) begin
        // The next cycle is the second transfer's data phase. End the address
        // stream with IDLE, while presenting its distinct byte-lane write data.
        HTRANS = 2'b00;
        HWDATA = 32'h00002200;
      end
      cycles = cycles + 1;
    end

    if (bus_accept_count != 2)
      $fatal(1, "active phase stream timed out with bus_accepts=%0d", bus_accept_count);

    repeat (40) begin
      @(posedge clk);
      if (dut.ahb_access_admit_en)
        internal_admit_count = internal_admit_count + 1;
      if (dut.ahb_access_done_q && !previous_done) begin
        internal_completion_count = internal_completion_count + 1;
        first_completion_cycle = cycles;
      end
      if (!HREADYOUT)
        ready_low_cycles = ready_low_cycles + 1;
      if (HRESP)
        response_error_cycles = response_error_cycles + 1;
      if (!dut.ahb_access_active_q)
        release_observed = 1;
      previous_done = dut.ahb_access_done_q;
      cycles = cycles + 1;
    end

    if (internal_admit_count != 1 || internal_completion_count != 1)
      $fatal(1, "internal counts admits=%0d completions=%0d", internal_admit_count, internal_completion_count);
    if (first_accept_cycle < 0 || second_accept_cycle <= first_accept_cycle || ready_low_cycles == 0)
      $fatal(1, "phase timing first=%0d second=%0d ready_low=%0d", first_accept_cycle, second_accept_cycle, ready_low_cycles);
    if (first_completion_cycle < first_accept_cycle)
      $fatal(1, "completion cycle=%0d precedes first acceptance=%0d", first_completion_cycle, first_accept_cycle);
    if (response_error_cycles != 0)
      $fatal(1, "HRESP asserted for %0d cycles", response_error_cycles);
    if (dut.addr_q !== 32'h00000000 || dut.trans_q !== 2'b10)
      $fatal(1, "captured phase addr=%h trans=%b expected first NONSEQ", dut.addr_q, dut.trans_q);
    if (dut.reg_data_q !== 32'h00000011)
      $fatal(1, "storage=%h expected only first byte write", dut.reg_data_q);
    if (dut.ahb_access_active_q || !release_observed)
      $fatal(1, "IDLE boundary did not release phase ownership");
    if (HRESP !== 1'b0 || HREADYOUT !== 1'b1)
      $fatal(1, "terminal response ready=%b resp=%b", HREADYOUT, HRESP);

    $display(
      "OBSERVED_ACTIVE_PIPE bus_accepts=%0d internal_admits=%0d internal_completions=%0d first_accept=%0d second_accept=%0d completion=%0d ready_low_cycles=%0d response_errors=%0d captured_addr=%08x captured_trans=%b storage=%08x",
      bus_accept_count,
      internal_admit_count,
      internal_completion_count,
      first_accept_cycle,
      second_accept_cycle,
      first_completion_cycle,
      ready_low_cycles,
      response_error_cycles,
      dut.addr_q,
      dut.trans_q,
      dut.reg_data_q
    );
    $finish;
  end
endmodule
