module ahb_pipelined_active_transfer_audit_tb;
  logic clk = 0;
  logic rst_n = 0;
  logic [31:0] HADDR = 0;
  logic [2:0] HBURST = 3'b000;
  wire HREADY;
  logic HSEL = 0;
  logic [2:0] HSIZE = 0;
  logic [1:0] HTRANS = 2'b00;
  logic [31:0] HWDATA = 0;
  logic HWRITE = 1;
  logic [3:0] wait_cycles = 0;
  wire [31:0] HRDATA;
  wire HREADYOUT;
  wire HRESP;

  assign HREADY = HREADYOUT;

  ahb_lite_subordinate_byte_lane_hburst_seq_busy_park dut (.*);
  always #5 clk = ~clk;

  task automatic reset_dut;
    begin
      rst_n = 0;
      HSEL = 0;
      HADDR = 0;
      HTRANS = 2'b00;
      HBURST = 3'b000;
      HWRITE = 1;
      HSIZE = 0;
      HWDATA = 0;
      wait_cycles = 0;
      repeat (3) @(negedge clk);
      rst_n = 1;
      @(negedge clk);
    end
  endtask

  task automatic run_successful_active_pipeline;
    integer cycles;
    integer bus_accept_count;
    integer internal_capture_count;
    integer internal_completion_count;
    integer ready_low_cycles;
    integer response_error_cycles;
    integer first_accept_cycle;
    integer second_accept_cycle;
    integer first_completion_cycle;
    integer second_completion_cycle;
    logic previous_done;
    begin
      reset_dut();
      cycles = 0;
      bus_accept_count = 0;
      internal_capture_count = 0;
      internal_completion_count = 0;
      ready_low_cycles = 0;
      response_error_cycles = 0;
      first_accept_cycle = -1;
      second_accept_cycle = -1;
      first_completion_cycle = -1;
      second_completion_cycle = -1;
      previous_done = 0;

      // Selected INCR4 NONSEQ byte write to lane zero.
      HSEL = 1;
      HADDR = 32'h00000000;
      HTRANS = 2'b10;
      HBURST = 3'b011;
      HSIZE = 3'b000;
      HWDATA = 32'h00000011;

      while ((internal_completion_count < 2 || !HREADYOUT || dut.ahb_phase_pending_q) && cycles < 1500) begin
        @(posedge clk);

        if (HSEL && HREADY && HTRANS[1]) begin
          bus_accept_count = bus_accept_count + 1;
          case (bus_accept_count)
            1: begin
              first_accept_cycle = cycles;
              if (HADDR !== 32'h00000000 || HTRANS !== 2'b10)
                $fatal(1, "first accepted phase addr=%h trans=%b", HADDR, HTRANS);
            end
            2: begin
              second_accept_cycle = cycles;
              if (HADDR !== 32'h00000001 || HTRANS !== 2'b11)
                $fatal(1, "second accepted phase addr=%h trans=%b", HADDR, HTRANS);
              if (!dut.ahb_phase_capture_en)
                $fatal(1, "second accepted phase did not enable phase capture");
              if (dut.addr_q !== 32'h00000000 || dut.trans_q !== 2'b10)
                $fatal(1, "current bank changed before second acceptance addr=%h trans=%b", dut.addr_q, dut.trans_q);
            end
            default: $fatal(1, "unexpected extra accepted active phase");
          endcase
        end

        if (dut.ahb_phase_capture_en)
          internal_capture_count = internal_capture_count + 1;
        if (dut.ahb_access_done_q && !previous_done) begin
          internal_completion_count = internal_completion_count + 1;
          if (internal_completion_count == 1)
            first_completion_cycle = cycles;
          else if (internal_completion_count == 2)
            second_completion_cycle = cycles;
        end
        if (!HREADYOUT)
          ready_low_cycles = ready_low_cycles + 1;
        if (HRESP)
          response_error_cycles = response_error_cycles + 1;
        previous_done = dut.ahb_access_done_q;

        @(negedge clk);
        if (bus_accept_count == 1 && HADDR == 32'h00000000) begin
          // Present and hold the next address phase while the first data phase
          // is stalled. HWDATA still belongs to the first write.
          HADDR = 32'h00000001;
          HTRANS = 2'b11;
        end
        if (bus_accept_count == 2 && HTRANS == 2'b11) begin
          if (HREADYOUT !== 1'b0 || HRESP !== 1'b0)
            $fatal(1, "captured SEQ data phase not stalled ready=%b resp=%b", HREADYOUT, HRESP);
          // The next cycle is the captured transfer's data phase. End the
          // address stream and present its distinct lane-one write data.
          HTRANS = 2'b00;
          HWDATA = 32'h00002200;
        end
        cycles = cycles + 1;
      end

      if (cycles >= 1500)
        $fatal(1, "successful pipeline timed out");
      if (bus_accept_count != 2 || internal_capture_count != 2 || internal_completion_count != 2)
        $fatal(1, "successful counts bus=%0d captures=%0d completions=%0d", bus_accept_count, internal_capture_count, internal_completion_count);
      if (first_accept_cycle < 0 || second_accept_cycle <= first_accept_cycle || ready_low_cycles == 0)
        $fatal(1, "successful timing first=%0d second=%0d ready_low=%0d", first_accept_cycle, second_accept_cycle, ready_low_cycles);
      if (first_completion_cycle < first_accept_cycle || second_completion_cycle <= first_completion_cycle)
        $fatal(1, "successful completion timing first=%0d second=%0d", first_completion_cycle, second_completion_cycle);
      if (response_error_cycles != 0)
        $fatal(1, "successful HRESP asserted for %0d cycles", response_error_cycles);
      if (dut.addr_q !== 32'h00000001 || dut.trans_q !== 2'b11)
        $fatal(1, "terminal current bank addr=%h trans=%b expected captured SEQ", dut.addr_q, dut.trans_q);
      if (dut.reg_data_q !== 32'h00002211)
        $fatal(1, "successful storage=%h expected both byte writes", dut.reg_data_q);
      if (dut.ahb_phase_pending_q)
        $fatal(1, "successful phase bank remains pending");
      if (HRESP !== 1'b0 || HREADYOUT !== 1'b1)
        $fatal(1, "successful terminal response ready=%b resp=%b", HREADYOUT, HRESP);

      $display(
        "REPAIRED_ACTIVE_PIPE bus_accepts=%0d internal_captures=%0d internal_completions=%0d first_accept=%0d second_accept=%0d first_completion=%0d second_completion=%0d ready_low_cycles=%0d response_errors=%0d captured_addr=%08x captured_trans=%b pending=%0d storage=%08x",
        bus_accept_count,
        internal_capture_count,
        internal_completion_count,
        first_accept_cycle,
        second_accept_cycle,
        first_completion_cycle,
        second_completion_cycle,
        ready_low_cycles,
        response_error_cycles,
        dut.addr_q,
        dut.trans_q,
        dut.ahb_phase_pending_q,
        dut.reg_data_q
      );
    end
  endtask

  task automatic run_error_active_continuation;
    integer cycles;
    integer bus_accept_count;
    integer internal_capture_count;
    integer internal_completion_count;
    integer response_error_cycles;
    logic previous_done;
    begin
      reset_dut();
      cycles = 0;
      bus_accept_count = 0;
      internal_capture_count = 0;
      internal_completion_count = 0;
      response_error_cycles = 0;
      previous_done = 0;

      // First transfer is invalid and must complete with two-cycle ERROR.
      HSEL = 1;
      HADDR = 32'h00000000;
      HTRANS = 2'b10;
      HBURST = 3'b000;
      HSIZE = 3'b111;
      HWDATA = 32'hdeadbeef;

      while ((internal_completion_count < 2 || !HREADYOUT || HRESP || dut.ahb_phase_pending_q) && cycles < 1500) begin
        @(posedge clk);

        if (HSEL && HREADY && HTRANS[1]) begin
          bus_accept_count = bus_accept_count + 1;
          if (bus_accept_count == 2) begin
            if (HRESP !== 1'b1)
              $fatal(1, "active continuation was not accepted on final ERROR");
            if (!dut.ahb_phase_capture_en)
              $fatal(1, "final-ERROR active continuation did not enable capture");
          end else if (bus_accept_count > 2) begin
            $fatal(1, "unexpected extra ERROR-continuation acceptance");
          end
        end
        if (dut.ahb_phase_capture_en)
          internal_capture_count = internal_capture_count + 1;
        if (dut.ahb_access_done_q && !previous_done)
          internal_completion_count = internal_completion_count + 1;
        if (HRESP)
          response_error_cycles = response_error_cycles + 1;
        previous_done = dut.ahb_access_done_q;

        @(negedge clk);
        if (bus_accept_count == 1 && HSIZE == 3'b111) begin
          // Hold a supported independent NONSEQ behind the failing transfer.
          HADDR = 32'h00000000;
          HTRANS = 2'b10;
          HBURST = 3'b000;
          HSIZE = 3'b000;
        end
        if (bus_accept_count == 2 && HTRANS == 2'b10) begin
          if (HREADYOUT !== 1'b0 || HRESP !== 1'b0)
            $fatal(1, "post-ERROR captured data phase not stalled ready=%b resp=%b", HREADYOUT, HRESP);
          HTRANS = 2'b00;
          HWDATA = 32'h000000aa;
        end
        cycles = cycles + 1;
      end

      if (cycles >= 1500)
        $fatal(1, "ERROR active-continuation scenario timed out");
      if (bus_accept_count != 2 || internal_capture_count != 2 || internal_completion_count != 2)
        $fatal(1, "ERROR-continuation counts bus=%0d captures=%0d completions=%0d", bus_accept_count, internal_capture_count, internal_completion_count);
      if (response_error_cycles != 2)
        $fatal(1, "ERROR-continuation HRESP cycles=%0d expected two", response_error_cycles);
      if (dut.reg_data_q !== 32'h000000aa)
        $fatal(1, "ERROR-continuation storage=%h expected captured NONSEQ write", dut.reg_data_q);
      if (dut.ahb_phase_pending_q || HRESP !== 1'b0 || HREADYOUT !== 1'b1)
        $fatal(1, "ERROR-continuation terminal pending=%b ready=%b resp=%b", dut.ahb_phase_pending_q, HREADYOUT, HRESP);

      $display(
        "REPAIRED_ERROR_CONTINUE bus_accepts=%0d internal_captures=%0d internal_completions=%0d response_error_cycles=%0d pending=%0d storage=%08x",
        bus_accept_count,
        internal_capture_count,
        internal_completion_count,
        response_error_cycles,
        dut.ahb_phase_pending_q,
        dut.reg_data_q
      );
    end
  endtask

  task automatic run_error_idle_cancellation;
    integer cycles;
    integer bus_accept_count;
    integer internal_capture_count;
    integer internal_completion_count;
    integer response_error_cycles;
    logic previous_done;
    begin
      reset_dut();
      cycles = 0;
      bus_accept_count = 0;
      internal_capture_count = 0;
      internal_completion_count = 0;
      response_error_cycles = 0;
      previous_done = 0;

      HSEL = 1;
      HADDR = 32'h00000000;
      HTRANS = 2'b10;
      HBURST = 3'b000;
      HSIZE = 3'b111;
      HWDATA = 32'hffffffff;

      while ((internal_completion_count < 1 || !HREADYOUT || HRESP || dut.ahb_phase_pending_q) && cycles < 1500) begin
        @(posedge clk);

        if (HSEL && HREADY && HTRANS[1])
          bus_accept_count = bus_accept_count + 1;
        if (dut.ahb_phase_capture_en)
          internal_capture_count = internal_capture_count + 1;
        if (dut.ahb_access_done_q && !previous_done)
          internal_completion_count = internal_completion_count + 1;
        if (HRESP)
          response_error_cycles = response_error_cycles + 1;
        previous_done = dut.ahb_access_done_q;

        @(negedge clk);
        if (bus_accept_count == 1 && HTRANS == 2'b10)
          // IDLE cancels the phase presented behind the failing transfer.
          HTRANS = 2'b00;
        cycles = cycles + 1;
      end

      if (cycles >= 1500)
        $fatal(1, "ERROR IDLE-cancellation scenario timed out");
      if (bus_accept_count != 1 || internal_capture_count != 1 || internal_completion_count != 1)
        $fatal(1, "ERROR-cancel counts bus=%0d captures=%0d completions=%0d", bus_accept_count, internal_capture_count, internal_completion_count);
      if (response_error_cycles != 2)
        $fatal(1, "ERROR-cancel HRESP cycles=%0d expected two", response_error_cycles);
      if (dut.reg_data_q !== 32'h00000000)
        $fatal(1, "ERROR-cancel storage=%h expected no write", dut.reg_data_q);
      if (dut.ahb_phase_pending_q || HRESP !== 1'b0 || HREADYOUT !== 1'b1)
        $fatal(1, "ERROR-cancel terminal pending=%b ready=%b resp=%b", dut.ahb_phase_pending_q, HREADYOUT, HRESP);

      $display(
        "REPAIRED_ERROR_CANCEL bus_accepts=%0d internal_captures=%0d internal_completions=%0d response_error_cycles=%0d pending=%0d storage=%08x",
        bus_accept_count,
        internal_capture_count,
        internal_completion_count,
        response_error_cycles,
        dut.ahb_phase_pending_q,
        dut.reg_data_q
      );
    end
  endtask

  initial begin
    run_successful_active_pipeline();
    run_error_active_continuation();
    run_error_idle_cancellation();
    $finish;
  end
endmodule
