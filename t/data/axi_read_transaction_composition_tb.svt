module axi_read_transaction_composition_tb;
  logic clk = 0; logic rst_n = 0; logic read_cmd_valid = 0;
  logic [31:0] cmd_read_addr = 0; logic [3:0] cmd_read_id = 0;
  logic arready = 0; logic rvalid = 0; logic [3:0] rid = 0;
  logic [31:0] rdata = 0; logic [1:0] rresp = 0; logic rlast = 0;
  wire arvalid; wire [31:0] araddr; wire [3:0] arid; wire [7:0] arlen;
  wire [2:0] arsize; wire [1:0] arburst; wire rready;
  wire [3:0] response_rid; wire [31:0] response_rdata;
  wire [1:0] response_rresp; wire response_rlast;
  wire read_busy, read_request_done, read_transaction_done;
  wire response_id_match, response_last_match;
  integer ar_handshakes = 0, r_handshakes = 0;
  integer request_pulses = 0, transaction_pulses = 0, cycles = 0;

  axi_read_transaction_composition dut (.*);
  always #5 clk = ~clk;
  always @(posedge clk) if (rst_n) begin
    if (arvalid && {arlen, arsize, arburst} !== {8'd0, 3'd2, 2'b01}) $fatal(1, "fixed AR metadata mismatch");
    if (rready && ar_handshakes <= r_handshakes) $fatal(1, "R armed before owned AR");
    if (arvalid && arready) begin
      case (ar_handshakes)
        0: if ({araddr,arid} !== {32'h1000,4'h1}) $fatal(1,"AR1");
        1: if ({araddr,arid} !== {32'h2000,4'h2}) $fatal(1,"AR2");
        2: if ({araddr,arid} !== {32'h3000,4'h3}) $fatal(1,"AR3");
        3: if ({araddr,arid} !== {32'h5000,4'h5}) $fatal(1,"AR5");
        4: if ({araddr,arid} !== {32'h6000,4'h6}) $fatal(1,"AR6");
        default: $fatal(1,"extra AR");
      endcase
      ar_handshakes <= ar_handshakes + 1;
    end
    if (rvalid && rready) r_handshakes <= r_handshakes + 1;
    if (read_request_done) request_pulses <= request_pulses + 1;
    if (read_transaction_done) transaction_pulses <= transaction_pulses + 1;
  end

  task automatic command(input [31:0] address, input [3:0] id);
    begin @(negedge clk); cmd_read_addr=address; cmd_read_id=id; read_cmd_valid=1;
      @(negedge clk); read_cmd_valid=0; end
  endtask
  task automatic wait_request(input integer count);
    begin cycles=0; while ((request_pulses<count || !rready) && cycles<120) begin @(negedge clk); cycles++; end
      if (request_pulses!=count || !rready || !read_busy) $fatal(1,"request wait"); end
  endtask
  task automatic response(input [3:0] id,input [31:0] data,input [1:0] code,input bit last,input integer count,input bit id_ok,input bit last_ok);
    begin @(negedge clk); rid=id; rdata=data; rresp=code; rlast=last; rvalid=1;
      @(negedge clk); rvalid=0; cycles=0;
      while (transaction_pulses<count && cycles<80) begin @(negedge clk); cycles++; end
      if (transaction_pulses!=count || r_handshakes!=count) $fatal(1,"R retirement");
      if ({response_rid,response_rdata,response_rresp,response_rlast} !== {id,data,code,last}) $fatal(1,"capture");
      if ({response_id_match,response_last_match} !== {id_ok,last_ok}) $fatal(1,"status"); end
  endtask

  initial begin
    repeat(2) @(negedge clk); rst_n=1; repeat(2) @(negedge clk);
    arready=1; command(32'h1003,4'hf); repeat(12) @(negedge clk);
    if (arvalid||rready||read_busy||ar_handshakes!=0||r_handshakes!=0) $fatal(1,"misaligned launch");

    rid=1; rdata=32'h11112222; rresp=2'b10; rlast=1; rvalid=1;
    if (rready) $fatal(1,"unarmed R"); command(32'h1000,4'h1);
    cmd_read_addr=32'hffff0000; cmd_read_id=4'he;
    cycles=0; while(r_handshakes<1&&cycles<120) begin @(negedge clk); cycles++; end
    if(r_handshakes!=1) $fatal(1,"already-high R"); rvalid=0;
    cycles=0; while(transaction_pulses<1&&cycles<80) begin @(negedge clk); cycles++; end
    if(request_pulses!=1||transaction_pulses!=1) $fatal(1,"first pulses");
    if({response_rid,response_rdata,response_rresp,response_rlast,response_id_match,response_last_match} !== {4'h1,32'h11112222,2'b10,1'b1,1'b1,1'b1}) $fatal(1,"first result");

    arready=0; command(32'h2000,4'h2); cycles=0;
    while(!arvalid&&cycles<80) begin @(negedge clk); cycles++; end
    cmd_read_addr=32'hdead0000; cmd_read_id=4'hd; read_cmd_valid=1;
    repeat(4) begin @(negedge clk); if(!arvalid||{araddr,arid,arlen,arsize,arburst}!=={32'h2000,4'h2,8'd0,3'd2,2'b01}) $fatal(1,"stalled AR"); end
    read_cmd_valid=0; arready=1; wait_request(2);
    repeat(4) begin @(negedge clk); if(!rready||!read_busy||read_transaction_done) $fatal(1,"R wait"); end
    response(4'h2,32'h33334444,2'b00,1,2,1,1);

    arready=0; command(32'h3000,4'h3); cycles=0;
    while(!arvalid&&cycles<80) begin @(negedge clk); cycles++; end
    arready=1; @(negedge clk); arready=0; wait_request(3);
    response(4'h4,32'h55556666,2'b11,0,3,0,0);

    arready=0; command(32'h4000,4'h4); cycles=0;
    while(!arvalid&&cycles<80) begin @(negedge clk); cycles++; end
    @(negedge clk); rst_n=0; #1;
    if(arvalid||rready||read_busy||read_request_done||read_transaction_done) $fatal(1,"AR reset");
    repeat(2) @(negedge clk); rst_n=1; repeat(2) @(negedge clk);

    arready=1; command(32'h5000,4'h5); wait_request(4);
    @(negedge clk); rst_n=0; #1;
    if(arvalid||rready||read_busy||read_request_done||read_transaction_done) $fatal(1,"R reset");
    repeat(2) @(negedge clk); rst_n=1; repeat(2) @(negedge clk);

    command(32'h6000,4'h6); wait_request(5); response(4'h6,32'h77778888,2'b01,1,4,1,1);
    repeat(8) @(negedge clk);
    if(ar_handshakes!=5||r_handshakes!=4||request_pulses!=5||transaction_pulses!=4) $fatal(1,"cardinality");
    if(arvalid||rready||read_busy||read_request_done||read_transaction_done) $fatal(1,"final idle");
    $display("PASS ar=5 r=4 request=5 transaction=4 mismatch_terminal=1 missing_last_terminal=1 reset_abort=2");
    $finish;
  end
  initial begin #40000; $fatal(1,"timeout"); end
endmodule
