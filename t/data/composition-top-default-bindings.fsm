(?top:top_default_bindings
  (+params
    (FORWARD ALIAS)
    (BASE 16)
    (SAME 16)
    (ALIAS BASE)
    (OTHER SAME)
    (LITERAL 16)
    (SUM (+ BASE STATIC))
    (LANES (8'hA5 8'h3C))
    (LANE LANES[1])
    (CFG ((tag 4'hA) (data LANES)))
    (TAG CFG.tag)
    (STATIC_COPY shared.FIXED)
    (MODE mode.BIG)
  )
  (+constants (STATIC 16))
  (+enums (mode (BIG 16)))
  (+import shared)
  (?rtl:child)
)
(?pkg:shared
  (+constants (FIXED 16))
)
