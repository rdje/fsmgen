(?fsm:parameter_default_sources
  (+system (clock clk))
  (+constants (W 8) (FIXED 16))
  (+enums (mode (EIGHT 8)))
  (+params
    (FORWARD W)
    (CHAIN FORWARD)
    (W 16)
    (STATIC FIXED)
    (MODE mode.EIGHT)
    (ITEMS (8'hA5 8'h3C))
    (CONFIG ((flag W) (lanes ITEMS)))
    (LEAF CONFIG.flag)
    (LANE CONFIG.lanes[1])
    (SUM (+ W 1))
    (REPEATED (+ W W))
    (COPY CONFIG))
  (+size (OUT 1))
  (idle (<= (OUT 0))))
