(library widths (exports (actor child))
  (actor child (clock clk) (params (WIDTH 8) (ALIAS WIDTH) (OTHER 8))
    (interface (input copy_start) (input data (width WIDTH))
      (output result (width ALIAS)) (output done))
    (transaction copy (on copy_start) (set result data) (complete done))))
(actor atl_widths (clock clk)
  (interface (input start) (output done))
  (imports (library widths as lib))
  (instance first of lib.child)
  (instance second of lib.child)
  (drive transfer (second.data first.result))
  (transaction run (on start)
    (trigger first.copy) (await first.done) (drive transfer)
    (trigger second.copy) (await second.done) (complete done)))
