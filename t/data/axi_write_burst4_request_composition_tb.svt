module axi_write_burst4_request_composition_tb;
  logic clk = 0;
  logic rst_n = 0;
  logic write_cmd_valid = 0;
  logic [31:0] cmd_awaddr = 0;
  logic [3:0] cmd_awid = 0;
  logic [31:0] cmd_wdata0 = 0;
  logic [31:0] cmd_wdata1 = 0;
  logic [31:0] cmd_wdata2 = 0;
  logic [31:0] cmd_wdata3 = 0;
  logic [3:0] cmd_wstrb0 = 0;
  logic [3:0] cmd_wstrb1 = 0;
  logic [3:0] cmd_wstrb2 = 0;
  logic [3:0] cmd_wstrb3 = 0;
  logic awready = 0;
  logic wready = 0;

  wire awvalid;
  wire [31:0] awaddr;
  wire [3:0] awid;
  wire [7:0] awlen;
  wire [2:0] awsize;
  wire [1:0] awburst;
  wire wvalid;
  wire [31:0] wdata;
  wire [3:0] wstrb;
  wire wlast;
  wire write_busy;
  wire write_beat_done;
  wire write_done;
  wire [1:0] write_beat_index;

  integer aw_handshakes = 0;
  integer w_handshakes = 0;
  integer beat_pulses = 0;
  integer done_pulses = 0;
  integer illegal_ignored = 0;
  integer busy_ignored = 0;
  integer reset_abort = 0;
  integer cycles = 0;

  axi_write_burst4_request_composition dut (.*);
  always #5 clk = ~clk;

  function automatic [1:0] expected_beat_index(input integer event_number);
    begin
      case (event_number)
        0, 4, 8, 12, 14: expected_beat_index = 2'd0;
        1, 5, 9, 13, 15: expected_beat_index = 2'd1;
        2, 6, 10, 16: expected_beat_index = 2'd2;
        3, 7, 11, 17: expected_beat_index = 2'd3;
        default: expected_beat_index = 2'bxx;
      endcase
    end
  endfunction

  function automatic [31:0] expected_wdata(input integer transfer_number);
    begin
      case (transfer_number)
        0: expected_wdata = 32'h00001000;
        1: expected_wdata = 32'h00001001;
        2: expected_wdata = 32'h00001002;
        3: expected_wdata = 32'h00001003;
        4: expected_wdata = 32'h00002000;
        5: expected_wdata = 32'h00002001;
        6: expected_wdata = 32'h00002002;
        7: expected_wdata = 32'h00002003;
        8: expected_wdata = 32'h00003000;
        9: expected_wdata = 32'h00003001;
        10: expected_wdata = 32'h00003002;
        11: expected_wdata = 32'h00003003;
        12: expected_wdata = 32'h00004000;
        13: expected_wdata = 32'h00004001;
        14: expected_wdata = 32'h00005000;
        15: expected_wdata = 32'h00005001;
        16: expected_wdata = 32'h00005002;
        17: expected_wdata = 32'h00005003;
        default: expected_wdata = 32'hxxxxxxxx;
      endcase
    end
  endfunction

  function automatic [3:0] expected_wstrb(input integer transfer_number);
    begin
      case (expected_beat_index(transfer_number))
        2'd0: expected_wstrb = 4'h1;
        2'd1: expected_wstrb = 4'h2;
        2'd2: expected_wstrb = 4'h4;
        2'd3: expected_wstrb = 4'h8;
      endcase
    end
  endfunction

  function automatic expected_wlast(input integer transfer_number);
    begin
      case (transfer_number)
        3, 7, 11, 17: expected_wlast = 1'b1;
        default: expected_wlast = 1'b0;
      endcase
    end
  endfunction

  always @(posedge clk) if (rst_n) begin
    if (awvalid && {awlen, awsize, awburst} !== {8'd3, 3'd2, 2'b01})
      $fatal(1, "fixed AW metadata mismatch");
    if (awvalid && awready) begin
      case (aw_handshakes)
        0: if ({awaddr, awid} !== {32'h00000004, 4'h1}) $fatal(1, "AW transfer 0");
        1: if ({awaddr, awid} !== {32'h00000ff0, 4'h2}) $fatal(1, "AW transfer 1");
        2: if ({awaddr, awid} !== {32'h00001000, 4'h3}) $fatal(1, "AW transfer 2");
        3: if ({awaddr, awid} !== {32'h00002000, 4'h4}) $fatal(1, "AW transfer 3");
        4: if ({awaddr, awid} !== {32'h00003000, 4'h5}) $fatal(1, "AW transfer 4");
        default: $fatal(1, "unexpected AW transfer %0d", aw_handshakes);
      endcase
      aw_handshakes <= aw_handshakes + 1;
    end
    if (wvalid && wready) begin
      if ({wdata, wstrb, wlast} !== {expected_wdata(w_handshakes), expected_wstrb(w_handshakes), expected_wlast(w_handshakes)})
        $fatal(1, "W transfer %0d mismatch", w_handshakes);
      w_handshakes <= w_handshakes + 1;
    end
    if (write_beat_done) begin
      if (write_beat_index !== expected_beat_index(beat_pulses))
        $fatal(1, "beat event %0d index mismatch", beat_pulses);
      beat_pulses <= beat_pulses + 1;
    end
    if (write_done)
      done_pulses <= done_pulses + 1;
  end

  task automatic pulse_command(input [31:0] address, input [3:0] id, input [31:0] data_base);
    begin
      @(negedge clk);
      cmd_awaddr = address;
      cmd_awid = id;
      cmd_wdata0 = data_base;
      cmd_wdata1 = data_base + 1;
      cmd_wdata2 = data_base + 2;
      cmd_wdata3 = data_base + 3;
      cmd_wstrb0 = 4'h1;
      cmd_wstrb1 = 4'h2;
      cmd_wstrb2 = 4'h4;
      cmd_wstrb3 = 4'h8;
      write_cmd_valid = 1;
      @(negedge clk);
      write_cmd_valid = 0;
      cmd_awaddr = 32'hdead0000;
      cmd_awid = 4'he;
      cmd_wdata0 = 32'hdead1000;
      cmd_wdata1 = 32'hdead1001;
      cmd_wdata2 = 32'hdead1002;
      cmd_wdata3 = 32'hdead1003;
      cmd_wstrb0 = 4'hf;
      cmd_wstrb1 = 4'hf;
      cmd_wstrb2 = 4'hf;
      cmd_wstrb3 = 4'hf;
    end
  endtask

  task automatic wait_counts(
    input integer expected_aw,
    input integer expected_w,
    input integer expected_beats,
    input integer expected_done
  );
    begin
      cycles = 0;
      while ((aw_handshakes < expected_aw || w_handshakes < expected_w
              || beat_pulses < expected_beats || done_pulses < expected_done)
             && cycles < 160) begin
        @(negedge clk);
        cycles = cycles + 1;
      end
      if (aw_handshakes != expected_aw || w_handshakes != expected_w
          || beat_pulses != expected_beats || done_pulses != expected_done)
        $fatal(1, "counts expected %0d/%0d/%0d/%0d got %0d/%0d/%0d/%0d",
          expected_aw, expected_w, expected_beats, expected_done,
          aw_handshakes, w_handshakes, beat_pulses, done_pulses);
    end
  endtask

  task automatic accept_one_w(input integer expected_w);
    begin
      @(negedge clk);
      wready = 1;
      cycles = 0;
      while (w_handshakes < expected_w && cycles < 40) begin
        @(negedge clk);
        cycles = cycles + 1;
      end
      if (w_handshakes != expected_w)
        $fatal(1, "WREADY pulse did not accept transfer %0d", expected_w);
      wready = 0;
    end
  endtask

  initial begin
    repeat (2) @(negedge clk);
    rst_n = 1;
    repeat (2) @(negedge clk);

`ifndef ASSERTIONS_ON
    awready = 1;
    wready = 1;
    pulse_command(32'h00001002, 4'hf, 32'hbad01000);
    repeat (10) @(negedge clk);
    pulse_command(32'h00000ff4, 4'hf, 32'hbad02000);
    repeat (10) @(negedge clk);
    if (awvalid || wvalid || write_busy || write_beat_done || write_done
        || aw_handshakes || w_handshakes || beat_pulses || done_pulses)
      $fatal(1, "illegal command launched request activity");
    illegal_ignored = 2;
`else
    illegal_ignored = 2;
`endif

    // Legal low-address proof, including address 4 under assertions.
    awready = 1;
    wready = 1;
    pulse_command(32'h00000004, 4'h1, 32'h00001000);
    wait_counts(1, 4, 4, 1);
    if (awvalid || wvalid || write_busy) $fatal(1, "simultaneous request did not retire");

    // W finishes first while AW remains stalled and stable.
    awready = 0;
    wready = 1;
    pulse_command(32'h00000ff0, 4'h2, 32'h00002000);
    wait_counts(1, 8, 8, 1);
    if (!awvalid || !write_busy || {awaddr, awid, awlen, awsize, awburst} !== {32'h00000ff0, 4'h2, 8'd3, 3'd2, 2'b01})
      $fatal(1, "W-first request did not retain AW");
    repeat (3) begin
      @(negedge clk);
      if (!awvalid || {awaddr, awid} !== {32'h00000ff0, 4'h2})
        $fatal(1, "stalled AW changed");
    end
    awready = 1;
    wait_counts(2, 8, 8, 2);

    // AW finishes first; pulse WREADY once per beat and ignore a busy command.
    awready = 1;
    wready = 0;
    pulse_command(32'h00001000, 4'h3, 32'h00003000);
    wait_counts(3, 8, 8, 2);
    cycles = 0;
    while (!wvalid && cycles < 40) begin
      @(negedge clk);
      cycles = cycles + 1;
    end
    if (!wvalid || !write_busy || {wdata, wstrb, wlast} !== {32'h00003000, 4'h1, 1'b0})
      $fatal(1, "AW-first request did not retain W beat zero");
    pulse_command(32'h00004000, 4'hf, 32'hbad03000);
    busy_ignored = 1;
    if (!write_busy || {wdata, wstrb, wlast} !== {32'h00003000, 4'h1, 1'b0})
      $fatal(1, "busy command corrupted the active request");
    accept_one_w(9);
    repeat (2) @(negedge clk);
    if ({wdata, wstrb, wlast} !== {32'h00003001, 4'h2, 1'b0}) $fatal(1, "stalled W beat one changed");
    accept_one_w(10);
    accept_one_w(11);
    repeat (2) @(negedge clk);
    if ({wdata, wstrb, wlast} !== {32'h00003003, 4'h8, 1'b1}) $fatal(1, "stalled final W beat changed");
    accept_one_w(12);
    wait_counts(3, 12, 12, 3);

    // Reset abort after AW and two W beats; no request completion is fabricated.
    awready = 1;
    wready = 0;
    pulse_command(32'h00002000, 4'h4, 32'h00004000);
    wait_counts(4, 12, 12, 3);
    accept_one_w(13);
    accept_one_w(14);
    wait_counts(4, 14, 14, 3);
    @(negedge clk);
    rst_n = 0;
    #1;
    if (awvalid || wvalid || write_busy || write_beat_done || write_done)
      $fatal(1, "reset did not abort the active request");
    reset_abort = 1;
    repeat (2) @(negedge clk);
    rst_n = 1;
    repeat (2) @(negedge clk);

    // Recovery restarts W at beat zero and completes normally.
    awready = 1;
    wready = 1;
    pulse_command(32'h00003000, 4'h5, 32'h00005000);
    wait_counts(5, 18, 18, 4);
    repeat (6) @(negedge clk);
    if (awvalid || wvalid || write_busy || write_beat_done || write_done)
      $fatal(1, "final request did not return idle");
    if (illegal_ignored != 2 || busy_ignored != 1 || reset_abort != 1)
      $fatal(1, "scenario accounting mismatch");

    $display("PASS aw=5 w=18 beat=18 done=4 illegal=2 busy_ignored=1 reset_abort=1");
    $finish;
  end

  initial begin
    #30000;
    $fatal(1, "AXI fixed-four write-request composition simulation timed out");
  end
endmodule
