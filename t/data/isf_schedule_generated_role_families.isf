(actor generated_role_families (clock clk) (reset (rst_n async active_low))
 (interface (input start) (output observed (width 8)) (output notice) (output done))
 (storage (var written (width 8) (reset 5)) (var read_value (width 8) (reset 7)))
 (transaction writer (set written 3) (complete notice))
 (transaction reader (ports (output result (width 8)))
  (set result read_value) (complete notice))
 (transaction main (on start)
  (spawn writer as writer_job)
  (spawn reader as reader_job (bind (output result observed)))
  (await_all done) (complete notice)))
