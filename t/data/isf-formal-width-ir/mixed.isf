(actor mixed_formal_width_ir (clock clk) (reset rst_n)
  (params (W 8) (ALIAS W))
  (interface (input start) (input data (width W)) (output result (width 4)) (output done))
  (transaction worker (params (W 4))
    (ports (input child_data (width W)) (output response (width W)))
    (update response child_data) (complete done))
  (transaction parent (ports (input data (width ALIAS))) (on start)
    (spawn worker as first (bind (input child_data 0) (output response result)))
    (await_all first) (complete done)))
