(actor formal_width_ir
  (clock clk) (reset rst_n)
  (imports (package shared))
  (params (W 8) (ACTOR_ALIAS W) (OTHER 8) (word_t 16))
  (constants (FIXED 8)) (types (type word_t (bits 8)))
  (interface (input start) (input other) (input data (width W)) (input N (width W))
    (output result (width W)) (output done_left) (output done_right))
  (storage (var saved (width ACTOR_ALIAS) (reset 3))
    (var isf_port_left_data (width 1)))
  (rule actor_copy 1 (result data))
  (transaction left (params (W 4) (ALIAS W) (OTHER 4) (word_t 4) (N 2))
    (ports (input data (width ALIAS)) (input saved (width W))
      (input equal_data (width OTHER)) (input inherited_data (width ACTOR_ALIAS))
      (input fixed_data (width FIXED)) (input package_data (width shared.WIDTH))
      (input collision_data (width word_t)) (input N (width W))
      (input literal_data (width 4)) (input typed_data (type word_t)) (input implicit_data)
      (output result (width W)))
    (on start) (update result data)
    (repeat N (update result N)) (complete done_left))
  (transaction right (params (W 6) (ALIAS W))
    (ports (input data (width ALIAS)) (output result (width W)))
    (on other) (update result data) (complete done_right)))
