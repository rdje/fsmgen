module ahb_requester_wrap_progression_audit_tb;
  logic clk = 0;
  logic rst_n = 0;
  logic HGRANT = 1;
  logic [31:0] HRDATA = 0;
  logic HREADY = 1;
  logic [1:0] HRESP = 0;
  logic [31:0] cmd_addr = 32'h00000003;
  logic [2:0] cmd_burst = 3'b010;
  logic [4:0] cmd_len = 4;
  logic cmd_lock = 0;
  logic [3:0] cmd_prot = 0;
  logic [2:0] cmd_size = 0;
  logic cmd_valid = 0;
  logic [31:0] cmd_wdata = 32'h11110000;
  logic [31:0] cmd_wdata_step = 1;
  logic cmd_write = 1;
  wire [31:0] HADDR;
  wire [2:0] HBURST;
  wire HBUSREQ;
  wire HLOCK;
  wire [3:0] HPROT;
  wire [2:0] HSIZE;
  wire [1:0] HTRANS;
  wire [31:0] HWDATA;
  wire HWRITE;
  wire [31:0] active_addr;
  wire [2:0] active_hburst;
  wire beat_done;
  wire [4:0] beat_index;
  wire [4:0] beats_remaining;
  wire burst_active;
  wire busy;
  wire cmd_ready;
  wire done;
  wire last_error;
  wire [31:0] last_read_data;
  wire [1:0] last_resp;
  wire last_retry;
  wire last_split;
  wire wrap_active;

  amba_requester dut (.*);
  always #5 clk = ~clk;

  integer cycles;
  integer transfer_count;
  logic previous_active;
  logic [31:0] accepted_addr [0:3];
  logic [1:0] accepted_trans [0:3];

  initial begin
    transfer_count = 0;
    previous_active = 0;

    repeat (3) @(negedge clk);
    rst_n = 1;
    @(negedge clk);
    cmd_valid = 1;
    @(negedge clk);
    cmd_valid = 0;

    cycles = 0;
    while (!done && cycles < 500) begin
      @(posedge clk);
      if (HTRANS[1] && !previous_active) begin
        if (transfer_count >= 4)
          $fatal(1, "unexpected extra active transfer");
        accepted_addr[transfer_count] = HADDR;
        accepted_trans[transfer_count] = HTRANS;
        if (HBURST !== 3'b010 || HSIZE !== 3'b000 || HWRITE !== 1'b1)
          $fatal(1, "transfer %0d lost WRAP4 byte-write control", transfer_count);
        transfer_count = transfer_count + 1;
      end
      previous_active = HTRANS[1];
      cycles = cycles + 1;
    end

    if (!done)
      $fatal(1, "WRAP4 request did not complete");
    if (transfer_count != 4)
      $fatal(1, "active transfer count=%0d expected=4", transfer_count);
    if (accepted_trans[0] !== 2'b10 || accepted_trans[1] !== 2'b11 ||
        accepted_trans[2] !== 2'b11 || accepted_trans[3] !== 2'b11)
      $fatal(1, "expected NONSEQ followed by three SEQ transfers");
    if (beats_remaining != 0 || last_resp != 0 || last_error || last_retry || last_split)
      $fatal(1, "WRAP4 request did not finish cleanly");

    $display(
      "OBSERVED_WRAP4 addresses=%08x,%08x,%08x,%08x",
      accepted_addr[0], accepted_addr[1], accepted_addr[2], accepted_addr[3]
    );
    $finish;
  end
endmodule
