(actor named_drive_transaction_priority
  (clock clk)
  (reset reset)
  (interface
    (input start)
    (input override_req)
    (output done)
    (output out))
  (priority main over force_out)
  (drive drive_zero
    (out 0))
  (transaction main
    (on start)
    (drive drive_zero)
    (complete done))
  (rule force_out override_req
    (out 1)))
