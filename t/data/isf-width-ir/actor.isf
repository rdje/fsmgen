(actor width_ir
  (clock clk) (reset rst_n) (watchdog WD)
  (imports (package shared))
  (params (W 8) (ALIAS W) (OTHER 8) (D 2) (WD 3) (word_t 16))
  (constants (FIXED 8)) (types (type word_t (bits 8)))
  (interface (input start) (input data (width W))
    (input alias_data (width ALIAS)) (input other_data (width OTHER))
    (input fixed_data (width FIXED)) (input package_data (width shared.WIDTH))
    (input collision_data (width word_t))
    (input literal_data (width 8)) (input typed_data (type word_t))
    (output result (width W)))
  (storage (var saved (width ALIAS) (reset 3))
    (bank mem (width OTHER) (depth D))
    (var fixed_saved (width FIXED)) (var package_saved (width shared.WIDTH))
    (var literal_saved (width 8)) (var typed_saved (type word_t)))
  (transaction main (params (W 4) (ALIAS W))
    (on start) (repeat ALIAS (set result data))))
