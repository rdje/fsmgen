(actor snapshot_runtime (clock clk) (reset (rst_n async active_low))
 (interface (input request_a) (input request_b) (input allow) (input proceed)
            (input data_a (width 4)) (input data_b (width 4))
            (output early (width 4)) (output observed (width 4)) (output done))
 (transaction worker (ports (input payload (width 4)))
  (when (& worker_start allow (!= payload 0)) (sample payload as early))
  (wait 3) (on proceed) (set observed payload) (complete done))
 (resources (resource worker (kind transaction_start) (arbiter priority) (users first second)))
 (priority first over second)
 (rule first request_a (trigger worker (bind (input payload data_a (timing snapshot)))))
 (rule second request_b (trigger worker (bind (input payload data_b (timing snapshot))))))
