(actor width_default_sources (clock clk) (reset rst_n)
  (params (BASE 8) (ACTOR_ALIAS BASE) (OTHER 8))
  (constants (FIXED 8))
  (interface (input start) (input direct_start)
    (output result (width 8)) (output direct_result (width 8))
    (output done) (output direct_done))
  (transaction worker
    (params (W BASE) (LOCAL_ALIAS W) (EQUAL 8)
      (LANES (BASE LOCAL_ALIAS FIXED (8 BASE))))
    (ports (input data (width LOCAL_ALIAS)) (output response (width W)))
    (update response data) (complete done))
  (transaction direct (on direct_start)
    (params (W ACTOR_ALIAS) (LOCAL_ALIAS W))
    (ports (input payload (width LOCAL_ALIAS)) (output answer (width W)))
    (update answer payload) (complete direct_done))
  (transaction parent (on start)
    (spawn worker as first (bind (input data 0) (output response result)))
    (await_all first) (complete done)))
