(actor packed_input_generated_domains
 (clock-domains (domain idle (clock idle_clk) :default)
  (domain io (clock clk) (reset (rst_n async active_low))))
 (types (type frame (record (tag (bits 2))
  (payload (record (data (signed (four_state (bits 5))))
   (flags (list (two_state bit) (two_state (bits 2)))))))))
 (interface
  (input start (domain io)) (input packet (type frame) (domain io))
  (input unused (type frame) (domain idle))
  (output phase (width 2) (reset 0) (domain io))
  (output seen (width 5) (reset 0) (domain io))
  (output again (width 5) (reset 0) (domain io))
  (output negative_seen (reset 0) (domain io))
  (output negative_again (reset 0) (domain io))
  (output copy_seen (width 5) (reset 0) (domain io))
  (output stored (width 5) (reset 0) (domain io))
  (output copied_tag (width 2) (reset 0) (domain io))
  (output stored_flag (reset 0) (domain io))
  (output stored_piece (width 2) (reset 0) (domain io))
  (output captured (width 5) (reset 0) (domain io))
  (output reset_seen (width 5) (reset 0) (domain io))
  (output done (reset 0) (domain io)))
 (storage (var held (type frame) (reset 149) (domain io)))
 (transaction copier (domain io) (params (MODE 0))
  (ports (output result (width 5)))
  (wait 2) (set held packet) (set result packet.payload.data) (complete done))
 (transaction reader (domain io)
  (ports (output result (width 5)) (output is_negative))
  (wait 2) (set result packet.payload.data)
  (set is_negative (< packet.payload.data 0)) (complete done))
 (transaction main (domain io)
  (on start (sample packet.payload.data as accepted))
  (set reset_seen held.payload.data)
  (set phase 1) (wait 3)
  (spawn copier as writer (bind (output result copy_seen))) (await_all done)
  (set phase 2) (wait 3)
  (spawn reader as left (bind (output result seen) (output is_negative negative_seen)))
  (spawn reader as right (bind (output result again) (output is_negative negative_again)))
  (await_all done)
  (set stored held.payload.data) (set copied_tag held.tag)
  (set stored_flag held.payload.flags[0]) (set stored_piece held.payload.flags[1])
  (set captured accepted) (complete done)))
