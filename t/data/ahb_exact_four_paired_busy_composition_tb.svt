module ahb_exact_four_paired_busy_composition_tb;
  logic clk = 0;
  logic rst_n = 0;
  logic [31:0] cmd_addr = 0;
  logic [2:0] cmd_burst = 3'b011;
  logic [4:0] cmd_len = 4;
  logic cmd_lock = 0;
  logic [3:0] cmd_prot = 0;
  logic [2:0] cmd_size = 0;
  logic cmd_valid = 0;
  logic [31:0] cmd_wdata = 32'h11111111;
  logic [31:0] cmd_wdata_step = 32'h11111111;
  logic cmd_write = 1;
  logic [3:0] wait_cycles = 0;
  wire [31:0] active_addr;
  wire [2:0] active_hburst;
  wire beat_done;
  wire [4:0] beat_index;
  wire [4:0] beats_remaining;
  wire burst_active;
  wire busy;
  wire cmd_ready;
  wire done;
  wire last_error;
  wire [31:0] last_read_data;
  wire [1:0] last_resp;
  wire last_retry;
  wire last_split;
  wire wrap_active;

  ahb_tb dut (.*);
  always #5 clk = ~clk;

  integer cycles;
  integer transfer_count;
  integer beat_count;
  integer busy_count;
  integer qualified_busy_count;
  integer resumed_seq_count;
  logic previous_beat_done;
  logic [1:0] previous_htrans;
  logic [31:0] busy_addr;
  logic busy_write;
  logic [2:0] busy_size;
  logic [2:0] busy_burst;
  logic [3:0] busy_prot;
  logic [31:0] busy_wdata;
  logic [4:0] busy_index;
  logic [4:0] busy_remaining;
  logic busy_seq_valid;
  logic [31:0] busy_seq_expected_addr;
  logic [1:0] busy_seq_beats_remaining;
  logic [31:0] busy_storage;
  logic busy_phase_pending;
  logic busy_data_owner;

  task automatic check_transfer;
    begin
      if (!dut.comp_link_requester_HBUSREQ)
        $fatal(1, "non-IDLE transfer did not hold HBUSREQ");
      case (transfer_count)
        0: begin
          if (dut.comp_link_requester_HTRANS !== 2'b10 || beat_index !== 0 || beats_remaining !== 4)
            $fatal(1, "first presentation was not NONSEQ index=0 remaining=4");
        end
        1: begin
          if (dut.comp_link_requester_HTRANS !== 2'b11 || beat_index !== 1 || beats_remaining !== 3)
            $fatal(1, "second presentation HTRANS=%b index=%0d remaining=%0d", dut.comp_link_requester_HTRANS, beat_index, beats_remaining);
        end
        2: begin
          if (dut.comp_link_requester_HTRANS !== 2'b01 || beat_index !== 2 || beats_remaining !== 2)
            $fatal(1, "third presentation HTRANS=%b index=%0d remaining=%0d; expected held BUSY before index=2", dut.comp_link_requester_HTRANS, beat_index, beats_remaining);
          busy_count = busy_count + 1;
          busy_addr = dut.comp_link_requester_HADDR;
          busy_write = dut.comp_link_requester_HWRITE;
          busy_size = dut.comp_link_requester_HSIZE;
          busy_burst = dut.comp_link_requester_HBURST;
          busy_prot = dut.comp_link_requester_HPROT;
          busy_wdata = dut.comp_link_requester_HWDATA;
          busy_index = beat_index;
          busy_remaining = beats_remaining;
          busy_seq_valid = dut.regs.seq_valid_q;
          busy_seq_expected_addr = dut.regs.seq_expected_addr_q;
          busy_seq_beats_remaining = dut.regs.seq_beats_remaining_q;
          busy_storage = dut.regs.reg_data_q;
          busy_phase_pending = dut.regs.ahb_phase_pending_q;
          busy_data_owner = dut.fabric.ahb_data_owner_0_q;
        end
        3: begin
          if (dut.comp_link_requester_HTRANS !== 2'b11)
            $fatal(1, "BUSY was not followed by resumed SEQ");
          if (dut.comp_link_requester_HADDR !== busy_addr ||
              dut.comp_link_requester_HWRITE !== busy_write ||
              dut.comp_link_requester_HSIZE !== busy_size ||
              dut.comp_link_requester_HBURST !== busy_burst ||
              dut.comp_link_requester_HPROT !== busy_prot ||
              dut.comp_link_requester_HWDATA !== busy_wdata)
            $fatal(1, "BUSY did not hold the pending SEQ address/control/data");
          if (beat_index !== busy_index || beats_remaining !== busy_remaining)
            $fatal(1, "BUSY advanced requester counters before resumed SEQ");
          if (dut.regs.seq_valid_q !== busy_seq_valid ||
              dut.regs.seq_expected_addr_q !== busy_seq_expected_addr ||
              dut.regs.seq_beats_remaining_q !== busy_seq_beats_remaining)
            $fatal(1, "subordinate SEQ state changed while BUSY was parked");
          if (dut.regs.reg_data_q !== busy_storage)
            $fatal(1, "subordinate storage changed while BUSY was parked");
          if (dut.regs.ahb_phase_pending_q !== busy_phase_pending)
            $fatal(1, "subordinate phase ownership changed while BUSY was parked");
          if (dut.fabric.ahb_data_owner_0_q !== busy_data_owner)
            $fatal(1, "interconnect data-phase ownership changed while BUSY was parked");
          if (dut.requester.ahb_busy_remaining_q !== 0)
            $fatal(1, "resumed SEQ retained BUSY count=%0d", dut.requester.ahb_busy_remaining_q);
          resumed_seq_count = resumed_seq_count + 1;
        end
        4: begin
          if (dut.comp_link_requester_HTRANS !== 2'b11 || beat_index !== 3 || beats_remaining !== 1)
            $fatal(1, "final presentation was not SEQ index=3 remaining=1");
        end
        default: $fatal(1, "unexpected extra non-IDLE transfer presentation");
      endcase
      transfer_count = transfer_count + 1;
    end
  endtask

  initial begin
    transfer_count = 0;
    beat_count = 0;
    busy_count = 0;
    qualified_busy_count = 0;
    resumed_seq_count = 0;
    previous_beat_done = 0;
    previous_htrans = 0;

    repeat (3) @(negedge clk);
    rst_n = 1;
    @(negedge clk);
    cmd_valid = 1;
    @(negedge clk);
    cmd_valid = 0;

    cycles = 0;
    while (!done && cycles < 500) begin
      @(posedge clk);
      if (dut.comp_link_requester_HTRANS != 2'b00 &&
          (previous_htrans == 2'b00 || dut.comp_link_requester_HTRANS != previous_htrans))
        check_transfer();
      if (dut.comp_link_requester_HTRANS == 2'b01) begin
        if (beat_done)
          $fatal(1, "BUSY presentation completed a data beat");
        if (busy_count != 0) begin
          if (dut.comp_link_requester_HADDR !== busy_addr ||
              dut.comp_link_requester_HWRITE !== busy_write ||
              dut.comp_link_requester_HSIZE !== busy_size ||
              dut.comp_link_requester_HBURST !== busy_burst ||
              dut.comp_link_requester_HPROT !== busy_prot ||
              dut.comp_link_requester_HWDATA !== busy_wdata)
            $fatal(1, "BUSY episode changed pending address/control/data");
          if (beat_index !== busy_index || beats_remaining !== busy_remaining)
            $fatal(1, "BUSY episode changed pending beat counters");
          if (dut.regs.seq_valid_q !== busy_seq_valid ||
              dut.regs.seq_expected_addr_q !== busy_seq_expected_addr ||
              dut.regs.seq_beats_remaining_q !== busy_seq_beats_remaining)
            $fatal(1, "BUSY episode changed subordinate SEQ continuation");
          if (dut.regs.reg_data_q !== busy_storage)
            $fatal(1, "BUSY episode changed subordinate storage");
          if (dut.regs.ahb_phase_pending_q !== busy_phase_pending)
            $fatal(1, "BUSY episode changed subordinate phase ownership");
          if (dut.fabric.ahb_data_owner_0_q !== busy_data_owner)
            $fatal(1, "BUSY episode changed interconnect data-phase ownership");
        end
        if (dut.comp_link_fabric_HGRANT && dut.comp_link_fabric_HREADY) begin
          if (qualified_busy_count == 0 && dut.requester.ahb_busy_remaining_q !== 4)
            $fatal(1, "first qualified BUSY saw remaining=%0d expected=4", dut.requester.ahb_busy_remaining_q);
          if (qualified_busy_count == 1 && dut.requester.ahb_busy_remaining_q !== 3)
            $fatal(1, "second qualified BUSY saw remaining=%0d expected=3", dut.requester.ahb_busy_remaining_q);
          if (qualified_busy_count == 2 && dut.requester.ahb_busy_remaining_q !== 2)
            $fatal(1, "third qualified BUSY saw remaining=%0d expected=2", dut.requester.ahb_busy_remaining_q);
          if (qualified_busy_count == 3 && dut.requester.ahb_busy_remaining_q !== 1)
            $fatal(1, "fourth qualified BUSY saw remaining=%0d expected=1", dut.requester.ahb_busy_remaining_q);
          qualified_busy_count = qualified_busy_count + 1;
        end
      end
      if (beat_done && !previous_beat_done) begin
        if (beat_index !== beat_count[4:0])
          $fatal(1, "accepted beat index=%0d expected=%0d", beat_index, beat_count);
        beat_count = beat_count + 1;
      end
      previous_beat_done = beat_done;
      previous_htrans = dut.comp_link_requester_HTRANS;
      cycles = cycles + 1;
    end

    if (!done)
      $fatal(1, "paired BUSY aggregate request did not complete");
    if (transfer_count != 5 || beat_count != 4 || busy_count != 1 || qualified_busy_count != 4 || resumed_seq_count != 1)
      $fatal(1, "counts transfers=%0d beats=%0d busy=%0d qualified_busy=%0d resumed_seq=%0d", transfer_count, beat_count, busy_count, qualified_busy_count, resumed_seq_count);
    if (beats_remaining != 0)
      $fatal(1, "completion left remaining count=%0d", beats_remaining);
    if (last_resp !== 2'b00 || last_error || last_retry || last_split)
      $fatal(1, "completion status resp=%b error=%b retry=%b split=%b", last_resp, last_error, last_retry, last_split);
    if (dut.regs.reg_data_q !== 32'h44332211)
      $fatal(1, "final storage=%h expected=44332211", dut.regs.reg_data_q);
    $display("PASS transfers=%0d beats=%0d busy=%0d qualified_busy=%0d resumed_seq=%0d storage=%h", transfer_count, beat_count, busy_count, qualified_busy_count, resumed_seq_count, dut.regs.reg_data_q);
    $finish;
  end
endmodule
