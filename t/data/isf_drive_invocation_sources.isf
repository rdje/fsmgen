(actor drive_invocation_sources (clock clk) (reset rst_n)
 (interface (input start) (input second_start) (input third_start) (input fire)
  (output done) (output observed (width 8)) (output side))
 (drive (put payload) (observed payload) (side 1))
 (transaction main (on start) (drive put 3)
  (spawn worker as job) (await_all done) (complete done))
 (transaction second (on second_start) (drive put 5) (complete done))
 (transaction third (on third_start) (do worker) (complete done))
 (transaction worker (drive put 7) (complete done))
 (rule launch (when fire) (trigger worker)))
