  // Unified Multiplexer for LHS: P1
  // Delayed pulse logic for: P1 (<3, exact Q+3)
  always_ff @(posedge clk or negedge rstn) begin
    if (!rstn) begin
      P1 <= 1'b0;
      P1_pulse_delay_pipe <= {3{1'b0}};
    end else begin
      P1 <= 1'b0;
      if (P1_pulse_delay_pipe[2]) begin
        P1 <= 1'b1;
      end
      P1_pulse_delay_pipe <= {P1_pulse_delay_pipe[1:0], p1_1_en};
    end
  end
