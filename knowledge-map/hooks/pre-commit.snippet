# --- Knowledge Map (KM) gate — append these lines to your .githooks/pre-commit ---------
# Regenerate the bounded root/topic shards, stage additions and removals, then
# validate cards, freshness, coverage, and cached/direct query parity.
# Requires: git config core.hooksPath .githooks   (one-time, per clone)

ROOT="$(git rev-parse --show-toplevel)"
"$ROOT/knowledge-map/scripts/gen_knowledge_map.sh" >/dev/null
mapfile -t knowledge_map_paths < <(
  "$ROOT/knowledge-map/scripts/gen_knowledge_map.sh" --print-generated-paths
)
git add -A -- "${knowledge_map_paths[@]}"
"$ROOT/knowledge-map/scripts/check_knowledge_map.sh"
# ---------------------------------------------------------------------------------------
