(actor record_input_children
  (clock-domains
    (domain idle (clock idle_clk) :default)
    (domain io (clock clk) (reset (rst_n async active_low))))
  (imports (package record_input_types))
  (types (type frame record_input_types.frame))
  (interface
    (input start (domain io))
    (input packet (type frame) (domain io))
    (input unused (type frame) (domain idle))
    (output seen (width 5) (domain io))
    (output again (width 5) (domain io))
    (output done (domain io)))
  (storage (var held (type frame) (reset 0) (domain io)))
  (transaction worker (domain io)
    (ports (output result (width 5)))
    (wait 2)
    (set result packet.data)
    (complete done))
  (transaction main (domain io)
    (on start)
    (set held packet)
    (spawn worker as left (bind (output result seen)))
    (spawn worker as right (bind (output result again)))
    (await_all done)
    (complete done)))
