;; Spawn test — parent spawns child three times
(actor spawn_parent
  (clock clk)
  (reset rst_n (async) (active_low))
  (watchdog 65536)

  (interface
    (input  trigger)
    (output done)
    (output rdata (width 32)))

  (handshake go
    (valid trigger)
    (ready done))

  (transaction child_worker
    (sample trigger as val)
    (drive work
      (assign rdata val))
    (complete done)
    (latency (min 1) (max 16)))

  (transaction parent_main
    (on go)
    (spawn child_worker as w0)
    (spawn child_worker as w1)
    (spawn child_worker as w2)
    (await_all done)
    (complete done)))
