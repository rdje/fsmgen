;; I2C master controller — real protocol test for ISF
(actor i2c_master
  (clock clk)
  (reset (rst_n async active_low))
  (watchdog 65536)

  (interface
    (input  start)
    (input  rw)
    (input  dev_addr (width 7))
    (input  reg_addr (width 8))
    (input  wdata    (width 8))
    (output done)
    (output rdata    (width 8))
    (output scl)
    (output sda_out)
    (input  sda_in))

  ;; Drive definitions for I2C phases
  (drive start_condition
    (sda_out 0)
    (scl 1))

  (drive stop_condition
    (sda_out 0)
    (scl 1))

  (drive send_bit_1
    (sda_out 1)
    (scl 1))

  (drive send_bit_0
    (sda_out 0)
    (scl 1))

  (drive scl_low
    (scl 0))

  (drive read_bit
    (scl 0))

  (transaction i2c_transfer
    (on start
      (sample rw       as is_read)
      (sample dev_addr as addr)
      (sample reg_addr as reg)
      (sample wdata    as data))

    ;; START condition
    (drive start_condition)
    (drive scl_low)

    ;; Send device address (7 bits + R/W)
    (drive send_bit_1) (drive scl_low)
    (drive send_bit_0) (drive scl_low)
    (drive send_bit_0) (drive scl_low)
    (drive send_bit_0) (drive scl_low)
    (drive send_bit_0) (drive scl_low)
    (drive send_bit_0) (drive scl_low)
    (drive send_bit_0) (drive scl_low)
    (switch is_read
      (1 (drive send_bit_1))
      (0 (drive send_bit_0)))
    (drive scl_low)

    ;; Wait for ACK
    (drive read_bit) (drive scl_low)

    ;; Send register address
    (drive send_bit_0) (drive scl_low)
    (drive send_bit_0) (drive scl_low)
    (drive send_bit_0) (drive scl_low)
    (drive send_bit_0) (drive scl_low)
    (drive send_bit_0) (drive scl_low)
    (drive send_bit_0) (drive scl_low)
    (drive send_bit_0) (drive scl_low)
    (drive send_bit_0) (drive scl_low)

    ;; Wait for ACK
    (drive read_bit) (drive scl_low)

    (switch is_read
      ;; READ: receive data
      (1 (drive read_bit) (drive scl_low)
         (drive read_bit) (drive scl_low)
         (drive read_bit) (drive scl_low)
         (drive read_bit) (drive scl_low)
         (drive read_bit) (drive scl_low)
         (drive read_bit) (drive scl_low)
         (drive read_bit) (drive scl_low)
         (drive read_bit) (drive scl_low))
      ;; WRITE: send data
      (0 (drive send_bit_0) (drive scl_low)
         (drive send_bit_0) (drive scl_low)
         (drive send_bit_0) (drive scl_low)
         (drive send_bit_0) (drive scl_low)
         (drive send_bit_0) (drive scl_low)
         (drive send_bit_0) (drive scl_low)
         (drive send_bit_0) (drive scl_low)
         (drive send_bit_0) (drive scl_low)))

    ;; STOP condition
    (drive scl_low)
    (drive stop_condition)

    (complete done)))
