;; I2C with parameterized drives
(actor i2c_master
  (clock clk)
  (reset (rst_n async active_low))
  (watchdog 65536)

  (interface
    (input  start)
    (input  rw)
    (input  dev_addr (width 7))
    (input  reg_addr (width 8))
    (input  wdata    (width 8))
    (output done)
    (output rdata    (width 8))
    (output scl)
    (output sda_out)
    (input  sda_in))

  ;; Parameterized: (drive scl val) drives scl to val
  (drive (scl val)
    (scl val))

  (drive (sda val)
    (sda_out val))

  (transaction i2c_transfer
    (on start
      (sample rw       as is_read)
      (sample dev_addr as addr)
      (sample reg_addr as reg)
      (sample wdata    as data))

    ;; START: SDA low while SCL high
    (drive scl 1) (drive sda 0)
    (drive scl 0)

    ;; Send 7-bit address + R/W
    (repeat 7 (drive scl 1) (drive scl 0))
    (drive scl 1)
    (switch is_read
      (1 (drive sda 1))
      (0 (drive sda 0)))
    (drive scl 0)

    ;; ACK
    (drive scl 1) (drive scl 0)

    ;; Register address
    (repeat 8 (drive scl 1) (drive scl 0))

    ;; ACK
    (drive scl 1) (drive scl 0)

    ;; Data
    (switch is_read
      (1 (repeat 8 (drive scl 1) (update rdata (| (<< rdata 1) sda_in)) (drive scl 0)))
      (0 (repeat 8 (drive scl 1) (drive sda data_bit) (drive scl 0))))

    ;; STOP
    (drive scl 0) (drive sda 0)
    (drive scl 1) (drive sda 1)

    (complete done)))
