;; I2C master controller — using (repeat 8 ...) for bit-banging
(actor i2c_master
  (clock clk)
  (reset (rst_n async active_low))
  (watchdog 65536)

  (interface
    (input  start)
    (input  rw)
    (input  dev_addr (width 7))
    (input  reg_addr (width 8))
    (input  wdata    (width 8))
    (output done)
    (output rdata    (width 8))
    (output scl)
    (output sda_out)
    (input  sda_in))

  (drive scl_hi  (scl 1))
  (drive scl_lo  (scl 0))
  (drive sda_hi  (sda_out 1))
  (drive sda_lo  (sda_out 0))

  (transaction i2c_transfer
    (on start
      (sample rw       as is_read)
      (sample dev_addr as addr)
      (sample reg_addr as reg)
      (sample wdata    as data))

    ;; START: SDA low while SCL high
    (drive scl_hi) (drive sda_lo) (drive scl_lo)

    ;; Send 7-bit address + R/W
    (repeat 7 (drive scl_hi) (drive scl_lo))
    (drive scl_hi)
    (switch is_read
      (1 (drive sda_hi))
      (0 (drive sda_lo)))
    (drive scl_lo)

    ;; ACK (master reads, slave drives)
    (drive scl_hi) (drive scl_lo)

    ;; Send register address (8 bits)
    (repeat 8 (drive scl_hi) (drive scl_lo))

    ;; ACK
    (drive scl_hi) (drive scl_lo)

    ;; Data: read or write 8 bits
    (switch is_read
      (1 (repeat 8 (drive scl_hi) (drive scl_lo)))
      (0 (repeat 8 (drive scl_hi) (drive scl_lo))))

    ;; STOP: SDA high while SCL high
    (drive scl_lo) (drive sda_lo) (drive scl_hi) (drive sda_hi)

    (complete done)))
