(actor when_test
  (clock clk)
  (reset (rst_n async active_low))
  (watchdog 65536)

  (interface
    (input  start)
    (output done)
    (output result (width 32))
    (input  mode))

  (drive (result val) (result val))
  (drive (done val)   (done val))

  (transaction test_tx
    (on start)
    (drive result 0)
    (when mode
      (drive result 42)
      (drive done 1))
    (when mode
      (drive result 7))
    (complete done)))
