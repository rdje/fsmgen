;; Comprehensive ISF fixture exercising all defined constructs
(actor full_featured
  (clock clk)
  (reset (rst_n async active_low))
  (watchdog 32768)

  (interface
    (input  start)
    (output done)
    (input  addr    (width 32))
    (input  wdata   (width 32))
    (output rdata   (width 32))
    (input  ready)
    (output valid)
    (output err))

  ;; Drive definitions (actor-level)
  (drive (rdata val)  (rdata val))
  (drive (valid val)  (valid val))
  (drive (err val)    (err val))

  ;; Transaction with sample, drive, await, complete, latency
  (transaction main_transfer
    (on start
      (sample addr  as captured_addr)
      (sample wdata as captured_wdata))
    (drive valid 1)
    (drive rdata captured_addr)
    (await ready)
    (sample ready as was_ready)
    (drive err 0)
    (complete done)
    (latency (min 1) (max 64)))

  ;; Nested composition: sequence with do
  (transaction chained
    (on start (sample addr as base))
    (do main_transfer)
    (do main_transfer)
    (complete done))

  ;; Parallel spawn
  (transaction parallel_work
    (on start (sample addr as base))
    (spawn main_transfer as worker_0)
    (spawn main_transfer as worker_1)
    (spawn main_transfer as worker_2)
    (await_all done)
    (complete done))

  ;; Rule: always ready
  (rule always_ready ready
    (valid 1)
    (trigger main_transfer))

  ;; Rule: error gate
  (rule error_gate
    (when err)
    (valid 1)
    (err 1))

  ;; Inline priority
  (rule high_pri
    (priority over always_ready)
    (when start)
    (rdata 0))

  ;; Separate priority section
  (priority main_transfer over chained)

  ;; Resources
  (resources
    (resource shared_bus (arbiter priority))
    (resource mem_port   (arbiter round_robin))))
