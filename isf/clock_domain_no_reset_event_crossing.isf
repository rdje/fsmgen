(actor clock_domain_no_reset_event_crossing
  (clock-domains
    (domain source (clock bus_clk) :default)
    (domain core (clock core_clk)))
  (crossings
    (event req_seen
      (from source req_seen_req)
      (to core req_seen_pulse)
      (ready req_seen_ready)))
  (interface
    (input bus_start (domain source))
    (output core_req_seen (domain core)))
  (transaction bus_launch
    (domain source)
    (on bus_start)
    (await req_seen_ready)
    (complete req_seen_req))
  (transaction core_consume
    (domain core)
    (on req_seen_pulse)
    (complete core_req_seen)))
