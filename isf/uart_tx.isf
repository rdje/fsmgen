;; UART transmitter — 8N1, configurable baud
(actor uart_tx
  (clock clk)
  (reset (rst_n async active_low))
  (watchdog 65536)

  (interface
    (input  start)
    (input  data (width 8))
    (output done)
    (output tx)
    (output busy))

  ;; Drive definitions
  (drive (tx val) (tx val))
  (drive (busy val) (busy val))

  (transaction send_byte
    (on start
      (sample data as byte_data))

    ;; Assert busy, send start bit (tx=0)
    (drive busy 1)
    (drive tx 0)

    ;; Send 8 data bits, LSB first
    (repeat 8
      (drive tx byte_data)
      (shift_right byte_data 0))

    ;; Send stop bit (tx=1)
    (drive tx 1)

    ;; Deassert busy, done
    (drive busy 0)
    (complete done)))
