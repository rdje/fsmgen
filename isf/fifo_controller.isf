;; Depth-4 FIFO controller matrix.
;;
;; This fixture models the controller state only: write/read pointers,
;; occupancy, and actor-maintained full/empty flags. The data-storage datapath
;; is intentionally not modeled in this slice.
(actor fifo_update_matrix
  (clock clk)
  (reset (rst_n async active_low))
  (interface
    (input write_req)
    (input data_in (width 8))
    (input read_req)
    (output full)
    (output empty)
    (output data_out (width 8)))
  (storage
    (var wr_ptr (width 2))
    (var rd_ptr (width 2))
    (var occupancy (width 3)))

  (rule idle_occ0 (& (! write_req) (! read_req) (== occupancy 0))
    (occupancy 0)
    (empty 1)
    (full 0))
  (rule idle_occ1 (& (! write_req) (! read_req) (== occupancy 1))
    (occupancy 1)
    (empty 0)
    (full 0))
  (rule idle_occ2 (& (! write_req) (! read_req) (== occupancy 2))
    (occupancy 2)
    (empty 0)
    (full 0))
  (rule idle_occ3 (& (! write_req) (! read_req) (== occupancy 3))
    (occupancy 3)
    (empty 0)
    (full 0))
  (rule idle_occ4 (& (! write_req) (! read_req) (== occupancy 4))
    (occupancy 4)
    (empty 0)
    (full 1))

  (rule push_only_occ0 (& write_req (! read_req) (== occupancy 0))
    (occupancy 1)
    (empty 0)
    (full 0))
  (rule push_only_occ1 (& write_req (! read_req) (== occupancy 1))
    (occupancy 2)
    (empty 0)
    (full 0))
  (rule push_only_occ2 (& write_req (! read_req) (== occupancy 2))
    (occupancy 3)
    (empty 0)
    (full 0))
  (rule push_only_occ3 (& write_req (! read_req) (== occupancy 3))
    (occupancy 4)
    (empty 0)
    (full 1))
  (rule push_only_occ4 (& write_req (! read_req) (== occupancy 4))
    (occupancy 4)
    (empty 0)
    (full 1))

  (rule pop_only_occ0 (& (! write_req) read_req (== occupancy 0))
    (occupancy 0)
    (empty 1)
    (full 0))
  (rule pop_only_occ1 (& (! write_req) read_req (== occupancy 1))
    (occupancy 0)
    (empty 1)
    (full 0))
  (rule pop_only_occ2 (& (! write_req) read_req (== occupancy 2))
    (occupancy 1)
    (empty 0)
    (full 0))
  (rule pop_only_occ3 (& (! write_req) read_req (== occupancy 3))
    (occupancy 2)
    (empty 0)
    (full 0))
  (rule pop_only_occ4 (& (! write_req) read_req (== occupancy 4))
    (occupancy 3)
    (empty 0)
    (full 0))

  (rule push_pop_occ0 (& write_req read_req (== occupancy 0))
    (occupancy 1)
    (empty 0)
    (full 0))
  (rule push_pop_occ1 (& write_req read_req (== occupancy 1))
    (occupancy 1)
    (empty 0)
    (full 0))
  (rule push_pop_occ2 (& write_req read_req (== occupancy 2))
    (occupancy 2)
    (empty 0)
    (full 0))
  (rule push_pop_occ3 (& write_req read_req (== occupancy 3))
    (occupancy 3)
    (empty 0)
    (full 0))
  (rule push_pop_occ4 (& write_req read_req (== occupancy 4))
    (occupancy 4)
    (empty 0)
    (full 1))

  (rule write_at_0 (& write_req (| (! (== occupancy 4)) read_req) (== wr_ptr 0))
    (wr_ptr 1))
  (rule write_at_1 (& write_req (| (! (== occupancy 4)) read_req) (== wr_ptr 1))
    (wr_ptr 2))
  (rule write_at_2 (& write_req (| (! (== occupancy 4)) read_req) (== wr_ptr 2))
    (wr_ptr 3))
  (rule write_at_3 (& write_req (| (! (== occupancy 4)) read_req) (== wr_ptr 3))
    (wr_ptr 0))

  (rule read_from_0 (& read_req (! (== occupancy 0)) (== rd_ptr 0))
    (rd_ptr 1))
  (rule read_from_1 (& read_req (! (== occupancy 0)) (== rd_ptr 1))
    (rd_ptr 2))
  (rule read_from_2 (& read_req (! (== occupancy 0)) (== rd_ptr 2))
    (rd_ptr 3))
  (rule read_from_3 (& read_req (! (== occupancy 0)) (== rd_ptr 3))
    (rd_ptr 0)))
