;; Burst read actor exercising (repeat ...)
(actor burst_reader
  (clock clk)
  (reset (rst_n async active_low))
  (watchdog 65536)

  (interface
    (input  start)
    (output done)
    (input  addr (width 32))
    (input  burst_len (width 8))
    (output rdata (width 32))
    (input  ready)
    (output valid))

  (drive header
    (valid 1)
    (rdata base_addr))

  (drive footer
    (valid 0))

  (transaction read_burst
    (on start
      (sample addr       as base_addr)
      (sample burst_len  as beats))
    (drive header)
    (await ready)
    (repeat beats
      (await ready)
      (sample rdata as word))
    (drive footer)
    (complete done)
    (latency (min 2) (max 256))))
