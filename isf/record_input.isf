(actor record_input
  (imports (package record_input_types))
  (types
    (type frame record_input_types.frame))
  (interface
    (input start)
    (input packet (type frame))
    (output seen (width 5))
    (output done))
  (storage (var held (type frame)))
  (transaction main
    (on start)
    (set held packet)
    (set seen packet.data)
    (complete done)))
