(actor generated
  (interface (input request) (input allow) (input datain (width 3)) (input other (width 3)) (output seen (width 3)) (output done))
  (proc choose (params (c (width 1)) (v (width 3)) (alt (width 3)) (out dst (width 3))) (cond (c (set dst v)) (else (set dst alt))))
  (transaction parent (on request) (do main (params (MODE 1)) (bind (input value datain) (output result seen))) (complete done))
  (transaction main (params (MODE 1)) (ports (input value (width 3)) (output result (width 3))) (on request) (call choose allow value other result) (complete done)))
