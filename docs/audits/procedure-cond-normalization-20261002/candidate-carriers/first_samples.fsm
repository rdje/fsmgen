(?fsm:first_samples

  (+system
    (clock clk)
    (areset rst_n)
  )

  (+interface
    (input request)
    (input allow)
    (input datain)
    (input other)
    (output seen)
    (output done)
  )

  (+size
    (request 1)
    (allow 1)
    (datain 3)
    (other 3)
    (seen 3)
    (done 1)
    (can_accept 1)
  )

  (main_idle_0
    (= (can_accept 1))
    (<= (captured datain) <allow)
    (<allow
      (-> main_when_1)
    )
  )

  (main_when_1
    (?(! allow)
      (=1 (-> main_sample_2))
      (=0 (-> main_done_3))
    )
  )

  (main_sample_2
    (<= (saved other))
    (-> main_done_3)
  )

  (main_done_3
    (<1 (done> 1))
    (-> main_idle_0)
  )

)
