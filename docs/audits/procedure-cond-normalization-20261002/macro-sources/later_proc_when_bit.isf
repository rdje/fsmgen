(actor later_proc_when_bit
  (clock clk) (reset (rst_n sync active_low))
  (interface (input request) (input allow) (input datain (width 3)) (input other (width 3)) (output seen (width 3)) (output done))
  (proc choose (params (v (width 3)) (alt (width 3))) (when-bit v 1 (set seen alt)))
  (transaction main (on request) (call choose datain other) (complete done)))
