(actor requester
  (clock CLK)
  (reset (RESETn async active_low))
  (watchdog 65536)
  (interface
    (output DATA (width 16))
    (output DATACHK0 (width 1))
    (output DATACHK1 (width 1))
    (output VALID (width 1))
  )
  (drive (DATA val) (DATA val))
  (drive (VALID val) (VALID val))
  (rule parity_byte0 (== VALID 1)
    (DATACHK0 (! (^ (^ (^ (^ (^ (^ (^ DATA[0] DATA[1]) DATA[2]) DATA[3]) DATA[4]) DATA[5]) DATA[6]) DATA[7])))
  )
  (rule parity_byte1 (== VALID 1)
    (DATACHK1 (! (^ (^ (^ (^ (^ (^ (^ DATA[8] DATA[9]) DATA[10]) DATA[11]) DATA[12]) DATA[13]) DATA[14]) DATA[15])))
  )
)
