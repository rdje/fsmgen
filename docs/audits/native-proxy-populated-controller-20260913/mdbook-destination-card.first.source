evidence: docs/audits/native-proxy-populated-controller-20260913/book-recovery.json; docs/audits/native-proxy-populated-controller-20260913/book-review.json; docs/tasks/HIAL-VIAL-VERIFICATION-FIXTURE-ARCHITECTURE.md
reverify: python3 -B docs/audits/native-proxy-populated-controller-20260913/audit.py --verify-saved
