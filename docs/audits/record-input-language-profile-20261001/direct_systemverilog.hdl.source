      phase <= 2'b00;
    end else begin
      phase <= phase_next;
    end
  end

  // Unified Multiplexer for LHS: piece
  // Unified flop with mux for: piece (register_out assignment)
  always_comb begin
    piece_next = piece;  // Default value
    if (piece_packet_payload_flags_item_1_en) begin
      piece_next = packet.payload.flags.item_1;
    end
  end
  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
      piece <= 2'b00;
    end else begin
      piece <= piece_next;
    end
  end

  // Unified Multiplexer for LHS: reset_seen
  // Unified flop with mux for: reset_seen (register_out assignment)
  always_comb begin
    reset_seen_next = reset_seen;  // Default value
    if (reset_seen_held_payload_data_en) begin
      reset_seen_next = held.payload.data;
    end
  end
  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
      reset_seen <= 5'b00000;
    end else begin
      reset_seen <= reset_seen_next;
    end
  end

  // Unified Multiplexer for LHS: stored
  // Unified flop with mux for: stored (register_out assignment)
  always_comb begin
    stored_next = stored;  // Default value
    if (stored_held_payload_data_en) begin
      stored_next = held.payload.data;
    end
  end
  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
      stored <= 5'b00000;
    end else begin
      stored <= stored_next;
    end
  end

  `ifndef SYNTHESIS
  always_comb begin
    assert ($onehot0({next_state_main_done_18_en, next_state_main_idle_0_en, next_state_main_set_1_en, next_state_main_set_11_en, next_state_main_set_12_en, next_state_main_set_13_en, next_state_main_set_14_en, next_state_main_set_15_en, next_state_main_set_16_en, next_state_main_set_17_en, next_state_main_set_2_en, next_state_main_set_6_en, next_state_main_set_7_en, next_state_main_wait_10_en, next_state_main_wait_3_en, next_state_main_wait_4_en, next_state_main_wait_5_en, next_state_main_wait_8_en, next_state_main_wait_9_en})) else $error("selector multi-value conflict: next_state");
    assert ($onehot0({phase_1_en, phase__2_en})) else $error("selector multi-value conflict: phase");
  end
  `endif
endmodule