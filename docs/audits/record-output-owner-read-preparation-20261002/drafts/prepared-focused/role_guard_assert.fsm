(?fsm:worker

  (+types
    (type frame (record (tag (bits 2)) (payload (signed (four_state (bits 3))))))
  )

  (+system
    (clock clk)
    (sreset rst_n active_low)
  )

  (+interface
    (input start)
    (output done)
    (output result)
    (input isf_output_read_packet)
    (internal isf_child_start_seen)
  )

  (+size
    (start 1)
    (done 1)
    (result 3)
    (isf_output_read_packet 3)
    (can_accept 1)
    (isf_child_start_seen 1 (reset 0))
  )

  (+assert
    (worker_assert_0 assert (== isf_output_read_packet isf_output_read_packet) "packet")
  )

  (worker_idle_0
    (-> worker_wait_0 <(& start (! isf_child_start_seen)))
  )

  (worker_wait_0
    (-> worker_when_1)
  )

  (worker_when_1
    (?(> isf_output_read_packet 0)
      (=1 (-> worker_set_2))
      (=0 (-> worker_done_3))
    )
  )

  (worker_set_2
    (<- (result> (+ isf_output_read_packet 1)))
    (-> worker_done_3)
  )

  (worker_done_3
    (<1 (done> 1))
    (-> worker_idle_0)
  )

  (-isf_child_start_seen
    (<- (isf_child_start_seen start))
  )

)
