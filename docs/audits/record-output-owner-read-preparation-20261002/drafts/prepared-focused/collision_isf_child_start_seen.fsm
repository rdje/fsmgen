(?fsm:worker

  (+types
    (type frame (record (tag (bits 2)) (payload (signed (four_state (bits 3))))))
  )

  (+params
    (MODE 0)
  )

  (+system
    (clock clk)
    (sreset rst_n active_low)
  )

  (+interface
    (output ack)
    (output result)
    (input start)
    (output done)
    (input isf_output_read_isf_child_start_seen)
    (internal isf_child_start_seen_activation)
  )

  (+size
    (ack 1)
    (result 3)
    (start 1)
    (done 1)
    (isf_output_read_isf_child_start_seen frame)
    (can_accept 1)
    (isf_child_start_seen_activation 1 (reset 0))
  )

  (worker_idle_0
    (-> worker_set_0 <(& start (! isf_child_start_seen_activation)))
  )

  (worker_set_0
    (<- (result> isf_output_read_isf_child_start_seen.payload))
    (-> worker_done_1)
  )

  (worker_done_1
    (<1 (ack> 1))
    (<1 (done> 1))
    (-> worker_idle_0)
  )

  (-isf_child_start_seen_activation
    (<- (isf_child_start_seen_activation start))
  )

)
