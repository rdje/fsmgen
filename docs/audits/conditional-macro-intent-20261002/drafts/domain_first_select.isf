(actor domain_first_select
  (clock clk) (reset (rst_n sync active_low))
  (interface (input request) (input allow) (input datain (width 3)) (input other (width 3)) (output seen (width 3)) (output done))
  (domains (default idle)
    (domain idle (clock idle_clk) (reset (idle_rst sync active_low)))
    (domain io (clock clk) (reset (rst_n sync active_low))
      (signals request allow datain other seen done) (transactions main)))
  (transaction main (domain io) (select seen allow datain other) (complete done)))
