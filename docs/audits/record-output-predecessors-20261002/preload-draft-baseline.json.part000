rame\"]],\"type_symbols\":{\"local\":{\"alias\":{\"kind\":\"record\",\"member_order\":[\"kind\",\"payload\"],\"members\":{\"kind\":{\"kind\":\"bits\",\"signed\":0,\"width\":2},\"payload\":{\"kind\":\"record\",\"member_order\":[\"data\",\"flags\"],\"members\":{\"data\":{\"kind\":\"bits\",\"signed\":1,\"state_model\":\"four_state\",\"width\":5},\"flags\":{\"items\":[{\"kind\":\"bit\",\"signed\":0,\"width\":1},{\"kind\":\"bits\",\"signed\":0,\"state_model\":\"two_state\",\"width\":2}],\"kind\":\"list\",\"signed\":0,\"width\":3}},\"signed\":0,\"width\":8}},\"signed\":0,\"width\":10}},\"packages\":{\"shared\":{\"frame\":{\"kind\":\"record\",\"member_order\":[\"kind\",\"payload\"],\"members\":{\"kind\":{\"kind\":\"bits\",\"signed\":0,\"width\":2},\"payload\":{\"kind\":\"record\",\"member_order\":[\"data\",\"flags\"],\"members\":{\"data\":{\"kind\":\"bits\",\"signed\":1,\"state_model\":\"four_state\",\"width\":5},\"flags\":{\"items\":[{\"kind\":\"bit\",\"signed\":0,\"width\":1},{\"kind\":\"bits\",\"signed\":0,\"state_model\":\"two_state\",\"width\":2}],\"kind\":\"list\",\"signed\":0,\"width\":3}},\"signed\":0,\"width\":8}},\"signed\":0,\"width\":10}}}},\"uses\":[],\"verification_bridge\":null,\"verification_observations\":[],\"watchdog\":\"65535\"}","carriers":{"imported_alias.fsm":{"exit_code":0,"signal":0,"stderr":"","stdout":"{\n   \"check_schema_version\" : 1,\n   \"command\" : {\n      \"json\" : true,\n      \"mode\" : \"check\",\n      \"strict_mode\" : true,\n      \"target_language\" : \"systemverilog\"\n   },\n   \"diagnostic_summary\" : {\n      \"code_counts\" : {},\n      \"codes\" : [],\n      \"contract_source\" : \"FSM::Support::SerializableDiagnosticSummary\",\n      \"diagnostic_count\" : 0,\n      \"diagnostic_summary_schema_version\" : 1,\n      \"has_diagnostics\" : false,\n      \"has_stable_codes\" : false,\n      \"matched_support_accounting\" : false,\n      \"report_source\" : \"FSM::Support::SerializableDiagnosticSummary\",\n      \"severity_counts\" : {},\n      \"success\" : true,\n      \"unique_codes\" : []\n   },\n   \"diagnostics\" : [],\n   \"generated_output\" : {\n      \"emitted\" : false\n   },\n   \"producer\" : {\n      \"name\" : \"FSMGen\",\n      \"report_source\" : \"FSM::Support::CheckDiagnostics\"\n   },\n   \"result\" : {\n      \"composition_child_count\" : null,\n      \"module_name\" : \"imported_alias\",\n      \"signal_count\" : 11,\n      \"state_count\" : 8\n   },\n   \"source\" : {\n      \"input\" : \"<repo>/.artifacts/tmp/tests/GySupwv_mO/carriers/imported_alias/imported_alias.fsm\",\n      \"resolved_path\" : \"<repo>/.artifacts/tmp/tests/GySupwv_mO/carriers/imported_alias/imported_alias.fsm\"\n   },\n   \"success\" : true,\n   \"support_accounting\" : {\n      \"matched\" : false\n   }\n}\n"}},"facade":{"hdl_code":"//=============================================================================\n// Flattened Decision Tree FSM: imported_alias\n// Generated using Enable-based Methodology with WEN/EN Signals\n// Date: Fri Oct  2 00:44:21 2026\n// \n// This implementation uses:\n// - Flattened decision tree approach\n// - Enable-based logic with assign statements\n// - Write Enable (WEN) and Enable (EN) signals for each LHS\n// - Flat Boolean expressions from DT traversal\n//=============================================================================\n\ntypedef struct packed {\n    logic [1:0] kind;\n    struct packed {\n        logic signed [4:0] data;\n        struct packed {\n            logic item_0;\n            bit [1:0] item_1;\n        } flags;\n    } payload;\n} fsmgen_m14_imported_alias__alias__fsmgen_t; // alias\n\nmodule imported_alias (\n  input  wire clk,\n  input  wire rst_n,\n  input  wire mode,\n  input fsmgen_m14_imported_alias__alias__fsmgen_t packet,\n  input  wire [4:0] scalar,\n  input  wire start,\n  output reg  done,\n  output reg  [4:0] seen,\n  output reg  [2:0] sliced,\n  output reg  [1:0] tag\n);\n\n  // State encoding\n  localparam MAIN_IDLE_0 = 4'd0;\n  localparam MAIN_SET_1 = 4'd1;\n  localparam MAIN_SET_2 = 4'd2;\n  localparam MAIN_WHEN_3 = 4'd3;\n  localparam MAIN_SET_4 = 4'd4;\n  localparam MAIN_WHEN_5 = 4'd5;\n  localparam MAIN_UPDATE_6 = 4'd6;\n  localparam MAIN_DONE_7 = 4'd7;\n\n  // State registers\n  reg [3:0] current_state, next_state;\n\n  // State sequential logic\n  always_ff @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n      current_state <= MAIN_IDLE_0;\n    end else begin\n      current_state <= next_state;\n    end\n  end\n\n  // Internal signal declarations\n  typedef struct packed {\n      logic [1:0] kind;\n      struct packed {\n          logic signed [4:0] data;\n          struct packed {\n              logic item_0;\n              bit [1:0] item_1;\n          } flags;\n      } payload;\n  } fsmgen_m14_imported_alias__shared__frame__fsmgen_t; // shared.frame\n  reg can_accept;\n  fsmgen_m14_imported_alias__shared__frame__fsmgen_t held;\n  // Internal mux helper registers\n  reg done_pulse_delay_pipe;\n  fsmgen_m14_imported_alias__shared__frame__fsmgen_t held_next;\n  reg [4:0] seen_next;\n  reg [2:0] sliced_next;\n  reg [1:0] tag_next;\n  // Generated enable wires\n  wire can_accept_1_en;\n  wire done_1_en;\n  wire held_packet_en;\n  wire main_done_7_done_1_en;\n  wire main_done_7_en;\n  wire main_done_7_next_state_main_idle_0_en;\n  wire main_idle_0_can_accept_1_en;\n  wire main_idle_0_en;\n  wire main_idle_0_next_state_main_set_1_en;\n  wire main_set_1_en;\n  wire main_set_1_held_packet_en;\n  wire main_set_1_next_state_main_set_2_en;\n  wire main_set_2_en;\n  wire main_set_2_next_state_main_when_3_en;\n  wire main_set_2_seen_packet_payload_data_en;\n  wire main_set_4_en;\n  wire main_set_4_next_state_main_when_5_en;\n  wire main_set_4_sliced_packet_payload_data_3_1_en;\n  wire main_update_6_en;\n  wire main_update_6_next_state_main_done_7_en;\n  wire main_update_6_tag_packet_kind_en;\n  wire main_when_3_en;\n  wire main_when_3_next_state_main_set_4_en;\n  wire main_when_3_next_state_main_when_5_en;\n  wire main_when_5_en;\n  wire main_when_5_next_state_main_done_7_en;\n  wire main_when_5_next_state_main_update_6_en;\n  wire next_state_main_done_7_en;\n  wire next_state_main_idle_0_en;\n  wire next_state_main_set_1_en;\n  wire next_state_main_set_2_en;\n  wire next_state_main_set_4_en;\n  wire next_state_main_update_6_en;\n  wire next_state_main_when_3_en;\n  wire next_state_main_when_5_en;\n  wire seen_packet_payload_data_en;\n  wire sliced_packet_payload_data_3_1_en;\n  wire tag_packet_kind_en;\n\n  // State and DT Enable Conditions\n  assign main_done_7_en = current_state == MAIN_DONE_7;\n  assign main_idle_0_en = current_state == MAIN_IDLE_0;\n  assign main_set_1_en = current_state == MAIN_SET_1;\n  assign main_set_2_en = current_state == MAIN_SET_2;\n  assign main_set_4_en = current_state == MAIN_SET_4;\n  assign main_update_6_en = current_state == MAIN_UPDATE_6;\n  assign main_when_3_en = current_state == MAIN_WHEN_3;\n  assign main_when_5_en = current_state == MAIN_WHEN_5;\n\n  // Consolidated intermediate signals (AST factorization + pre-scan)\n  wire [31:0] intermediate_complex_expr_1;\n  wire intermediate_complex_expr_2;\n\n  assign intermediate_complex_expr_1 = 1; // Source: fsmgen_parsing\n  assign intermediate_complex_expr_2 = packet.payload.flags.item_0; // Source: fsmgen_parsing\n\n  // Unified WEN/EN Signal Generation from Phase 1 Analysis\n  // DT-Specific Enable Signals from Unified Analysis\n\n\n  // === DT: main_done_7 ===\n  // done\n  assign main_done_7_done_1_en = main_done_7_en;  // done <- 1\n  // next_state\n  assign main_done_7_next_state_main_idle_0_en = main_done_7_en;  // next_state <- MAIN_IDLE_0\n\n\n  // === DT: main_idle_0 ===\n  // can_accept\n  assign main_idle_0_can_accept_1_en = main_idle_0_en;  // can_accept <- 1\n  // next_state\n  assign main_idle_0_next_state_main_set_1_en = main_idle_0_en & start;  // next_state <- MAIN_SET_1\n\n\n  // === DT: main_set_1 ===\n  // held\n  assign main_set_1_held_packet_en = main_set_1_en;  // held <- packet\n  // next_state\n  assign main_set_1_next_state_main_set_2_en = main_set_1_en;  // next_state <- MAIN_SET_2\n\n\n  // === DT: main_set_2 ===\n  // next_state\n  assign main_set_2_next_state_main_when_3_en = main_set_2_en;  // next_state <- MAIN_WHEN_3\n  // seen\n  assign main_set_2_seen_packet_payload_data_en = main_set_2_en;  // seen <- packet.payload.data\n\n\n  // === DT: main_set_4 ===\n  // next_state\n  assign main_set_4_next_state_main_when_5_en = main_set_4_en;  // next_state <- MAIN_WHEN_5\n  // sliced\n  assign main_set_4_sliced_packet_payload_data_3_1_en = main_set_4_en;  // sliced <- packet.payload.data[3:1]\n\n\n  // === DT: main_update_6 ===\n  // next_state\n  assign main_update_6_next_state_main_done_7_en = main_update_6_en;  // next_state <- MAIN_DONE_7\n  // tag\n  assign main_update_6_tag_packet_kind_en = main_update_6_en;  // tag <- packet.kind\n\n\n  // === DT: main_when_3 ===\n  // next_state\n  assign main_when_3_next_state_main_set_4_en = main_when_3_en & intermediate_complex_expr_1;  // next_state <- MAIN_SET_4\n  assign main_when_3_next_state_main_when_5_en = main_when_3_en & !intermediate_complex_expr_1;  // next_state <- MAIN_WHEN_5\n\n\n  // === DT: main_when_5 ===\n  // next_state\n  assign main_when_5_next_state_main_done_7_en = main_when_5_en & !intermediate_complex_expr_2;  // next_state <- MAIN_DONE_7\n  assign main_when_5_next_state_main_update_6_en = main_when_5_en & intermediate_complex_expr_2;  // next_state <- MAIN_UPDATE_6\n\n  // LHS-Level Enable Signals from Unified Analysis\n\n  // LHS-level enables for: can_accept\n  assign can_accept_1_en = main_idle_0_can_accept_1_en;\n\n  // LHS-level enables for: done\n  assign done_1_en = main_done_7_done_1_en;\n\n  // LHS-level enables for: held\n  assign held_packet_en = main_set_1_held_packet_en;\n\n  // LHS-level enables for: next_state\n  assign next_state_main_done_7_en = main_update_6_next_state_main_done_7_en | main_when_5_next_state_main_done_7_en;\n  assign next_state_main_idle_0_en = main_done_7_next_state_main_idle_0_en;\n  assign next_state_main_set_1_en = main_idle_0_next_state_main_set_1_en;\n  assign next_state_main_set_2_en = main_set_1_next_state_main_set_2_en;\n  assign next_state_main_set_4_en = main_when_3_next_state_main_set_4_en;\n  assign next_state_main_update_6_en = main_when_5_next_state_main_update_6_en;\n  assign next_state_main_when_3_en = main_set_2_next_state_main_when_3_en;\n  assign next_state_main_when_5_en = main_set_4_next_state_main_when_5_en | main_when_3_next_state_main_when_5_en;\n\n  // LHS-level enables for: seen\n  assign seen_packet_payload_data_en = main_set_2_seen_packet_payload_data_en;\n\n  // LHS-level enables for: sliced\n  assign sliced_packet_payload_data_3_1_en = main_set_4_sliced_packet_payload_data_3_1_en;\n\n  // LHS-level enables for: tag\n  assign tag_packet_kind_en = main_update_6_tag_packet_kind_en;\n\n  // Unified Multiplexer Logic from Phase 1 Analysis\n\n  // Unified Multiplexer for LHS: can_accept\n  // Unified combinational mux for: can_accept\n  always_comb begin\n    can_accept = 1'b0;  // Default value\n    if (can_accept_1_en) begin\n      can_accept = 1;\n    end\n  end\n\n  // Unified Multiplexer for LHS: done\n  // Delayed pulse logic for: done (<1, exact Q+1)\n  always_ff @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n      done <= 1'b0;\n      done_pulse_delay_pipe <= 1'b0;\n    end else begin\n      done <= 1'b0;\n      if (done_pulse_delay_pipe) begin\n        done <= 1'b1;\n      end\n      done_pulse_delay_pipe <= done_1_en;\n    end\n  end\n\n  // Unified Multiplexer for LHS: held\n  // Unified flop with mux for: held (register_out assignment)\n  always_comb begin\n    held_next = held;  // Default value\n    if (held_packet_en) begin\n      held_next = packet;\n    end\n  end\n  always_ff @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n      held <= 10'h000;\n    end else begin\n      held <= held_next;\n    end\n  end\n\n  // Unified Multiplexer for LHS: next_state\n  // Unified combinational mux for: next_state\n  always_comb begin\n    next_state = current_state;  // Default value\n    if (next_state_main_done_7_en) begin\n      next_state = MAIN_DONE_7;\n    end\n    if (next_state_main_idle_0_en) begin\n      next_state = MAIN_IDLE_0;\n    end\n    if (next_state_main_set_1_en) begin\n      next_state = MAIN_SET_1;\n    end\n    if (next_state_main_set_2_en) begin\n      next_state = MAIN_SET_2;\n    end\n    if (next_state_main_set_4_en) begin\n      next_state = MAIN_SET_4;\n    end\n    if (next_state_main_update_6_en) begin\n      next_state = MAIN_UPDATE_6;\n    end\n    if (next_state_main_when_3_en) begin\n      next_state = MAIN_WHEN_3;\n    end\n    if (next_state_main_when_5_en) begin\n      next_state = MAIN_WHEN_5;\n    end\n  end\n\n  // Unified Multiplexer for LHS: seen\n  // Unified flop with mux for: seen (register_out assignment)\n  always_comb begin\n    seen_next = seen;  // Default value\n    if (seen_packet_payload_data_en) begin\n      seen_next = packet.payload.data;\n    end\n  end\n  always_ff @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n      seen <= 5'h00;\n    end else begin\n      seen <= seen_next;\n    end\n  end\n\n  // Unified Multiplexer for LHS: sliced\n  // Unified flop with mux for: sliced (register_out assignment)\n  always_comb begin\n    sliced_next = sliced;  // Default value\n    if (sliced_packet_payload_data_3_1_en) begin\n      sliced_next = packet.payload.data[3:1];\n    end\n  end\n  always_ff @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n      sliced <= 3'h0;\n    end else begin\n      sliced <= sliced_next;\n    end\n  end\n\n  // Unified Multiplexer for LHS: tag\n  // Unified flop with mux for: tag (register_out assignment)\n  always_comb begin\n    tag_next = tag;  // Default value\n    if (tag_packet_kind_en) begin\n      tag_next = packet.kind;\n    end\n 