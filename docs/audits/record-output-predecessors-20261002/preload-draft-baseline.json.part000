\n  input fsmgen_m13_formal_shadow__frame__fsmgen_t packet,\n  input  wire [4:0] scalar,\n  input  wire start,\n  output reg  done,\n  output reg  [4:0] seen,\n  output reg  [2:0] sliced,\n  output reg  [1:0] tag\n);\n\n  // State encoding\n  localparam MAIN_IDLE_0 = 2'd0;\n  localparam MAIN_SET_1 = 2'd1;\n  localparam MAIN_DONE_2 = 2'd2;\n\n  // State registers\n  reg [1:0] current_state, next_state;\n\n  // State sequential logic\n  always_ff @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n      current_state <= MAIN_IDLE_0;\n    end else begin\n      current_state <= next_state;\n    end\n  end\n\n  // Internal signal declarations\n  typedef struct packed {\n      logic [1:0] kind;\n      struct packed {\n          logic signed [4:0] data;\n          struct packed {\n              logic item_0;\n              bit [1:0] item_1;\n          } flags;\n      } payload;\n  } fsmgen_m13_formal_shadow__alias__fsmgen_t; // alias\n  reg can_accept;\n  fsmgen_m13_formal_shadow__alias__fsmgen_t held;\n  reg [2:0] isf_port_main_packet;\n  // Internal mux helper registers\n  reg done_pulse_delay_pipe;\n  reg [2:0] sliced_next;\n  // Generated enable wires\n  wire can_accept_1_en;\n  wire done_1_en;\n  wire main_done_2_done_1_en;\n  wire main_done_2_en;\n  wire main_done_2_next_state_main_idle_0_en;\n  wire main_idle_0_can_accept_1_en;\n  wire main_idle_0_en;\n  wire main_idle_0_next_state_main_set_1_en;\n  wire main_set_1_en;\n  wire main_set_1_next_state_main_done_2_en;\n  wire main_set_1_sliced_isf_port_main_packet_2_0_en;\n  wire next_state_main_done_2_en;\n  wire next_state_main_idle_0_en;\n  wire next_state_main_set_1_en;\n  wire sliced_isf_port_main_packet_2_0_en;\n\n  // State and DT Enable Conditions\n  assign main_done_2_en = current_state == MAIN_DONE_2;\n  assign main_idle_0_en = current_state == MAIN_IDLE_0;\n  assign main_set_1_en = current_state == MAIN_SET_1;\n\n  // Unified WEN/EN Signal Generation from Phase 1 Analysis\n  // DT-Specific Enable Signals from Unified Analysis\n\n\n  // === DT: main_done_2 ===\n  // done\n  assign main_done_2_done_1_en = main_done_2_en;  // done <- 1\n  // next_state\n  assign main_done_2_next_state_main_idle_0_en = main_done_2_en;  // next_state <- MAIN_IDLE_0\n\n\n  // === DT: main_idle_0 ===\n  // can_accept\n  assign main_idle_0_can_accept_1_en = main_idle_0_en;  // can_accept <- 1\n  // next_state\n  assign main_idle_0_next_state_main_set_1_en = main_idle_0_en & start;  // next_state <- MAIN_SET_1\n\n\n  // === DT: main_set_1 ===\n  // next_state\n  assign main_set_1_next_state_main_done_2_en = main_set_1_en;  // next_state <- MAIN_DONE_2\n  // sliced\n  assign main_set_1_sliced_isf_port_main_packet_2_0_en = main_set_1_en;  // sliced <- isf_port_main_packet[2:0]\n\n  // LHS-Level Enable Signals from Unified Analysis\n\n  // LHS-level enables for: can_accept\n  assign can_accept_1_en = main_idle_0_can_accept_1_en;\n\n  // LHS-level enables for: done\n  assign done_1_en = main_done_2_done_1_en;\n\n  // LHS-level enables for: next_state\n  assign next_state_main_done_2_en = main_set_1_next_state_main_done_2_en;\n  assign next_state_main_idle_0_en = main_done_2_next_state_main_idle_0_en;\n  assign next_state_main_set_1_en = main_idle_0_next_state_main_set_1_en;\n\n  // LHS-level enables for: sliced\n  assign sliced_isf_port_main_packet_2_0_en = main_set_1_sliced_isf_port_main_packet_2_0_en;\n\n  // Unified Multiplexer Logic from Phase 1 Analysis\n\n  // Unified Multiplexer for LHS: can_accept\n  // Unified combinational mux for: can_accept\n  always_comb begin\n    can_accept = 1'b0;  // Default value\n    if (can_accept_1_en) begin\n      can_accept = 1;\n    end\n  end\n\n  // Unified Multiplexer for LHS: done\n  // Delayed pulse logic for: done (<1, exact Q+1)\n  always_ff @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n      done <= 1'b0;\n      done_pulse_delay_pipe <= 1'b0;\n    end else begin\n      done <= 1'b0;\n      if (done_pulse_delay_pipe) begin\n        done <= 1'b1;\n      end\n      done_pulse_delay_pipe <= done_1_en;\n    end\n  end\n\n  // Unified Multiplexer for LHS: next_state\n  // Unified combinational mux for: next_state\n  always_comb begin\n    next_state = current_state;  // Default value\n    if (next_state_main_done_2_en) begin\n      next_state = MAIN_DONE_2;\n    end\n    if (next_state_main_idle_0_en) begin\n      next_state = MAIN_IDLE_0;\n    end\n    if (next_state_main_set_1_en) begin\n      next_state = MAIN_SET_1;\n    end\n  end\n\n  // Unified Multiplexer for LHS: sliced\n  // Unified flop with mux for: sliced (register_out assignment)\n  always_comb begin\n    sliced_next = sliced;  // Default value\n    if (sliced_isf_port_main_packet_2_0_en) begin\n      sliced_next = isf_port_main_packet[2:0];\n    end\n  end\n  always_ff @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n      sliced <= 3'h0;\n    end else begin\n      sliced <= sliced_next;\n    end\n  end\n\n  `ifndef SYNTHESIS\n  always_comb begin\n    assert ($onehot0({next_state_main_done_2_en, next_state_main_idle_0_en, next_state_main_set_1_en})) else $error(\"selector multi-value conflict: next_state\");\n  end\n  `endif\nendmodule","result_keys":["fsm_module","hdl_code","intent_hir","lowered_rtl_ir","module_info","raw_ast","resolved_package_imports","source_info","statistics","structural_rtl_ir"],"source_info":{"generated_hdl_entry_artifact":"formal_shadow.fsm","header":"?fsm:formal_shadow","kind":"isf","package_import_count":0,"package_import_names":[],"public_source_path":"<repo>/.artifacts/tmp/tests/GySupwv_mO/formal_shadow.isf"}},"generation":{"exit_code":0,"signal":0,"stderr":"","stdout":"=== ISF Intent Scheduling ===\n\nActor: formal_shadow\n"},"hdl":"//=============================================================================\n// Flattened Decision Tree FSM: formal_shadow\n// Generated using Enable-based Methodology with WEN/EN Signals\n// Date: Fri Oct  2 00:44:33 2026\n// \n// This implementation u