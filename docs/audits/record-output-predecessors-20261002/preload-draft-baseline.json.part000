"start\",\"width\":1},{\"name\":\"packet\",\"type\":\"alias\",\"type_spec\":{\"kind\":\"record\",\"member_order\":[\"kind\",\"payload\"],\"members\":{\"kind\":{\"kind\":\"bits\",\"signed\":0,\"width\":2},\"payload\":{\"kind\":\"record\",\"member_order\":[\"data\",\"flags\"],\"members\":{\"data\":{\"kind\":\"bits\",\"signed\":1,\"state_model\":\"four_state\",\"width\":5},\"flags\":{\"items\":[{\"kind\":\"bit\",\"signed\":0,\"width\":1},{\"kind\":\"bits\",\"signed\":0,\"state_model\":\"two_state\",\"width\":2}],\"kind\":\"list\",\"signed\":0,\"width\":3}},\"signed\":0,\"width\":8}},\"signed\":0,\"width\":10},\"width\":10},{\"name\":\"scalar\",\"width\":\"5\"},{\"name\":\"mode\",\"width\":1}],\"outputs\":[{\"name\":\"done\",\"width\":1},{\"name\":\"seen\",\"width\":\"5\"},{\"name\":\"sliced\",\"width\":\"3\"},{\"name\":\"tag\",\"width\":\"2\"}]},\"interface_port_metadata\":[{\"direction\":\"input\",\"name\":\"start\",\"width\":1},{\"direction\":\"input\",\"fields\":[{\"lsb\":8,\"msb\":9,\"path\":\"kind\",\"signed\":0,\"width\":2},{\"lsb\":3,\"msb\":7,\"path\":\"payload.data\",\"signed\":1,\"state_model\":\"four_state\",\"width\":5},{\"lsb\":2,\"msb\":2,\"path\":\"payload.flags[0]\",\"signed\":0,\"width\":1},{\"lsb\":0,\"msb\":1,\"path\":\"payload.flags[1]\",\"signed\":0,\"state_model\":\"two_state\",\"width\":2}],\"name\":\"packet\",\"type\":\"alias\",\"type_kind\":\"record\",\"width\":10},{\"direction\":\"input\",\"name\":\"scalar\",\"width\":5},{\"direction\":\"input\",\"name\":\"mode\",\"width\":1},{\"direction\":\"output\",\"name\":\"done\",\"width\":1},{\"direction\":\"output\",\"name\":\"seen\",\"width\":5},{\"direction\":\"output\",\"name\":\"sliced\",\"width\":3},{\"direction\":\"output\",\"name\":\"tag\",\"width\":2}],\"library_uses\":[],\"package_imports\":[\"shared\"],\"package_roots\":[[\"?pkg:shared\",[\"+types\",[\"type\",\"frame\",[\"record\",[\"kind\",[\"bits\",\"2\"]],[\"payload\",[\"record\",[\"data\",[\"signed\",[\"four_state\",[\"bits\",\"5\"]]]],[\