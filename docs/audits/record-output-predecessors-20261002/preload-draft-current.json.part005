enables for: result\n  assign result_packet_payload_data_en = reader_set_2_result_packet_payload_data_en;\n\n  // Unified Multiplexer Logic from Phase 1 Analysis\n\n  // Unified Multiplexer for LHS: done\n  // Delayed pulse logic for: done (<1, exact Q+1)\n  always_ff @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n      done <= 1'b0;\n      done_pulse_delay_pipe <= 1'b0;\n    end else begin\n      done <= 1'b0;\n      if (done_pulse_delay_pipe) begin\n        done <= 1'b1;\n      end\n      done_pulse_delay_pipe <= done_1_en;\n    end\n  end\n\n  // Unified Multiplexer for LHS: is_negative\n  // Unified flop with mux for: is_negative (register_out assignment)\n  always_comb begin\n    is_negative_next = is_negative;  // Default value\n    if (is_negative_expr_en) begin\n      is_negative_next = packet.payload.data < 0;\n    end\n  end\n  always_ff @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n      is_negative <= 1'b0;\n    end else begin\n      is_negative <= is_negative_next;\n    end\n  end\n\n  // Unified Multiplexer for LHS: isf_child_start_seen\n  // Unified flop with mux for: isf_child_start_seen (register_out assignment)\n  always_comb begin\n    isf_child_start_seen_next = isf_child_start_seen;  // Default value\n    if (isf_child_start_seen_start_en) begin\n      isf_child_start_seen_next = start;\n    end\n  end\n  always_ff @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n      isf_child_start_seen <= 0;\n    end else begin\n      isf_child_start_seen <= isf_child_start_seen_next;\n    end\n  end\n\n  // Unified Multiplexer for LHS: next_state\n  // Unified combinational mux for: next_state\n  always_comb begin\n    next_state = current_state;  // Default value\n    if (next_state_reader_done_4_en) begin\n      next_state = READER_DONE_4;\n    end\n    if (next_state_reader_idle_0_en) begin\n      next_state = READER_IDLE_0;\n    end\n    if (next_state_reader_set_2_en) begin\n      next_state = READER_SET_2;\n