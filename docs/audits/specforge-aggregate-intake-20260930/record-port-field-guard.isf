(actor link_rx
  (clock clk)
  (reset (rst_n async active_low))
  (types
    (type lmp_t (record (subtype (bits 4)) (payload (bits 12)))))
  (interface
    (input start)
    (input lmp_in (type lmp_t))
    (output done)
    (output u2_timeout_seen))
  (transaction receive
    (on start)
    (when (== lmp_in.subtype 1)
      (set u2_timeout_seen 1))
    (complete done)))
