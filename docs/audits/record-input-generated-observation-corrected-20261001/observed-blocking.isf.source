(actor packed_input_generated_blocking
 (clock clk) (reset (rst_n async active_low))
 (types (type frame (record (tag (bits 2))
  (payload (record (data (signed (four_state (bits 5))))
   (flags (list (two_state bit) (two_state (bits 2)))))))))
 (interface
  (input start) (input packet (type frame)) (input unused (type frame))
  (output phase (width 2) (reset 0))
  (output seen (width 5) (reset 0)) (output again (width 5) (reset 0))
  (output negative_seen (reset 0)) (output negative_again (reset 0))
  (output copy_seen (width 5) (reset 0))
  (output stored (width 5) (reset 0)) (output copied_tag (width 2) (reset 0))
  (output stored_flag (reset 0))
  (output stored_piece (width 2) (reset 0))
  (output captured (width 5) (reset 0)) (output reset_seen (width 5) (reset 0))
  (output done (reset 0)))
 (storage (var held (type frame) (reset 149)))
 (transaction copier (params (MODE 0))
  (ports (output result (width 5)))
  (wait 2) (set held packet) (set result packet.payload.data) (complete done))
 (transaction reader
  (ports (output result (width 5)) (output is_negative))
  (wait 2) (set result packet.payload.data)
  (set is_negative (< packet.payload.data 0)) (complete done))
 (transaction main
  (on start (sample packet.payload.data as accepted))
  (set reset_seen held.payload.data)
  (set phase 1) (wait 3)
  (do copier (params (MODE 1)) (bind (output result copy_seen)))
  (set phase 2) (wait 3)
  (spawn reader as left (bind (output result seen) (output is_negative negative_seen)))
  (spawn reader as right (bind (output result again) (output is_negative negative_again)))
  (await_all done)
  (set stored held.payload.data) (set copied_tag held.tag)
  (set stored_flag held.payload.flags[0]) (set stored_piece held.payload.flags[1])
  (set captured accepted) (complete done)))
