(?define:generic_fifo

  (?fsm:[FIFO_NAME]

     (+system (clock  [CLOCK]) (asreset [RESETN]))
     (+size   ([DATAIN] [WIDTH]))
     
     (-rw_ctrl
       (<(& ![WRITE] [READ] [VALID])
         (++ rdpt)
         (-- cnt)
         ([FULL]> <- 0)
         ([VALID] <- 0 <cnt=[?size: MAX_COUNT]'x1)
       )
     
       (<(& [WRITE] ![FULL])
         (?repeat:[MAX_COUNT]  (z\CI <- [DATAIN] <wrpt=[?size: MAX_COUNT -1]'\CI))
     
         (++ wrpt)
     
         (?[READ]
           (=0  (++ cnt) ([VALID] <- 1) ([FULL] <- 1 <cnt=[?size: MAX_COUNT]'[MAX_COUNT-1]))
           (=1  (?[VALID] (=1  (++ rdpt)) 
     		          (=0  (++ cnt) ([VALID]> <- 1) ([FULL] <- 1 <cnt=[?size: MAX_COUNT]'[MAX_COUNT-1]))))
         )
       )
     
       (?repeat:[MAX_COUNT] ([DATAOUT] = z\CI <rdpt=[?size: MAX_COUNT -1]'\CI))
     )
  )
)



(?top:foo

  aaaaaaaa_bbbbbbbbbbb
  frm_Acri_busy>12
  frm_applied_cri>4

  (?&generic_fifo FIFO_NAME=myfifo0
                  CLOCK=myclock
                  RESETN=myresetn
                  DATAIN=mydatain
                  DATAOUT=mydataout
                  WIDTH=32
                  WRITE=mywrite
                  READ=myread
                  VALID=myvalid
                  FULL=myfull
                  MAX_COUNT=40)

