(?fsm:mipicsi2_tester_ctrl

  (+system (clock  clk) (asreset rstn))
  (+size (ca  32) (cdo 32))
  
  (s0 (cnt <- cnt_wait) (-> s1))
  (s1 (?cnt (!=8'x0 (-- cnt))
            (=8'x0  (-> c0))
    )
  )
  
  (c0  (cv  = 1) (cwr = 1) (ca = tlpx             ) (-> c1 ))
  (c1  (cv  = 1) (cwr = 1) (ca = hs_sync_sequence ) (-> c2 )) 
  (c2  (cv  = 1) (cwr = 1) (ca = esc_enter        ) (-> c3 )) 
  (c3  (cv  = 1) (cwr = 1) (ca = esc_entry_cmd    ) (-> c4 )) 
  (c4  (cv  = 1) (cwr = 1) (ca = lpdt_cmd         ) (-> c5 )) 
  (c5  (cv  = 1) (cwr = 1) (ca = ulp_cmd          ) (-> c6 )) 
  (c6  (cv  = 1) (cwr = 1) (ca = trig_reset_cmd   ) (-> c7 )) 
  (c7  (cv  = 1) (cwr = 1) (ca = tx_marker        ) (-> c8 )) 
  (c8  (cv  = 1) (cwr = 1) (ca = ulpm_timer       ) (-> c9 )) 
  (c9  (cv  = 1) (cwr = 1) (ca = ulpm_timer_enable) (-> c10)) 
  (c10 (cv  = 1) (cwr = 1) (ca = ulpm_exit        ) (-> c11)) 
  (c11 (cv  = 1) (cwr = 1) (ca = lpdt_ffwen       ) (-> c12)) 
  (c12 (cv  = 1) (cwr = 1) (ca = lpdt_ffdata      ) (-> c13)) 
  (c13 (cv  = 1) (cwr = 1) (ca = tlpx             ) (-> c14)) 
  (c14 (cv  = 1) (cwr = 1) (ca = ths_prepare      ) (-> c15)) 
  (c15 (cv  = 1) (cwr = 1) (ca = ths_zero         ) (-> c16)) 
  (c16 (cv  = 1) (cwr = 1) (ca = ths_trail        ) (-> c17)) 
  (c17 (cv  = 1) (cwr = 1) (ca = ths_exit         ) (-> c18)) 
  (c18 (cv  = 1) (cwr = 1) (ca = twakeup          ) (-> c19)) 
  (c19 (cv  = 1) (cwr = 1) (ca = tclk_zero        ) (-> c20)) 
  (c20 (cv  = 1) (cwr = 1) (ca = tclk_trail       ) (-> c21)) 
  (c21 (cv  = 1) (cwr = 1) (ca = tclk_settle      ) (-> c22)) 
  (c22 (cv  = 1) (cwr = 1) (ca = tclk_post        ) (-> c23)) 
  (c23 (cv  = 1) (cwr = 1) (ca = tester_start     ) (-> c24)) 
  (c24 (cv  = 1) (cwr = 1) (ca = tester_done      ) (-> c25)) 
  (c25 (cv  = 1) (cwr = 1) (ca = tester_reset     ) (-> c26)) 
  (c26 (cv  = 1) (cwr = 1) (ca = stream_type      ) (-> c27)) 
  (c27 (cv  = 1) (cwr = 1) (ca = both_lanes       ) (-> c28)) 
  (c28 (cv  = 1) (cwr = 1) (ca = default_lane     ) (-> c29)) 
  (c29 (cv  = 1) (cwr = 1) (ca = line_blanking    ) (-> c30)) 
  (c30 (cv  = 1) (cwr = 1) (ca = frame_blanking   ) (-> c31)) 
  (c31 (cv  = 1) (cwr = 1) (ca = bs_packet_len    ) (-> c32)) 
  (c32 (cv  = 1) (cwr = 1) (ca = clock_ratio      ) (-> c33)) 
  (c33 (cv  = 1) (cwr = 1) (ca = ulpm_enter       ) (-> c34)) 
  (c34 (cv  = 1) (cwr = 1) (ca = clk_ulpm_exit    ) (-> c35)) 
  (c35 (cv  = 0))
)
