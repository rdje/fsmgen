 (?rtl:lte_dif_stream_adapter_m_le_n  :rxdu_pack_8to16
   -m_imax_g=8                             ; # -- Max input  stream bit-width (M)
   -m_imin_g=8                             ; # -- Min input  stream bit-width (M)
   -n_omax_g=16                            ; # -- Max output stream bit-width (N)
   -n_omin_g=16                            ; # -- Min output stream bit-width (N)
