   /incen/incen/            ; # IN  STD_LOGIC;
   /incr_k/incr/            ; # IN  STD_LOGIC_VECTOR(dw_g-1 DOWNTO 0);
   /mod_m/buf_sz/           ; # IN  STD_LOGIC_VECTOR(dw_g-1 DOWNTO 0);
   /counter_o/zb_cur_addr/  ; # OUT STD_LOGIC_VECTOR(dw_g-1 DOWNTO 0);
   /wrap_o/wrap_on/         ; # OUT STD_LOGIC
 )
)


