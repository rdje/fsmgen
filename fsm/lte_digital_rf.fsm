    -rt_ssibw_g=6                      ; # -- Runtime stream size indicators bit-width (m)

    /m_iss/6'32/                       ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /n_oss/6'8/                        ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /i_data/rfcu_pl_i_data/            ; # IN  STD_LOGIC_VECTOR (m_imax_g-1 DOWNTO 0);
    /i_valid/rfcu_pl_i_valid/          ; # IN  STD_LOGIC;
    /i_last/0b0/                       ; # IN  STD_LOGIC;
    /i_next_o/rfcu_pl_i_next_o/        ; # OUT STD_LOGIC;
    /o_data/unpack32_o_data/           ; # OUT STD_LOGIC_VECTOR (n_omax_g-1 DOWNTO 0);
    /o_valid/unpack32_o_valid/         ; # OUT STD_LOGIC;
    /o_last/open/                      ; # OUT STD_LOGIC;
    /o_stall_i/rfcu_unpack_fifo_full/  ; # IN  STD_LOGIC
  )

  (?rtl:lte_dif_gfifo  -wc_g=48  -aw_g=6  -dw_g=8
    /wr/unpack32_o_valid/
    /wdata/unpack32_o_data/
    /rd$/rfcu_pl_o_next_i/
    /rdata/rfcu_pl_o_data/
    /^full/rfcu_unpack_fifo_full/
    /valid/rfcu_pl_o_valid/
    /^empty/open/
    /a_full$/open/
    /a_empty$/open/
    /thres/6'0/
  )

)

