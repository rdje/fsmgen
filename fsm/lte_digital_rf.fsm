   /lcm_end_addr/ppimon_end_addr/
   /lcm_cur_addr/ppimon_cur_addr/
 )
)


(?fsm:lte_dif_rxif_fe
 (+size
  (rx_coderror 3)
  (sof_kcode   8)
  (eof_kcode   8)
  (eot_kcode   8)
  (rx_code     8)
 )

 (idle (<s_rst_n
   (<is_sof (rxif_valid = 1)
            (-> eox)
   )
  )
 )

 (eox (<s_rst_n
   (rxif_valid = 1)
   (rxif_last  = 1 <is_eox)  ; # Which means that frames will always start on a 4B boundary (MSB-aligned)

   (-> idle   <is_eox)
   (-> enest  <is_sof)
  )
 )

 (enest (<s_rst_n
   (rxif_valid = 1)
   (-> eox  <is_eof)
  )
 )

 (-misc
  (is_sof   = 1 <(& rx_kcode rx_code=sof_kcode rx_coderror=3'0))
  (is_eof   = 1 <(& rx_kcode rx_code=eof_kcode rx_coderror=3'0))
  (is_eot   = 1 <(& rx_kcode rx_code=eot_kcode rx_coderror=3'0))
  (is_eox   = 1 <(| is_eof is_eot))
 )

 (-sr (<!s_rst_n
   (-> idle)
  )
 )
)

(?top:lte_dif_rxif
  +cclausearch=specific_context_clause#lte_digital_rf_lib.drf_lfsr_pkg#lte_digital_rf_lib.drf_bert_pkg

  (?top:lte_dif_rxif_isctrl
    clk
    rst_n
    s_rst_n

    rxif_idle_symbol>8
    rxif_idle_valid>=0b0

    rxif_valid>    +beginarch=assign_add#rxif_valid:l_rxif_valid
    rxif_data>13
    rxif_last>

    rx_code<8
    rx_kcode
    rx_coderror<3
    rx_phymon<8
    rx_phyevt<3

    +beginarch=assign_add#{rxif_data(7 DOWNTO 0):rx_code}
    +beginarch=assign_add#{rxif_data(8):rx_kcode}
    +beginarch=assign_add#{rxif_data(11 DOWNTO 9):rx_coderror}
    +beginarch=assign_add#{rxif_data(12):l_rxif_valid}

    +endtop=move_port_2signal#l_rxif_valid   +declarch=decl_signal_from_port
    (?fsmc: lte_dif_rxif_fe  /rxif_valid/l_rxif_valid/)
  )

  (?rtl:lte_dif_stream_adapter_m_le_n  :rxif_pack_13to52
    -m_imax_g=13                   ; # -- Max input  stream bit-width (M)
    -m_imin_g=13                   ; # -- Min input  stream bit-width (M)
    -n_omax_g=52                   ; # -- Max output stream bit-width (N)
    -n_omin_g=52                   ; # -- Min output stream bit-width (N)
    -msb_2lsb_g=0                  ; # -- 1= Enables MSB to LSB translation 0= Disables it
    -rt_ssibw_g=6                  ; # -- Runtime stream size indicators bit-width (m)

    /m_iss/6'13/                   ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /n_oss/6'52/                   ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /i_data/rxif_data/             ; # IN  STD_LOGIC_VECTOR (m_imax_g-1 DOWNTO 0);
    /i_valid/rxif_valid/           ; # IN  STD_LOGIC;
    /i_last/rxif_last/             ; # IN  STD_LOGIC;
    /i_next_o/open/                ; # OUT STD_LOGIC;
    /o_data/rxif_fifo_wdata/       ; # OUT STD_LOGIC_VECTOR (n_omax_g-1 DOWNTO 0);
    /o_valid/rxif_fifo_wr/         ; # OUT STD_LOGIC;
    /o_last/open/                  ; # OUT STD_LOGIC;
    /o_stall_i/rxif_fifo_full/     ; # IN  STD_LOGIC
  )

  (?rtl:drf_bert
   /loop_test/ber_loop_test_en/               ; LEVEL  #  IN  STD_LOGIC;                                     -- Enable internal test loop
   /data_in/ber_load_value/                   ; 32b    #  IN  STD_LOGIC_VECTOR ((data_with_c-1) DOWNTO 0);   -- Data input for Loadable Start value
   /gen_load/ber_gen_load_en/                 ; PULSE  #  IN  STD_LOGIC;                                     -- Load Generator Start value (data_in)
   /gen_enable/ber_generator_en/              ; LEVEL  #  IN  STD_LOGIC;                                     -- Enable Generator
   /gen_lfsr_out/open/                        ;        #  OUT STD_LOGIC_VECTOR ((lfsr_with_c-1) DOWNTO 0);   -- Generator LFSR Data Out
   /gen_symbol_out/open/                      ;        #  OUT STD_LOGIC_VECTOR ((symbol_with_c-1) DOWNTO 0); -- Generator Symbol out (Byte parallel)
   /rec_enable/ber_receiver_en/               ; LEVEL  #  IN  STD_LOGIC;                                     -- Enable Receiver
   /rec_symbol_in/rxif_idle_symbol/           ;        #  IN  STD_LOGIC_VECTOR ((symbol_with_c-1) DOWNTO 0); -- Receiver Input (Byte parallel)
   /rec_sym_valid_in/rxif_idle_valid/         ;        #  IN  STD_LOGIC;                                     -- Valid Symbol
   /rec_force_sync_in/ber_recv_force_sync_en/ ; PULSE  #  IN  STD_LOGIC;                                     -- Receiver Force Synchronisation after beeing '1'
   /rec_lfsr_out/open/                        ;        #  OUT STD_LOGIC_VECTOR ((lfsr_with_c-1) DOWNTO 0);   -- Receiver LFSR Data Out
   /rec_symbol_out/open/                      ;        #  OUT STD_LOGIC_VECTOR ((symbol_with_c-1) DOWNTO 0); -- Receiver Symbol out (Byte parallel)
   /rec_sync_out/ber_recv_synchronized/       ; SLOW   #  OUT STD_LOGIC;                                     -- Receiver synchronized
   /rec_error_out/ber_recv_error/             ; FAST   #  OUT STD_LOGIC;                                     -- Receiver Error
   /rec_ser_error_out/open/                   ;        #  OUT STD_LOGIC;                                     -- Receiver Error signal (serial) / result out
   /ber_cntr_load_in/ber_counter_load_en/     ; PULSE  #  IN STD_LOGIC;                                      -- Preload BER-counter (data_in)
   /ber_cntr_reset_in/ber_counter_rst_en/     ; PULSE  #  IN STD_LOGIC;                                      -- Reset BER-counter
   /ber_cntr_out/ber_counter/                 ; FAST   #  OUT STD_LOGIC_VECTOR ((ber_with_c-1) DOWNTO 0);    -- BER-Counter output
   /ber_overfl_out/ber_overflow/              ; SLOW   #  OUT STD_LOGIC                                      -- BER Overflow output
  )

)

