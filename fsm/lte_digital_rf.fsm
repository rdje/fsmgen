; # retx_brq
; # retx_req
; # retx_rq_id
; # retx_frm_type
; # retx_frm_lcid<3
; # retx_ack>                         (f)
; # retx_frzmask>                     (f)
; # retx_b2b_n>                       (f)
; # retx_dis>                         (c)
; # retx_start_addr_en>               (c)
; # retx_next_addr_en>                (c)
; # retx_header_en>                   (c)
; # retx_lcid>3                       (c)
; # retx_lcindic>                     (c)
; # blind_retx_cri_en>                (c)
; # norm_retx_cri_en>                 (c)
; # retx_pl_en>                       (c)
; # retx_frm_info_rd>                 (c)
