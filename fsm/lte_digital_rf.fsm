(?top:lte_dif_cmi_addgen  ; # aw_g
 clk
 rst_n
 s_rst_n

 start_addr<20
 end_addr<20
 cur_addr>20
 length<20

 incr<20
 incen
 wrap_on>

 start_2end>20
 +endtop=move_port_2signal#buf_sz#start_2end#zb_cur_addr  +declarch=decl_signal_from_port
 +beginarch=assign_add#{start_2end:end_addr - start_addr}
 +beginarch=assign_add#"buf_sz:length  WHEN length /= (length'RANGE=> '0')  ELSE  start_2end"
 +beginarch=assign_add#{cur_addr:start_addr + zb_cur_addr}

