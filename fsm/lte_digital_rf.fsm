; #  clk
; #  rst_n
; #  s_rst_n
; #
; #  ppi_data<13
; #
; #  ppi_fifo_full
; #  ppi_fifo_wr>
; #  ppi_fifo_wdata>52
; # )


(?top:lte_dif_rxmerge
  clk
  fast_clk
  rst_n
  s_rst_n

  rx_default_lane
  dual_rxlane_on

  rxif_1_valid
  rxif_1_coderror<3
  rxif_1_kcode
  rxif_1_data<8

  ; # FIXME FIXME FIXME FIXME FIXME FIXME TEMPORARY until rxjoin is fully implemented
  rxif_1_rd>   +beginarch=assign_add#{rxif_1_rd:rxif_1_valid AND NOT rx_default_lane AND NOT dual_rxlane_on}
                   
  rxif_2_valid
  rxif_2_coderror<3
  rxif_2_kcode
  rxif_2_data<8

  ; # FIXME FIXME FIXME FIXME FIXME FIXME TEMPORARY until rxjoin is fully implemented
  rxif_2_rd>   +beginarch=assign_add#{rxif_2_rd:rxif_2_valid AND rx_default_lane AND NOT dual_rxlane_on}
              
  ; # FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME
  ; # FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME
  ; # 
  ; # All of the assignment below are VERY TEMPORARY until rxjoin is completed	       
  ; # 
  ; # FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME
  ; # FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME
  rx_m_valid>      +beginarch=assign_add#{rx_m_valid:rxif_1_valid WHEN rx_default_lane = '0' ELSE rxif_2_valid}
  rx_m_coderror>3  +beginarch=assign_add#{rx_m_coderror:rxif_1_coderror WHEN rx_default_lane = '0' ELSE rxif_2_coderror}
  rx_m_kcode>      +beginarch=assign_add#{rx_m_kcode:rxif_1_kcode WHEN rx_default_lane = '0' ELSE rxif_2_kcode}
  rx_m_data>8      +beginarch=assign_add#{rx_m_data:rxif_1_data WHEN rx_default_lane = '0' ELSE rxif_2_data}
  

 ; # +beginarch=assign_add#{rx_m_data:rxif_1_data  WHEN  channel_sel = '0'  ELSE rxif_2_data}

 ; # channel_sel>    +beginarch=assign_add#{channel_sel:rx_default_lane WHEN dual_rxlane_on = '0' ELSE lane_sel}
 ; # l_s_rst_n>  +beginarch=assign_add#{l_s_rst_n:s_rst_n AND dual_rxlane_on}
 ; # +endtop=move_port_2signal#l_s_rst_n#_sel declarch=decl_signal_from_port
 (?top:lte_dif_rxjoin  clk   rst_n  s_rst_n)

 ; # (?fsmc: lte_dif_rxjoin /s_rst_n/l_s_rst_n/)
)

