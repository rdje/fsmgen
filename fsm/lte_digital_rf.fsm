(?fsm:lte_dif_txshift
 (idle (<s_rst_n
   (load_en = 1)
   (-> ack)
  )
 )

 (ack (<s_rst_n
   (<tx_burst_ack
    (shift_en = 1)
    (-> shift)
   )
  )
 )

 (shift (<s_rst_n
   (shift_en = 1)
   (-> ack)
  )
 )

 (-sr (<!s_rst_n
   (-> idle)
  )
 )
)

; # tas_rq
; # tas_latency_minus_1<8
; # tas_ack
; # burst_on
; # tas_rq_adjust>
; # tas_keep_burst_open>
(?fsm:lte_dif_tas_rq_adjust
 (idle (<s_rst_n
   (<tas_rq
    (?burst_on
     (=0 (tas_rq_delayed <= 1)
         (-> wait_4ack)
     )

     (=1 (counter'8 <- tas_latency_minus_1)
         (tas_keep_burst_open <= 1)
         (-> wait_4cnt)
     )
    )
   )
  )
 )

 (wait_4cnt (<s_rst_n
   (?counter
    (!=8'0 (-- counter))
    ( =8'0 (tas_rq_delayed      <= 1)
           (tas_keep_burst_open <= 0)
           (-> wait_4ack) 
    )
   )
  )
 )

 (wait_4ack (<s_rst_n
   (<tas_ack (tas_rq_delayed <= 0)
             (-> idle)
   )
  )
 )


 (-syncrst  (<!s_rst_n
   (counter       <- 8'0)
   (-> idle)
  )
 )
)



; # kcode_en
; # kcode<8
; # burst_on>
(?fsm:lte_dif_burst_on
 (+size
  (sof_kcode  8)
  (eot_kcode  8)
 )

 (idle (<s_rst_n
   (<kcode_en
    (<kcode=sof_kcode (burst_on <- 1)
                      (-> bclose)
    )
     
   )
  )
 )

 (bclose (<s_rst_n
   (<kcode_en
    (<kcode=eot_kcode (burst_on <- 0)
                      (-> idle)
    ) 
   )
  )
 )
 
 (-syncrst (<!s_rst_n
   (burst_on <- 0)
   (-> idle)
  )
 )
)



; # -----------------------------------------
; #              TXIF sequencers
; # -----------------------------------------

; # -----------------------------
; #            SHARED
; # -----------------------------
; # frm_info_wr>
; # tx_lcid>3
; # tx_lcindic>
; # tx_drive_header_en>
; # frm_kcode>8
; # tx_drive_kcode_en> 
; # tx_cri_incen>
; # tx_burst_req>
; # -----------------------------
; #
; # -----------------------------
; #          SPECIFIC 
; # -----------------------------
; # tas_ack>
; # tas_dis>
; # tas_b2b_n>
; # tas_pl_en>
; # tas_pl_o>8
(?fsm:lte_dif_taslc
 (init  (<s_rst_n
   (<tas_ena
     (tas_pl_buf'8  <- tas_pl_i)
     (tas_ack <- 1)

     (tas_tgl <- 1)
     (?tas_brq
       (=1 (tx_burst_req <- 1)
           (-> wait_4burst_ack)
       )

      (=0 (tas_sof_en = 1))
     )
   )
  )
 )

 (wait_4burst_ack  (<s_rst_n
   (<tx_burst_ack
    (tx_burst_req     <- 0)

    (frm_kcode'8       = sof_kcode)
    (tx_drive_kcode_en = 1)

    (-> drv_header)
   )
  )
 )

 (drv_sof (<s_rst_n
   (tas_sof_en = 1)
  )
 )

 (-drv_sof_c  (<tas_sof_en
   (frm_kcode'8       = sof_kcode)
   (tx_drive_kcode_en = 1)

   (-> drv_header)
  )
 )

 (drv_header  (<s_rst_n
   (frm_info_wr        = 1)
   (tx_lcid'3          = tx_taslc_id_code)
   (tx_lcindic         = 0)
   (tx_drive_header_en = 1)
   (tx_cri_incen       = 1)

   (-> drv_pl)
  )
 )

 (drv_pl  (<s_rst_n
   (tas_pl_en = 1) 
   (tas_pl_o  = tas_pl_buf)

   ; # (tas_b2b_n <- 0 <!tas_tgl)
   (-> eox)
  )
 )

 (eox  (<s_rst_n
    (tx_drive_kcode_en = 1)
    
    (?tas_tgl
      (=1  (tas_tgl <- 0)
           (frm_kcode'8  = eof_kcode)
	   (-> drv_sof)
      )

      (=0 (?tas_req 
            (=1 (frm_kcode'8    = eof_kcode)
                (tas_pl_buf'8  <- tas_pl_i)
                (tas_ack       <- 1)
                (tas_tgl  <- 1)
                (-> drv_sof)   
            )

            (=0 (<( | any_req nesting_on) (frm_kcode'8 = eof_kcode)
	                                  (tas_b2b_n  <- 0 <!nesting_on)
		)
                
		(frm_kcode'8 = eot_kcode <(!| any_req nesting_on))
                (tas_dis     = 1)
                (-> init)
            ) 
          )
      )
    )
    
  )
 )


 (-misc (<s_rst_n
   (tas_ack>   <- 0  <tas_ack)
   (tas_b2b_n> <- 1 <!tas_b2b_n)
  )
 )

 (-syncrst (<!s_rst_n
   (tas_ack   <- 0)
   (tas_b2b_n <- 1)
   (tas_tgl       <- 0)
   (-> init)
  )
 )

)


; # -----------------------------
; #            SHARED
; # -----------------------------
; # frm_info_wr>
; # retx_buf_wr> (except TAS/RETX)
; # tx_lcid>3
; # tx_lcindic>
; # tx_drive_header_en>
; # frm_kcode>8
; # tx_drive_kcode_en> 
; # tx_cri_incen>
; # tx_burst_req>
; # -----------------------------
; #
; # -----------------------------
; #          SPECIFIC 
; # -----------------------------
; # taclc_ackonack
; # taclc_cri<4
; # taclc_pl_en>
; # taclc_pl>8
; # taclc_ack>
; # taclc_dis>
; # taclc_b2b_n>
; # taclc_frzmask
(?fsm:lte_dif_taclc
(+size
 (taclc_pl    8)
 (tx_taclc_bc 9)
)

 (init  (<s_rst_n
   (<taclc_ena

    (taclc_ack <- 1)
    (taclc_pl_acknack <- taclc_ackonack)
    (taclc_pl_cri     <- taclc_cri)

    (?taclc_brq
      (=1 (tx_burst_req  <- 1)
          (taclc_frzmask <- 1)
          (-> wait_4burst_ack)
      )

      ; # (=0 (-> drv_sof))
      (=0 (frm_kcode'8       = sof_kcode)
          (tx_drive_kcode_en = 1)
          (taclc_frzmask    <- 1)
          (-> drv_header)
      )
    )
   )
  )
 )

 (wait_4burst_ack  (<(& s_rst_n  taclc_ena)
   (<tx_burst_ack
    (tx_burst_req     <- 0)

    (frm_kcode'8       = sof_kcode)
    (tx_drive_kcode_en = 1)

    (-> drv_header)
   )
  )
 )

 (drv_sof  (<(& s_rst_n taclc_ena)
   (frm_kcode'8       = sof_kcode)
   (tx_drive_kcode_en = 1)

   (taclc_frzmask    <- 1)

   (-> drv_header)
  )
 )

 (drv_header  (<(& s_rst_n taclc_ena)
   (frm_info_wr        = 1)
   (tx_lcid'3          = tx_taclc_id_code)
   (tx_lcindic         = 0)
   (tx_drive_header_en = 1)
   (tx_cri_incen       = 1)

   (tx_taclc_ucri'4   <- tx_used_cri)
   (tx_taclc_bc       <- 9'0)

   (frm_start_waddr_en = 1)

   (taclc_frzmask     <- 0)

   (<nesting_on 
     (<!cadd_latched (frm_curbyte_waddr_save_en = 1)  ; # Saving current address
                     (cadd_latched             <- 1)
     )
   )

   (-> drv_pl)
  )
 )

 (drv_pl  (<(& s_rst_n taclc_ena)
   (taclc_pl_en   = 1)
   (retx_buf_wr   = 1)
   (++ tx_taclc_bc)
   (taclc_pl[4]   = taclc_pl_acknack)
   (taclc_pl[3:0] = taclc_pl_cri)

   ; # This will allow nesting 'til after the last byte of payload and before EOX
   ; # (taclc_frzmask  <- 1)

   ; # (taclc_b2b_n    <- 0)
   (-> eox)
  )
 )

 (eox  (<(& s_rst_n  taclc_ena)
    (tx_drive_kcode_en = 1)
    ; # (taclc_frzmask    <- 0)

    ; # (taclc_b2b_n      <- 1)

    (tx_frm_used_cri'4    = tx_taclc_ucri)
    (tx_frm_pl_bytecnt_wr = 1)
    (tx_frm_pl_bytecnt'9  = tx_taclc_bc)

    (?taclc_req 
      (=1 (frm_kcode'8         = eof_kcode)
          (taclc_pl_acknack'1 <- taclc_ackonack)
          (taclc_pl_cri'4     <- taclc_cri)

	  (taclc_ack          <- 1)
          (-> drv_sof)   
      )

      (=0 (<( | any_req keep_burst_open nesting_on)  (frm_kcode'8  = eof_kcode)
                                                     (taclc_b2b_n <- 0)   ; # Had  <!nesting_on
	  )
          
	  (frm_kcode'8   = eot_kcode <(!| any_req keep_burst_open nesting_on))
          (taclc_dis     = 1)
	  (<nesting_on (cadd_latched           <- 0)
	               (saved_frm_byte_waddr_en = 1) ; # Restoring the latched address
	  )

          (-> init)
      ) 
    )
    
  )
 )

 (-misc  (<s_rst_n
   (taclc_ack>   <- 0  <taclc_ack)
   (taclc_b2b_n> <- 1 <!taclc_b2b_n)
   (taclc_pl[7:5] = taclc_pl_reserved)
  )
 )

 (-syncrst (<!s_rst_n
   (taclc_ack     <- 0)
   ; # (taclc_dis     <- 0)
   (taclc_b2b_n   <- 1)
   (taclc_frzmask <- 0)
   ; # (taclc_pl_buf[7:0] <- 8'0)  ; # Not properly handled yet
   (cadd_latched  <- 0)
   (-> init)
  )
 )

)


; # -----------------------------
; #            SHARED
; # -----------------------------
; # frm_info_wr>
; # retx_buf_wr> (except TAS/RETX)
; # tx_lcid>3
; # tx_lcindic>
; # tx_drive_header_en>
; # frm_kcode>8
; # tx_drive_kcode_en> 
; # tx_cri_incen>
; # tx_burst_req>
; # -----------------------------
; #
; # -----------------------------
; #          SPECIFIC 
; # -----------------------------
; # txdu_req
; # txdu_rq_id_load_en>
; # txdu_pl_rd>
; # txdu_pl_valid
; # txdu_pl_last
; # txdu_dlc_num<3
; # txdu_iq_num<8
; # txdu_brq
; # txdu_dis>
; # txdu_ack>
; # txdu_frzmask>
(?fsm:lte_dif_txdlc
(+size
 (tx_pl_bc  9)
)

 (init  (<s_rst_n
   (<txdu_ena
    (txdu_rq_id_load_en = 1)
    (txdu_ack <- 1)

    (?txdu_brq
     (=1 (tx_burst_req <- 1)
         (txdu_frzmask <- 1)
         (-> wait_4burst_ack)
     )
     
     (=0 ; # (-> drv_sof)
       (txdu_sof_en = 1)
     )
    )
   )
  )
 )


 (wait_4burst_ack  (<(& s_rst_n  txdu_ena)
   (<tx_burst_ack
    (tx_burst_req      <- 0)

    (frm_kcode'8       = sof_kcode)
    (tx_drive_kcode_en = 1)

    (-> drv_header)
   )
  )
 )

 (drv_sof  (<(& s_rst_n  txdu_ena)
   ; # (txdu_frzmask  <- 1)

   ; # (frm_kcode'8       = sof_kcode)
   ; # (tx_drive_kcode_en = 1)

   ; # (-> drv_header)
   (txdu_sof_en = 1)
  )
 )

 (-sof  (<txdu_sof_en
   (txdu_frzmask      <- 1)

   (frm_kcode'8        = sof_kcode)
   (tx_drive_kcode_en  = 1)

   (-> drv_header)
  )
 )

 (drv_header  (<(& s_rst_n  txdu_ena)
   (frm_info_wr        = 1)
   (tx_lcid'3          = txdu_dlc_num)
   (tx_lcindic         = 1)
   (tx_drive_header_en = 1)
   (tx_cri_incen       = 1)

   (tx_ucri'4         <- tx_used_cri)
   (tx_pl_bc          <- 9'0)

   (frm_start_waddr_en = 1)

   (txdu_frzmask      <- 0)

   (-> drv_pl)
  )
 )


 (drv_pl  (<(& s_rst_n  txdu_ena)
   (<txdu_pl_valid
    (txdu_pl_rd           = 1)
    (retx_buf_wr          = 1)
    (frm_byte_waddr_incen = 1)
    (txdu_pl_en           = 1)
    (++ tx_pl_bc)
    (<txdu_pl_last ; # This will allow nesting 'til after the last byte of payload and before EOX
                   ; # (txdu_frzmask <- 1)  

                   ; # (txdu_b2b_n   <- 0)
                   (-> eox)
    )
   )
  )
 )


 (eox  (<(& s_rst_n  txdu_ena)
    (tx_drive_kcode_en = 1)
    ; # (txdu_frzmask     <- 0)

    ; # (txdu_b2b_n       <- 1)

    (tx_frm_used_cri'4    = tx_ucri)
    (tx_frm_pl_bytecnt_wr = 1)
    (tx_frm_pl_bytecnt'9  = tx_pl_bc)


    (?txdu_req 
      (=1 (frm_kcode'8        = eof_kcode)
          (txdu_rq_id_load_en = 1)
	  (txdu_ack     <- 1)
          (-> drv_sof)   
      )

      (=0 (<(| any_req keep_burst_open) (frm_kcode'8 = eof_kcode)
                                        (txdu_b2b_n <- 0)
          )

          (frm_kcode'8 = eot_kcode <(!| any_req keep_burst_open))
          (txdu_dis    = 1)
          (-> init)
      ) 
    )
    
  )
 )


 (-misc  (<s_rst_n
    ; # (txdu_dis>  <- 0 <txdu_dis)
    (txdu_ack>   <- 0 <txdu_ack)
    (txdu_b2b_n> <- 1 <!txdu_b2b_n)
  )
 )

 (-fwd
   (tx_burst_req <- 1  <retx_burst_req_set)
   (tx_burst_req <- 0  <retx_burst_req_clr)
 )

 (-syncrst (<!s_rst_n
   ; # (txdu_dis     <- 0)
   (txdu_ack     <- 0)
   (txdu_frzmask <- 0)
   (txdu_b2b_n   <- 1)
   (-> init)
  )
 )

)



; # -----------------------------
; #            SHARED
; # -----------------------------
; # frm_info_wr>
; # retx_buf_wr> (except TAS/RETX)
; # tx_lcid>3
; # tx_lcindic>
; # tx_drive_header_en>
; # frm_kcode>8
; # tx_drive_kcode_en> 
; # tx_cri_incen>
; # tx_burst_req>
; # -----------------------------
; #
; # -----------------------------
; #          SPECIFIC 
; # -----------------------------
; # rfcu_lcid<3
; # rfcu_len<8
; # xcu_rq_id_load_en>
; # rfcu_pl_rd>
; # rfcu_pl_valid
; # tx_drive_clc_len_en>
; # ctrlfrm_len>8
; # ctrlfrm_crc>8
; # tx_drive_clcrc_en>
; # ------------------------------
; #           ICU
; # ------------------------------
; # icu_pl_en
; # icu_pl_low_en
(?fsm:lte_dif_rfclc
(+size  
 (rfcu_lcid         3)
 (tx_thlclc_id_code 3)
 (tx_tsclc_id_code  3)
 (ctrlfrm_crc       8)
 (tx_pl_bc          9)
 (tx_crcgen_o      16)
 (icu_pl_buf       16)
)

 (init  (<s_rst_n
   (<xcu_ena
     (xcu_rq_id_load_en = 1)
     (xcu_ack <- 1 <!xcu_ack) ; # FIXME FIXME FIXME Beware to This FIXME FIXME FIXME FIXME

     (?xcu_rq_id
       (!=2'0      ; # RFCU
        (rfcu_data_size'8  <- rfcu_len)
        (rfcu_len_buf'8    <- rfcu_len (+= 1))
        (rfcu_lcid_buf'3   <- rfcu_lcid)

        (?rfcu_lcid
         (!=tx_reservedclc_id_code (?xcu_brq
                                    (=1 (tx_burst_req <- 1)
                                        (xcu_frzmask  <- 1) 
                                        (-> wait_4burst_ack)
                                    )
                                   
                                    (=0 (xcu_sof_en = 1) ; # (-> drv_sof)
				    )
                                   )
         )

         (=tx_reservedclc_id_code (xcu_dis = 1))
        )
       )

       (=2'0     ; # ICU
	(icu_on     <- 1)
	(icu_pl_buf <- icu_pl_2send <xcu_iclc)
	(icu_pl_buf <- dm_pl_2send  <!xcu_iclc)
     
        (?xcu_brq
         (=1 (tx_burst_req <- 1)
             (xcu_frzmask  <- 1) 
             (-> wait_4burst_ack)
         )
         
         (=0 ; # (-> drv_sof)
	     (xcu_sof_en = 1)
	 )
        )
       )
     )

   )
  )
 )


 (wait_4burst_ack  (<(& s_rst_n  xcu_ena)
   (<tx_burst_ack
    (tx_burst_req <- 0)

    (xcu_sof_en    = 1)
    ; # (frm_kcode'8       = sof_kcode)
    ; # (tx_drive_kcode_en = 1)

    ; # (-> drv_header)
   )
  )
 )

 (drv_sof  (<(& s_rst_n  xcu_ena)
   ; # (xcu_frzmask  <- 1)

   ; # (frm_kcode'8       = sof_kcode)
   ; # (tx_drive_kcode_en = 1)

   ; # (-> drv_header)
   (xcu_sof_en = 1)
  )
 )

 (-sof  (<xcu_sof_en
   (xcu_frzmask  <- 1)

   (frm_kcode'8        = sof_kcode)
   (tx_drive_kcode_en  = 1)

   (tx_clear_p8_crc16  = 1)


   (-> drv_header)
  )
 )

 (drv_header  (<(& s_rst_n  xcu_ena)
   (frm_info_wr        = 1)
   (tx_lcid'3          = rfcu_lcid_buf     <!icu_on)
   (tx_lcid'3          = tx_ticlc_id_code  <icu_on)
   (tx_lcindic         = 0)
   (tx_drive_header_en = 1)
   (tx_cri_incen       = 1)

   (tx_ucri'4         <- tx_used_cri)
   (tx_pl_bc          <- 9'0)

   (frm_start_waddr_en = 1)

   (xcu_frzmask       <- 0)

   (tx_enable_p8_crc16 = 1)

   (?icu_on
    (=0 (-> drv_header_last  <rfcu_has_long_header)
        (-> drv_pl           <!rfcu_has_long_header)
    )

    (=1 (xcu_tgl  <- 1)  
        (-> drv_pl)
    )
   )
  )
 )

 (drv_header_last  (<(& s_rst_n  xcu_ena)
   (tx_drive_clc_len_en  = 1)
   (retx_buf_wr          = 1)
   (frm_byte_waddr_incen = 1)
   (++ tx_pl_bc)
   (tx_enable_p8_crc16   = 1)

   (ctrlfrm_len'8        = rfcu_len_buf) ; # Account for the 2B of CRC, as per MIPI DigRFv4 spec p.84 §593

   (-> drv_pl)
  )
 )

 (drv_pl  (<(& s_rst_n  xcu_ena)
   (?icu_on
    (=0 (<rfcu_pl_valid
          (<rfcu_data_size>8'0  (-- rfcu_data_size))
          (rfcu_pl_rd           = 1)
          (retx_buf_wr          = 1)
          (frm_byte_waddr_incen = 1)

          (rfcu_pl_en           = 1)

	  (++ tx_pl_bc)
          (tx_enable_p8_crc16   = 1)

          (<rfcu_data_size=8'1 (xcu_tgl <- 1)
                               (-> clcrc)
          )
        )
    )

    (=1 (icu_pl_en            = 1)
        (retx_buf_wr          = 1)
        (frm_byte_waddr_incen = 1)

	(++ tx_pl_bc)
        (tx_enable_p8_crc16   = 1)

	(?xcu_tgl
	 (=0 (icu_pl_low_en   = 1)
	     (xcu_tgl <- 1)
	     (-> clcrc)
	 )

	 (=1 (xcu_tgl <- 0))
	)
    )
   )
  )
 )


 (clcrc  (<(& s_rst_n  xcu_ena)
   (ctrlfrm_crc       = tx_crcgen_o[15:8] <xcu_tgl)
   (ctrlfrm_crc       = tx_crcgen_o[7:0]  <!xcu_tgl)
   (tx_drive_clcrc_en = 1)
   (xcu_tgl <- 0)
   
   (<!xcu_tgl ; # This will allow nesting 'til after the last byte of payload and before EOX
          ; # (xcu_frzmask  <- 1) ; # Should not be disturbed by any Nestable frame when driving the last KCODE (EOF or EOT)

          ; # (xcu_b2b_n    <- 0)
          (-> eox)
   )
  )
 )

 (eox  (<(& s_rst_n  xcu_ena)
    (tx_drive_kcode_en = 1)
    ; # (xcu_frzmask      <- 0)

    ; # (xcu_b2b_n        <- 1)


    (tx_frm_used_cri'4    = tx_ucri)
    (tx_frm_pl_bytecnt_wr = 1)
    (tx_frm_pl_bytecnt'9  = tx_pl_bc)

    (?xcu_req 
      (=1 (xcu_ack  <- 1)
          (?xcu_rq_id
            (!=2'0 (icu_on  <- 0)
	           (?rfcu_lcid
                     (!=tx_reservedclc_id_code (frm_kcode'8        = eof_kcode)
                                               (rfcu_data_size'8  <- rfcu_len)
					       ; # +1 because the real len value is (rfcu_len +1)  0->1 ... 255->256
                                               (rfcu_len_buf'8    <- rfcu_len (+= 1))
                                               (rfcu_lcid_buf'3   <- rfcu_lcid)
                                               (xcu_rq_id_load_en  = 1)

                                               (-> drv_sof)   
	             )

	             (=tx_reservedclc_id_code  (frm_kcode'8 = eot_kcode)
	                                       (xcu_dis     = 1)
	                 		       (-> init)
	             )
	           )
	    )

	    (=2'0 (frm_kcode         = eof_kcode)
	          (xcu_rq_id_load_en = 1)
		  (icu_on           <- 1)
	          (icu_pl_buf       <- icu_pl_2send <xcu_iclc)
	          (icu_pl_buf       <- dm_pl_2send  <!xcu_iclc)
	          (-> drv_sof)
	    )
	  )
      )

      (=0 (<( | any_req keep_burst_open) (frm_kcode'8  = eof_kcode)
                                         (xcu_b2b_n    <- 0)
	  )
          
	  (frm_kcode'8  = eot_kcode <(!| any_req keep_burst_open))
	  (icu_on      <- 0)
          (xcu_dis      = 1)
	  (-> init)
      ) 
    )
    
  )
 )


 (-misc  (<s_rst_n
    ; # (xcu_dis>  <- 0 <xcu_dis)
    (xcu_ack>   <- 0 <xcu_ack)
    (xcu_b2b_n> <- 1 <!xcu_b2b_n)
    (rfcu_has_long_header = 1  <(| rfcu_lcid_buf=tx_thlclc_id_code rfcu_lcid_buf=tx_tsclc_id_code))
  )
 )

 (-syncrst (<!s_rst_n
   ; # (xcu_dis  <- 0)
   (xcu_ack      <- 0)
   (xcu_frzmask  <- 0)
   (xcu_b2b_n    <- 1)
   (xcu_tgl      <- 0)
   (icu_on       <- 0)
   (-> init)
  )
 )

)


(?fsm:lte_dif_dmfrm
 (init (<s_rst_n
   ; # Means A frame has just ended w/ an EOF
   ; # because 'burst_on' is still active
   (<(& seq_b2b_n!=11111 !nesting_on burst_on no_req)
    (dm_req <= 1)
    (-> ack)
   )
  )
 )


 (ack (<s_rst_n
   (<dm_ack
     (dm_req <= 0)
     (-> init)
   )
  )
 )
 

 (-sr (<!s_rst_n
   (dm_req <= 0)
   (-> init)
  )
 )
)


