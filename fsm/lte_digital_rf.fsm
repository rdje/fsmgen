    ana_pwr_en>  +beginarch=assign_add#{ana_pwr_en:ext_lines_o_v_2(0)}
    sys_clk_en>  +beginarch=assign_add#{sys_clk_en:ext_lines_o_v_3(0)}
    digrf_en>    +beginarch=assign_add#{digrf_en:ext_lines_o_v_4(0)}
    txon>        +beginarch=assign_add#{txon:ext_lines_o_v_5(0)}
  )
)


