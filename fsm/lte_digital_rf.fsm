    +beginarch=assign_add#{ext_lines_i_v_3(0):icc_queue_rdata (15)}
    +beginarch=assign_add#{ext_lines_i_v_2(0):icc_queue_rdata (15)}
    +beginarch=assign_add#{ext_lines_i_v_1(0):icc_queue_rdata (15)}
    +beginarch=assign_add#{ext_lines_i_v_0:NOT icc_queue_rdata (15)}
    ext_lines_o_v>6
    +endtop=move_port_2signal#ext_lines_
    (?rtl:lte_dif_2to1_flop_1b  -rv_g=1  :dig_rst_n
      /i_load/ext_lines_i_en[0]/
      /i_data/ext_lines_i_v_0/
      /o_data/ext_lines_o_v_0/
      /o_next_data/open/
    )

    (?rtl:lte_dif_2to1_flop  -dw_g=1  :dig_pwr_en
      /i_load/ext_lines_i_en[1]/
      /i_data/ext_lines_i_v_1/
      /o_data/ext_lines_o_v_1/
      /o_next_data/open/
    )

    (?rtl:lte_dif_2to1_flop  -dw_g=1  :ana_pwr_en
