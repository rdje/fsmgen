; #    (retx_ack> <- 1 <retx_req)
; #    (retx_ack <- 0  <retx_ack)
; #    (retx_dis  = 1)   ;  # To Prevent its 'seqon' bit to be set
; #   )
; #  )
; # 
; #  (-syncrst (<!s_rst_n
; #    ; # (retx_dis     <- 1)
; #    (retx_ack     <- 0)
