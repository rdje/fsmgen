      /o_next_data/open/
    )

    (?rtl:lte_dif_2to1_flop  -dw_g=1  :digrf_en
      /i_load/ext_lines_i_en[4]/
      /i_data/ext_lines_i_v_4/
      /o_data/ext_lines_o_v_4/
      /o_next_data/open/
    )

    (?rtl:lte_dif_2to1_flop  -dw_g=1  :txon
      /i_load/ext_lines_i_en[5]/
      /i_data/ext_lines_i_v_5/
      /o_data/ext_lines_o_v_5/
      /o_next_data/open/
    )


    dig_rst_n>   +beginarch=assign_add#{dig_rst_n:ext_lines_o_v_0}
