   /i_last/rxdu_iq_last/                   ; # IN  STD_LOGIC;
   /i_next_o/open/                         ; # OUT STD_LOGIC;
   /o_data/rxdi_fifo_wdata/                ; # OUT STD_LOGIC_VECTOR (n_omax_g-1 DOWNTO 0);
   /o_valid/rxdi_fifo_wr/                  ; # OUT STD_LOGIC;
