   /i_next_o/rxdi_fifo_rd/                 ; # OUT STD_LOGIC;
   /o_data/rxdu_unpack_16to_o_data/        ; # OUT STD_LOGIC_VECTOR (n_omax_g-1 DOWNTO 0);
   /o_valid/rxdu_unpack_16to_o_valid/      ; # OUT STD_LOGIC;
