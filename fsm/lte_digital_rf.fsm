; #    "/wdata/{rxi_code rxi_kcode rxi_coderror}/"
; #    /rd$/rxm_rd/
; #    "/rdata/{rxm_code rxm_kcode rxm_coderror}/"
; #    /^full/open/
; #    /valid/rxm_valid/
; #    /^empty/open/
; #    /a_full$/open/
; #    /a_empty$/open/
; #    /thres/4'0/
; #  )
; # 
; # 
; #  (?fsmc:lte_dif_rxjoin
; #    lte_dif_rxjoin_mx
; #    lte_dif_rxjoin_ovld
; #  )
; # )


; # (?fsm:lte_dif_rxjoin
; #  
; #  (idle (<s_rst_n
; #   )
; #  )
; # 
; # 
; #  (-syncrst (<!s_rst_n
; #   )
; #  )
; # )

; # (?top:lte_dif_rxmain
; #   (?toplink:lte_dif_rxdistrib) ; # REMOVED this additional level
; # )


(?top:lte_dif_rxmain
   clk
   fast_clk
   rst_n
   s_rst_n


   sof_kcode<8
   eof_kcode<8
   eot_kcode<8
 
   rx_raclc_id_code<3

   rxdu_1_dlc_num<3
   rxdu_2_dlc_num<3
   rxdu_3_dlc_num<3
   rxdu_4_dlc_num<3

   rx_taclc_ackonack>
   rx_taclc_cri>4
   rx_taclc_req>

   rx_raclc_ackonack>
   rx_raclc_cri>4
   rx_raclc_retx_req>




   ; # FIXME FIXME FIXME FIXME FIXME PLEASE TAKE care about this FIXME FIXME FIXME FIXME FIXME
   ; # FIXME FIXME Should add a Synchronization logic
   dual_rxlane_on_req  ; # FIXME FIXME Should add a Synchronization logic
   dual_rxlane_off_req ; # FIXME FIXME Should add a Synchronization logic
   dual_rxlane_on>=0b0 ; # DON'T LET this like this FIXME FIXME FIXME FIXME FIXME FIXME

   ; crc_error>


   rx_m_valid    
   rx_m_coderror<3
   rx_m_kcode    
   rx_m_data<8    


   frm_lcid>3         +beginarch=assign_add#{frm_lcid:rx_m_data(7) & rx_m_data(3 DOWNTO 2)} 
   frm_cri>4          +beginarch=assign_add#{frm_cri:rx_m_data(6 DOWNTO 4) & rx_m_data(1)} 
   frm_type>          +beginarch=assign_add#{frm_type:rx_m_data(0)} 
   frm_is_ctrl>       +beginarch=assign_add#{frm_is_ctrl:NOT rx_m_data(0)} 
   frm_is_data>       +beginarch=assign_add#{frm_is_data:rx_m_data(0)} 
   frm_is_raclc>      +beginarch=assign_add#{frm_is_raclc:frm_is_ctrl AND lcid_is_raclc}
   lcid_is_raclc>     +beginarch=assign_add#{lcid_is_raclc:has_no_error  WHEN frm_lcid = rx_raclc_id_code ELSE '0'}
   lcid_isnot_raclc>  +beginarch=assign_add#{lcid_isnot_raclc:has_no_error  WHEN frm_lcid /= rx_raclc_id_code ELSE '0'}
   has_no_error>      +beginarch=assign_add#{has_no_error:'1' WHEN rx_m_coderror = "000" ELSE '0'}
   has_error>         +beginarch=assign_add#{has_error:NOT has_no_error}
   eq_sof>            +beginarch=assign_add#{eq_sof:'1' WHEN rx_m_data = sof_kcode ELSE '0'}
   eq_eof>            +beginarch=assign_add#{eq_eof:'1' WHEN rx_m_data = eof_kcode ELSE '0'}
   eq_eot>            +beginarch=assign_add#{eq_eot:'1' WHEN rx_m_data = eot_kcode ELSE '0'}
   is_sof>            +beginarch=assign_add#{is_sof:rx_m_kcode AND eq_sof AND has_no_error}
   is_eof>            +beginarch=assign_add#{is_eof:rx_m_kcode AND eq_eof AND has_no_error}
   is_eot>            +beginarch=assign_add#{is_eot:rx_m_kcode AND eq_eot AND has_no_error}
   is_eox>            +beginarch=assign_add#{is_eox:is_eof OR is_eot}

                      +beginarch=assign_add#{raclc_frm_cri:rx_m_data(3 DOWNTO 0)} 
                      +beginarch=assign_add#{raclc_frm_ackonack:rx_m_data(4)} 
                      
   +endtop=move_port_2signal#_is_#_isnot_#^frm_#raclc_frm_cri#raclc_frm_ackonack#^is_#^eq_#^has_
   +endtop=move_port_2signal#rx_cri#retx_info#expired_
   +declarch=decl_signal_from_port
     

   (?fsmc:lte_dif_rxmainctrl
     lte_dif_rxclc
     lte_dif_raclc             /dv/rx_m_valid/ 
     lte_dif_cri_mon

     /norm_retx_cri/4'11/
     /blind_retx_cri/4'12/


     /rx_cri_mismatch_ge2_error/open/     ; # FIXME FIXME To be routed to the Error Handler FIXME FIXME
     /rx_unexpected_norm_retx_error/open/ ; # FIXME FIXME To be routed to the Error Handler FIXME FIXME 
   )

   ; # 4us time-out delay for receiving Retransmitted Frames
   (?rtl:lte_dif_timeout_wd  -wdcnt_g=13  -numsz_g=4  -timesz_g=10  :retx_timeout
     /start$/retx_info_wr/
     /start_num/rx_cri_p1/
     /stop_num/retx_info_cri/
     /stop$/retx_info_rd/
     /timeout_num/expired_retx_cri/
     /trig/expired_retx_trig/
     /timeout_delay/rxlink_wd_retx_timeout_delay/
   )


   (?top:lte_dif_rx_cri
     frm_cri<4
     rx_cri_incen
     rx_cri_load_incen

     rx_cri>4         +beginarch=assign_add#rx_cri:rx_cri_q

     +endtop=move_port_2signal#cri_mux#cri_nxten        
     +declarch=decl_signal_from_port 

     +beginarch=assign_add#{cri_mux:frm_cri WHEN rx_cri_load_incen = '1' ELSE rx_cri_q}
     +beginarch=assign_add#{cri_nxten:rx_cri_load_incen OR rx_cri_incen}

     (?rtl:lte_dif_pk_mod_m  -iosz_g=4
      /xi/cri_mux/
      /incr_k/4'1/
      /mod_m/4'11/
      /yo/nxt_rx_cri/
     )

     (?rtl:lte_dif_2to1_flop  -dw_g=4  :rx_cri
       /i_load/cri_nxten/
       /i_data/nxt_rx_cri/
       /o_data/rx_cri_q/
       /o_next_data/open/
     )

     (?rtl:lte_dif_pk_mod_m  -iosz_g=4  :rx_cri_p1
      /xi/rx_cri_q/
      /incr_k/4'1/
      /mod_m/4'11/
      /yo/rx_cri_p1/
     )

     (?rtl:lte_dif_pk_mod_m  -iosz_g=4  :rx_cri_p2
      /xi/rx_cri_q/
      /incr_k/4'2/
      /mod_m/4'11/
      /yo/rx_cri_p2/
     )
   )


   expired_retx_info_rd>
   +beginarch=assign_add#{g_retx_info_rd:retx_info_rd OR expired_retx_info_rd}
   +beginarch=assign_add#{expired_retx_info_rd:expired_retx_trig WHEN  expired_retx_cri = retx_info_cri ELSE '0'}

   retx_info_lcid>3          ; # internal signal
   retx_info_type>           ; # internal signal
   (?rtl:lte_dif_gfifo  -wc_g=11  -aw_g=4  -dw_g=8  :retx_info
     /wr/retx_info_wr/
     "/wdata/{frm_lcid frm_cri frm_type}/"
     /rd$/g_retx_info_rd/
     "/rdata/{retx_info_lcid retx_info_cri retx_info_type}/"
     /^full/open/
     /valid/retx_info_valid/
     /^empty/open/
     /a_full$/open/
     /a_empty$/open/
     /thres/4'0/
   )


   

  (?top:lte_dif_rxclc_be
    rxclc_bc<8
    rxclc_lcid<3
  
    fcrc_wr
    rx_m_data<8

    rspu_ctrl_data>8
    fcrc_mem_rdata<10  +beginarch=assign_add#{rspu_ctrl_data:fcrc_mem_rdata(7 DOWNTO 0)}
    fcrc_mem_wdata>10  +beginarch=assign_add#{fcrc_mem_wdata:"00" & rx_m_data}
    fcrc_mem_wr_n>     +beginarch=assign_add#{fcrc_mem_wr_n:NOT fcrc_wr}

    (?toplink:lte_dif_fcrc_add_gen  :wr
       /base_tgl_en/w_base_tgl_en/
       /incen/w_incen/
       /basen/w_basen/
       /base_incr/9'130/
       /cur_addr/fcrc_wmem_addr/
    )

    (?toplink:lte_dif_fcrc_add_gen  :rd
       /base_tgl_en/r_base_tgl_en/
       /incen/r_incen/
       /basen/r_basen/
       /base_incr/9'130/
       /cur_addr/fcrc_rmem_addr/
    )

    +endtop=move_port_2signal#fcrc_rdata:fcrc_mem_rdata +declarch=decl_signal_from_port

    (?fsmc: lte_dif_fcrc_read)
  )


  rspu_ctrl_lcid>3
  rspu_ctrl_size>8
  rspu_ctrl_valid>
  rspu_ctrl_data>8
  rspu_ctrl_last>

  rord_mem_wr_n>=0b1
  rord_wmem_addr>11=11'0
  rord_mem_wdata>8         ; # +beginarch=assign_add#rord_1_mem_wdata:rx_m_data
  rord_rmem_addr>11=11'0
  rord_mem_rdata<8

  rxdu_1_valid>=0b0
  rxdu_1_iq_last>=0b0
  rxdu_1_iq_data>8
  ; # (?toplink:lte_dif_rxdlc_be
  ; #   /dlc_num/rxdu_1_dlc_num/
  ; #   /rord_mem_raddr/rord_1_rmem_addr/
  ; #   /rord_mem_rdata/rord_1_mem_rdata/
  ; #   /rord_mem_waddr/rord_1_wmem_addr/
  ; #   /rord_mem_wr_n/rord_1_mem_wr_n/
  ; #   /o_valid/rxdu_1_valid/
  ; #   /o_last/rxdu_1_iq_last/
  ; #   /o_data/rxdu_1_iq_data/
  ; # )


  ; # rord_2_wmem_addr>11=11'0
  ; # rord_2_mem_wr_n>=0b1
  ; # rord_2_mem_wdata>8         ; # +beginarch=assign_add#rord_2_mem_wdata:rx_m_data
  ; # rord_2_rmem_addr>11=11'0
  ; # rord_2_mem_rdata<8

  rxdu_2_valid>=0b0
  rxdu_2_iq_last>=0b0
  rxdu_2_iq_data>8
  ; # (?toplink:lte_dif_rxdlc_be
  ; #   /dlc_num/rxdu_2_dlc_num/
  ; #   /rord_mem_raddr/rord_2_rmem_addr/
  ; #   /rord_mem_rdata/rord_2_mem_rdata/
  ; #   /rord_mem_waddr/rord_2_wmem_addr/
  ; #   /rord_mem_wr_n/rord_2_mem_wr_n/
  ; #   /o_valid/rxdu_2_valid/
  ; #   /o_last/rxdu_2_iq_last/
  ; #   /o_data/rxdu_2_iq_data/
  ; # )

  ; # rord_3_wmem_addr>11=11'0
  ; # rord_3_mem_wr_n>=0b1
  ; # rord_3_mem_wdata>8         ; # +beginarch=assign_add#rord_3_mem_wdata:rx_m_data
  ; # rord_3_rmem_addr>11=11'0
  ; # rord_3_mem_rdata<8

  rxdu_3_valid>=0b0
  rxdu_3_iq_last>=0b0
  rxdu_3_iq_data>8
  ; # (?toplink:lte_dif_rxdlc_be
  ; #   /dlc_num/rxdu_3_dlc_num/
  ; #   /rord_mem_raddr/rord_3_rmem_addr/
  ; #   /rord_mem_rdata/rord_3_mem_rdata/
  ; #   /rord_mem_waddr/rord_3_wmem_addr/
  ; #   /rord_mem_wr_n/rord_3_mem_wr_n/
  ; #   /o_valid/rxdu_3_valid/
  ; #   /o_last/rxdu_3_iq_last/
  ; #   /o_data/rxdu_3_iq_data/
  ; # )

  ; # rord_4_wmem_addr>11=11'0
  ; # rord_4_mem_wr_n>=0b1
  ; # rord_4_mem_wdata>8         ; # +beginarch=assign_add#rord_4_mem_wdata:rx_m_data
  ; # rord_4_rmem_addr>11=11'0
  ; # rord_4_mem_rdata<8

  rxdu_4_valid>=0b0
  rxdu_4_iq_last>=0b0
  rxdu_4_iq_data>8
  ; # (?toplink:lte_dif_rxdlc_be
  ; #   /dlc_num/rxdu_4_dlc_num/
  ; #   /rord_mem_raddr/rord_4_rmem_addr/
  ; #   /rord_mem_rdata/rord_4_mem_rdata/
  ; #   /rord_mem_waddr/rord_4_wmem_addr/
  ; #   /rord_mem_wr_n/rord_4_mem_wr_n/
  ; #   /o_valid/rxdu_4_valid/
  ; #   /o_last/rxdu_4_iq_last/
  ; #   /o_data/rxdu_4_iq_data/
  ; # )
)


(?fsm:lte_dif_cri_mon
(+size
 (frm_cri      4)
 (rx_cri_p1    4)
 (rx_cri_p2    4)
 (rx_taclc_cri 4)
)

 (sof (<(& s_rst_n  dv)
   (-> hd <is_sof) 
  )
 )

 ; # FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME
 (hd (<(& s_rst_n  dv)
   (?has_error
    (=0 (?rx_m_kcode
         (=0 (?frm_cri   ; # FIXME FIXME NORMALLY I should ACK ('0') ONLY IF IT HAS BEEN REQUESTED -> FIXME TO BE FIXED FIXME
	       (<norm_retx_cri
	         (?frm_cri
		   ; # Current frame is in sequence
                   (=rx_cri (rx_cri_incen = 1)
	                    (rxclc_start  = 1 <(& frm_is_ctrl lcid_isnot_raclc))
		    ; #     (rxdlc_start  = 1 <frm_is_data)
	           )                                                           
	           
		   ; # Request for retransmission
		   ; #
		   ; # For CTRL frames:
		   ; #  Check CRC first is OK, the current frame is accepted and a NACK for rx_cri shoule be sent
		   ; # 
		   ; # For DATA frames:
		   ; #  Store the current frame 
	           (=rx_cri_p1  (rx_taclc_req      = 1)       ; # CRI mismatch -> 1 missing frame    
                                (rx_taclc_cri      = rx_cri)
	                        (rx_taclc_ackonack = 1)       ; # NACK='1'
	                        (rx_cri_load_incen = 1)
                                (retx_info_wr      = 1)

				(rx_cri_mismatch>  = 1)
				(rxclc_start       = 1 <(& frm_is_ctrl lcid_isnot_raclc))
		   ; #          (rxdlc_start       = 1 <frm_is_data)

	           )

                   ; # Fatal ERROR
		   ; # CRI mismatch -> at least 2 frames missing -> Fatal Error
	           (>=rx_cri_p2  (rx_cri_mismatch_ge2_error <- 1)

	           )
		 )
	       )

               ; # May happen for both CONTROL/DATA frames
	       (=norm_retx_cri   (?retx_info_valid
	                           (=1 (rx_cri_incen  = 1)  ; # Looks like a normally retransmitted frame
				       (retx_info_rd  = 1)

				       ; # (norm_retx_on> = 1)
				       (rxclc_start   = 1 <(& frm_is_ctrl lcid_isnot_raclc))
			           ; # (rxdlc_start   = 1 <frm_is_data)
				   )

				   (=0  (rx_unexpected_norm_retx_error <- 1))
				 )
	                        
	       )


               ; #                     May occur ONLY for CONTROL frames
	       ; # 
	       ; # DATA frames can not be blindly retransmitted since they're never ACK'ed if well received
	       ; # But they can be NACK'ed and as such will be retransmitted ONLY using the normal retransmission
	       ; # mechanism (CRI=0xB)
	       (=blind_retx_cri  (rx_cri_incen  = 1)    ; # Looks like a blindly  retransmitted frame
				 (rxclc_start   = 1 <(& frm_is_ctrl lcid_isnot_raclc))
	       )

             )
	 )
	)
    )

    ; # (=1 )  Table #31 of v0.60.00 23-July-2008 of the MIPI DigRFv4 Spec says 
    ; #        Not to ack if a frame has an erroneous header
   )

   (-> sof)
  )
 )


 (-misc (<s_rst_n
   (rx_cri_mismatch_ge2_error     <- 0 <rx_cri_mismatch_ge2_error)
   (rx_unexpected_norm_retx_error <- 0 <rx_unexpected_norm_retx_error)
  )
 )


 (-sr (<!s_rst_n
   (-> sof)
  )
 )
)


(?fsm:lte_dif_raclc
(+size
 (rx_raclc_cri      4)
 (rx_raclc_ackonack 1)
)


 (sof (<(& s_rst_n  dv)
   (<is_sof (rxylc_dis_n = 0)
            (-> hd)
   ) 
  )
 )


 (hd (<(& s_rst_n  dv)
   (raclc_taclc_cri'4  <- frm_cri)

   (<frm_is_raclc (rxylc_dis_n = 0)
                  (-> pl  <!rx_cri_mismatch)
                  (-> sof <rx_cri_mismatch)   ; # Frame content ignored due to CRI mismatch
   )
   
   (-> sof <!frm_is_raclc)
  )
 )


 (pl (<(& s_rst_n  dv)
   (first_byte  <- 0)
   (?has_no_error 
     (=0 (<first_byte (rx_raclc_cri>     <- raclc_frm_cri) 
                      (rx_raclc_ackonack <- raclc_frm_ackonack)
	 )
     )

     (=1  (pl_error <- 1))
   )

   (rxylc_dis_n = 0)

   (-> eox)
  )
 )
 

 (eox (<(& s_rst_n  dv)
   (rxylc_dis_n = 0)
   (?is_eox
     (=1 (rx_raclc_retx_req   = 1  <(& !raclc_tgl !pl_error rx_raclc_cri<=4'12)) 
         (<(| raclc_tgl pl_error)
	   (rx_taclc_req      = 1)
	   (rx_taclc_cri'4    = raclc_taclc_cri)
	   (rx_taclc_ackonack = 1)
	 )

         (first_byte <- 1)
         (pl_error   <- 0)
         (raclc_tgl  <- 0)
         (-> sof)
     )

     (=0 (raclc_tgl <- 1))  ; # Wrong PL size
   )
  )
 )


 (-sr (<!s_rst_n
   (first_byte <- 1)
   (pl_error   <- 0)
   (raclc_tgl  <- 0)
   (-> sof)
  )
 )
)


; #           FIXME NOT FINISHED YET FIXME
; # 
; #   FIXME Will NEED to check the Status     FIXME
; #   FIXME of the CRC check before issuing   FIXME
; #   FIXME an ACK or NACK                    FIXME
; #   FIXME For this I should also take the   FIXME
; #   FIXME is_cri_mismatch info into account FIXME
; #
(?fsm:lte_dif_rxclc
(+size
 (rxclc_bc  8)
)

 (idle (<(& s_rst_n rxylc_dis_n dv)
   (<rxclc_start (w_basen            = 1)
                 (rxclc_lcid'3      <- frm_lcid)
                 (rxclc_cri'4       <- frm_cri)
                 (rxclc_bc          <- 8'0)
		 (is_cri_mismatch'1 <- rxclc_is_cri_mismatch)
		 ; # Currently there is a BUG in FSMGEN.pm regarding this type of RHS TO BE Fixed
		 ; # (is_cri_mismatch'1 <- rx_cri_mismatch)    

                 (-> pl)
   )
  )
 )

 (pl (<(& s_rst_n rxylc_dis_n dv)
   (rxclc_tgl   <- 1)

   (?is_eox
     (=0 (w_incen        = 1 <rxclc_tgl)
         (fcrc_pl_error <- 1 <has_error)
         (fcrc_wr>       = 1)
	 (++ rxclc_bc)
     )
     
     (=1 (fcrc_rd_start = 1 <!fcrc_pl_error)
         (rxclc_tgl          <- 0)
	 (w_base_tgl_en = 1)

  ; # FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME 
  ; # The three lines BELOW ARE VERY TEMPORARY  FIXME 
  ; # FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME 
         (rx_taclc_req      = 1)           ; #  FIXME 
         (rx_taclc_ackonack = 0)           ; #  FIXME 
         (rx_taclc_cri'4    = rxclc_cri)   ; #  FIXME 
  ; # FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME 


	 (-> idle)
     )
   )
  )
 )

 (-misc
   (rxclc_is_cri_mismatch = 1 <rx_cri_mismatch)  ; # !!!!!!!!!!!   Just a trick to avoid Fixing FSMGEN.pm now !!!!!!!!!!!!
 )

 (-sr (<!s_rst_n
   (rxclc_bc  <- 8'0)
   (-> idle)
  )
 )
)


(?fsm:lte_dif_fcrc_read
(+size
 (rspu_ctrl_size  8)
)

 (idle (<s_rst_n
   (<fcrc_rd_start  (rspu_ctrl_lcid'3 <- rxclc_lcid)
                    (fcrc_rd_bc'8     <- rxclc_bc)
                    (rspu_ctrl_size>  <- rxclc_bc (-= 2)) ; # Minus two byte of CRC
                    (r_basen           = 1)

		    (-> rd)
   )
  )
 )


 (rd (<s_rst_n
   (rspu_ctrl_valid = 1)

   (?rspu_ctrl_size
           ; # Test is against 8'3 Because 2 and 1 are for the 2B of CRC
     (>8'1 (?fcrc_rd_bc    
             (>8'3 (-- fcrc_rd_bc)    
                   (r_incen = 1)
             )
             
             (=8'3 (rspu_ctrl_last = 1)
                   (r_base_tgl_en  = 1)
		   (-> idle)
             )
           )

     )

     (=8'1  (r_base_tgl_en  = 1)
            (rspu_ctrl_last = 1)
            (-> idle)
     )
   )
  )
 )
 

 (-sr (<!s_rst_n
   (-> idle)
  )
 )
)


(?top:lte_dif_fcrc_add_gen

 base_tgl_en
 incen
 basen
 base_incr<9
 cur_addr>9   +beginarch=assign_add#cur_addr:cur_addr_mux

 +endtop=move_port_2signal#base_addr#incr_sel#p_cur_addr#incr_addr  +declarch=decl_signal_from_port

 incr_sel>
 incr_addr>9
 base_addr>9  +beginarch=assign_add#"base_addr:base_incr  WHEN incr_sel = '1' ELSE (base_incr'RANGE => '0')"
              +beginarch=assign_add#{incr_sel_d:incr_sel XOR base_tgl_en}
	      +beginarch=assign_add#{incr_addr:p_cur_addr + '1'}

 (?rtl:lte_dif_flop_1b    :base_tgl         
   /di/incr_sel_d/    
   /do/incr_sel/
 )

 (?rtl:lte_dif_ghmux_wd  -wc_g=3  -dw_g=9   :cur_addr_mux
   "/di/{incr_addr base_addr p_cur_addr}/"
   "/sel/{incen basen}/"
   /hmux_o/cur_addr_mux/
 )

 (?rtl:lte_dif_flop   -iosz_g=9
  /di/cur_addr_mux/
  /do/p_cur_addr/
 )
)


