 (?rtl:lte_dif_stream_adapter_m_ge_n  :rxdu_unpack_16to
   -m_imax_g=16                            ; # -- Max input  stream bit-width (M)
   -m_imin_g=16                            ; # -- Min input  stream bit-width (M)
