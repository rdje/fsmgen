   /cmi_last_word_wr/ppimon_cmi_last_word_wr/
   /cmi_infinite_wr/ppimon_cmi_infinite_wr/
   /cmi_bypass_wr/ppimon_cmi_bypass_wr/
   /cmi_flush_wr/ppimon_cmi_flush_wr/
   /cmi_word_wr_en/ppimon_cmi_word_wr_en/

   /lcm_burst_size/ppimon_lcm_burst_size/
