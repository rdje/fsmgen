     )

     (?rtl:lte_dif_pulsync  :ber_2_gen_load_en  ; # PULSE  -> WOP
       /in_clk/dif_104_clk/
       /in_rst_n/dif_rst_n/
       /out_clk/rx_2_clk/
       /out_rst_n/rx_2_rst_n/
       /pulsin/ios_ber_2_gen_load_en/
       /pulsout/ber_2_gen_load_en/
     )

     (?rtl:lte_dif_pulsync  :ber_2_recv_force_sync_en  ; # PULSE  -> WOP
       /in_clk/dif_104_clk/
       /in_rst_n/dif_rst_n/
       /out_clk/rx_2_clk/
       /out_rst_n/rx_2_rst_n/
       /pulsin/ios_ber_2_recv_force_sync_en/
       /pulsout/ber_2_recv_force_sync_en/
     )

     (?rtl:lte_dif_pulsync  :ber_2_counter_load_en  ; # PULSE  -> WOP
       /in_clk/dif_104_clk/
       /in_rst_n/dif_rst_n/
       /out_clk/rx_2_clk/
       /out_rst_n/rx_2_rst_n/
       /pulsin/ios_ber_2_counter_load_en/
       /pulsout/ber_2_counter_load_en/
     )

     (?rtl:lte_dif_pulsync  :ber_2_counter_rst_en  ; # PULSE  -> WOP
       /in_clk/dif_104_clk/
       /in_rst_n/dif_rst_n/
       /out_clk/rx_2_clk/
       /out_rst_n/rx_2_rst_n/
       /pulsin/ios_ber_2_counter_rst_en/
       /pulsout/ber_2_counter_rst_en/
     )

     (?rtl:sync_s  :ber_2_recv_synchronized         ; # SLOW -> LEVEL
      /clk/dif_104_clk/
      /rst_n/dif_rst_n/
      /test_en/dft_ctrl_in[?dft_ctrl_sync_bypass_c]/
      /async_signal/ber_2_recv_synchronized/
      /synced_signal/ios_ber_2_recv_synchronized/
     )

     (?rtl:sync_s  :ber_2_overflow                  ; # SLOW -> LEVEL
      /clk/dif_104_clk/
      /rst_n/dif_rst_n/
      /test_en/dft_ctrl_in[?dft_ctrl_sync_bypass_c]/
      /async_signal/ber_2_overflow/
      /synced_signal/ios_ber_2_overflow/
     )

     (?top:lte_dif_ios_ber_asyncread
       
      /ber_counter_rd_en/ber_1_counter_rd_en/
      /rx_clk/rx_1_clk/
      /rx_rst_n/rx_1_rst_n/

      (?rtl:lte_dif_pulsync
        /in_clk/dif_104_clk/
        /in_rst_n/dif_rst_n/
        /out_clk/rx_clk/
        /out_rst_n/rx_rst_n/
        /pulsin/ber_counter_rd_en/   ; # WOP
        /pulsout/ber_counter_rd_en_sync/
      )

      (?rtl:lte_dif_pulsync
        /in_clk/rx_clk/
        /in_rst_n/rx_rst_n/
        /out_clk/dif_104_clk/
        /out_rst_n/dif_rst_n/
        /pulsin/ber_counter_rd_en_sync/
        /pulsout/ber_counter_rd_en_ack/
      )

      /i_ber_counter/ber_1_counter/

      (?rtl:lte_dif_2to1_flop  -dw_g=16
        /clk/rx_clk/
        /rst_n/rx_rst_n/
        /i_load/ber_counter_rd_en_sync/
        /i_data/i_ber_counter/
        /o_data/l_ber_counter/
        /o_next_data/open/
      )

      /o_ber_counter/ios_ber_1_counter_read_value/
      (?rtl:lte_dif_2to1_flop  -dw_g=16
        /clk/dif_104_clk/
        /rst_n/dif_rst_n/
        /i_load/ber_counter_rd_en_ack/
        /i_data/l_ber_counter/
        /o_data/o_ber_counter/
        /o_next_data/open/
      )

      ber_counter_valid>                /ber_counter_valid/ios_ber_1_counter_valid/

      +endtop=move_port_2signal#ber_counter_valid_n    +declarch=decl_signal_from_port
      +beginarch=assign_add#{ber_counter_valid:first_rd_seen AND NOT ber_counter_valid_n}
      (?rtl:lte_dif_toggle     -tw_g=2  :ber_counter_valid
       /clk/dif_104_clk/
       /^rst_n/dif_rst_n/
       /s_rst_n/global_start/
       "/trig/{ber_counter_rd_en ber_counter_rd_en_ack}/"
       /prev_toggle/ber_counter_valid_n/
       /toggle$/open/
      )

      +endtop=move_port_2signal#first_rd_seen
      +beginarch=assign_add#{nxt_first_rd_seen:first_rd_seen OR ber_counter_rd_en}
      (?rtl:lte_dif_flop_1b             
        /clk/dif_104_clk/
        /^rst_n/dif_rst_n/
        /s_rst_n/global_start/
        /di/nxt_first_rd_seen/    
        /do/first_rd_seen/
      )

      ber_recv_error      /^ber_recv_error$/ber_1_recv_error/

      (?rtl:lte_dif_ghmux_wd  -wc_g=3 -dw_g=1  :berror_mux
        "/di/{0b0 0b1 ber_recv_error_seen[0]}/"
        "/sel/{l_ber_recv_error_clr ber_recv_error}/"
        /hmux_o/nxt_ber_recv_error_seen/
      )

      /global_start_rx_sync/global_start_rx_1_sync/

      +endtop=move_port_2signal#ber_recv_error_seen
      (?rtl:lte_dif_flop     -iosz_g=1  
        /clk/rx_clk/
        /^rst_n/rx_rst_n/
        /s_rst_n/global_start_rx_sync/
        /di/nxt_ber_recv_error_seen/   
        /do/ber_recv_error_seen/
      )

      /o_ber_recv_error/ios_ber_1_recv_error/    ; # LEVEL
      (?rtl:sync_s  :ber_recv_error
       /clk/dif_104_clk/
       /rst_n/dif_rst_n/
       /test_en/dft_ctrl_in[?dft_ctrl_sync_bypass_c]/
       /async_signal/ber_recv_error_seen[0]/
       /synced_signal/o_ber_recv_error/
      )

      /ber_recv_error_clr/ios_ber_1_recv_error_clr/
      (?rtl:lte_dif_pulsync
        /in_clk/dif_104_clk/
        /in_rst_n/dif_rst_n/
        /out_clk/rx_clk/
        /out_rst_n/rx_rst_n/
        /pulsin/ber_recv_error_clr/
        /pulsout/l_ber_recv_error_clr/
      )
     )
     
     (?top:lte_dif_ios_ber_asyncread
      /ber_counter_rd_en/ber_2_counter_rd_en/
      /rx_clk/rx_2_clk/
      /rx_rst_n/rx_2_rst_n/
      /i_ber_counter/ber_2_counter/
      /o_ber_counter/ios_ber_2_counter_read_value/
      /ber_counter_valid/ios_ber_2_counter_valid/
      /^ber_recv_error$/ber_2_recv_error/
      /global_start_rx_sync/global_start_rx_2_sync/
      /o_ber_recv_error/ios_ber_2_recv_error/           ; # LEVEL RO
      /ber_recv_error_clr/ios_ber_2_recv_error_clr/     ; # PULSE WOP
     )
    )
   )




   (?top:lte_dif_phyconf    ; #ports

     clk      /clk/dif_104_clk/
     rst_n    /^rst_n/dif_rst_n/
     s_rst_n  /s_rst_n/global_start/

     ; # From ICU
     phy_write_access_start
     phy_register_write_addr<8
     phy_write_data<16

     phy_read_access_start     /phy_read_access_start/phy_register_read_addr_wr_strb/
     phy_register_read_addr<8
     phy_read_data>16
     phy_read_data_valid>      /phy_read_data_valid/phy_register_read_data_vld/

     (?rtl:lte_dif_gfifo -wc_g=8 -dw_g=24 -aw_g=4  :wqueue
       /wr/phy_write_access_start/
       "/wdata/{phy_register_write_addr, phy_write_data}/"
       /rd$/wqueue_rd/
       /rdata/wqueue_rdata/
       /^full/open/
       /valid/wqueue_valid/
       /^empty/open/
       /a_full$/open/
       /a_empty$/open/
       /thres/4'0/
     )

     (?rtl:lte_dif_gfifo -wc_g=3 -dw_g=8 -aw_g=2  :rqueue
       /wr/phy_read_access_start/
       /wdata/phy_register_read_addr/
       /rd$/rqueue_rd/
       /rdata/apb_read_addr/
       /^full/open/
       /valid/rqueue_valid/
       /^empty/open/
       /a_full$/open/
       /a_empty$/open/
       /thres/2'0/
     )

     (?rtl:lte_dif_rrobin_arb  -rc_g=2  -ridw_g=1  :phyconf_rrobin
       {/req_i$/{wqueue_valid, rqueue_valid}/}
       {/req_i_ack/{wqueue_rd, rqueue_rd}/}
       /req_o$/apb_rq/
       /req_o_ack/apb_ack/
       /req_id/apb_rq_id/
     )


     presetn>=0b1
     paddr>8
     psel>
     penable>
     pwrite>
     pwdata>16
     pready
     prdata<16

     (?fsmc: lte_dif_pmaster
      /apb_wrn/apb_rq_id[0]/
      /apb_waddr/wqueue_rdata[23:16]/
      /apb_wdata/wqueue_rdata[15:0]/
      /apb_rdata/phy_read_data/
      /apb_rvalid/phy_read_data_valid/
      /const_8b0/8'0/
      /const_16b0/16'0/
     )
   )
 )
)


(?fsm:lte_dif_pmaster

(idle (<s_rst_n

   (<apb_rq
     (psel    <- 1)
     (penable <- 0)
     (pwrite> <- apb_wrn)

     (?apb_wrn
      (=0  (paddr'8 <- apb_read_addr))
      (=1  (paddr   <- apb_waddr) (pwdata'16 <- apb_wdata))
     )

     (apb_ack = 1)
     (-> setup)
   )
  )
 )

 (setup  (<s_rst_n
   (penable <- 1)
   (-> end_write  <pwrite)
   (-> end_read   <!pwrite)
  )
 )


 (end_write (<s_rst_n
   (<pready

     (penable <- 0)

     (<apb_rq
       (pwrite>  <- apb_wrn)

       (?apb_wrn
        (=0  (paddr <- apb_read_addr))
        (=1  (paddr <- apb_waddr) (pwdata <- apb_wdata))
       )

       (apb_ack = 1)
       (-> setup)
     )

     (<!apb_rq
       (psel    <- 0)
       (-> idle)
     )
   )
  )
 )


 (end_read (<s_rst_n
   (<pready

     (penable <- 0)

     (<apb_rq
       (pwrite>  <- apb_wrn)

       (?apb_wrn
        (=0  (paddr <- apb_read_addr))
        (=1  (paddr <- apb_waddr) (pwdata <- apb_wdata))
       )

       (apb_ack = 1)
       (-> setup)
     )

     (<!apb_rq
       (psel    <- 0)
       (-> idle)
     )


     (apb_rdata'16 <- prdata)
     (apb_rvalid> <- 1)
   )
  )
 )

 (-syncreset (<!s_rst_n
   (psel       <- 0)
   (penable    <- 0)
   (pwrite     <- 0)
   (paddr'8    <- const_8b0)
   (pwdata'16  <- const_16b0)
   (-> idle)
  )
 )

 (-clr_valid    (apb_rvalid <- 0 <apb_rvalid))
)


; # (?top:lte_dif_cmif  +cclausearch=specific_context_clause#cmc_interface_lib
; #
; #  (?rtl:cmc_interface
; #
; #   -cmi_width_g=64
; #   -number_rd_fifo_g=6
; #   -fifo_depth_rd_g=128
; #
; #   -number_wr_fifo_g=9
; #   -fifo_depth_wr_g=128
; #
; #   /clk/dif_104_clk/
; #   /rst_n/dif_rst_n/
; #
; #   /cmi_cm_rdy/cm_dif_rdy/
; #   /cmi_cm_rqst/dif_cm_rqst/
; #   /cmi_cm_wr$/dif_cm_wr/
; #   /cmi_cm_wr_data/dif_cm_wr_data/
; #   /cmi_cm_rd_data/cm_dif_rd_data/
; #
; #   =cmi_rd_fifo_mem_raddr>42
; #   =cmi_rd_fifo_mem_waddr>42
; #   =cmi_wr_fifo_mem_raddr>63
; #   =cmi_wr_fifo_mem_waddr>63
; #   =cmi_burst_size_wr<63
; #   =cmi_burst_size_rd<42
; #   =cmi_fifo_counter_rd>42
; #   =cmi_fifo_counter_wr>63
; #  )
; # )

(?top:lte_dif_buffers  +endtop=move_port_2signal#{lte_dif_.+_mem_(?:in|out)}
                       +declarch=decl_signal_from_port
		       +endarch=add_mem_io_assigns#pcsally_mem


 lte_dif_mem_in<:lte_dif_mem_in_t
 lte_dif_mem_out>:lte_dif_mem_out_t

 cmi_rd_fifo_mem_rdata>384
 cmi_rd_fifo_mem_wdata<384
 cmi_rd_fifo_mem_raddr<42
 cmi_rd_fifo_mem_waddr<42
 cmi_rd_fifo_mem_en_n<6
 cmi_rd_fifo_mem_wr_n<6

 cmi_wr_fifo_mem_rdata>576
 cmi_wr_fifo_mem_wdata<576
 cmi_wr_fifo_mem_raddr<63
 cmi_wr_fifo_mem_waddr<63
 cmi_wr_fifo_mem_en_n<9
 cmi_wr_fifo_mem_wr_n<9


 ; # W : 0  - RXDU1 (0)
 ; # W : 1  - RXDU2 (1)
 ; # W : 2  - RXDU3 (2)
 (?rtl:lte_dif_cmi3_tpram_word_128x64x3
   /mem_wdata_1/cmi_wr_fifo_mem_wdata[63:0]/      ; # IN  STD_LOGIC_VECTOR(63 DOWNTO 0);
   /mem_wdata_2/cmi_wr_fifo_mem_wdata[127:64]/    ; # IN  STD_LOGIC_VECTOR(63 DOWNTO 0);
   /mem_wdata_3/cmi_wr_fifo_mem_wdata[191:128]/   ; # IN  STD_LOGIC_VECTOR(63 DOWNTO 0);
   /wmem_addr_1/cmi_wr_fifo_mem_waddr[6:0]/       ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /wmem_addr_2/cmi_wr_fifo_mem_waddr[13:7]/      ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /wmem_addr_3/cmi_wr_fifo_mem_waddr[20:14]/     ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /rmem_addr_1/cmi_wr_fifo_mem_raddr[6:0]/       ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /rmem_addr_2/cmi_wr_fifo_mem_raddr[13:7]/      ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /rmem_addr_3/cmi_wr_fifo_mem_raddr[20:14]/     ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /mem_wr_n_1/cmi_wr_fifo_mem_wr_n[0]/           ; # IN  STD_LOGIC;
   /mem_wr_n_2/cmi_wr_fifo_mem_wr_n[1]/           ; # IN  STD_LOGIC;
   /mem_wr_n_3/cmi_wr_fifo_mem_wr_n[2]/           ; # IN  STD_LOGIC;
   /wmem_en_n_1/cmi_wr_fifo_mem_en_n[0]/          ; # IN  STD_LOGIC;
   /wmem_en_n_2/cmi_wr_fifo_mem_en_n[1]/          ; # IN  STD_LOGIC;
   /wmem_en_n_3/cmi_wr_fifo_mem_en_n[2]/          ; # IN  STD_LOGIC;
   /rmem_en_n_1/cmi_wr_fifo_mem_en_n[0]/          ; # IN  STD_LOGIC;
   /rmem_en_n_2/cmi_wr_fifo_mem_en_n[1]/          ; # IN  STD_LOGIC;
   /rmem_en_n_3/cmi_wr_fifo_mem_en_n[2]/          ; # IN  STD_LOGIC;
   /mem_clk$/ph_ram_cmrw_1_clk/                   ; # IN  STD_LOGIC; ----------------------------> BIST CLOCK
   /mem_clk_1/ph_ram_cmrw_1_clk/                  ; # IN  STD_LOGIC;
   /mem_clk_2/ph_ram_cmrw_2_clk/                  ; # IN  STD_LOGIC;
   /mem_clk_3/ph_ram_cmrw_3_clk/                  ; # IN  STD_LOGIC;
   /mem_rdata_1/cmi_wr_fifo_mem_rdata[63:0]/      ; # OUT STD_LOGIC_VECTOR(63 DOWNTO 0);
   /mem_rdata_2/cmi_wr_fifo_mem_rdata[127:64]/    ; # OUT STD_LOGIC_VECTOR(63 DOWNTO 0);
   /mem_rdata_3/cmi_wr_fifo_mem_rdata[191:128]/   ; # OUT STD_LOGIC_VECTOR(63 DOWNTO 0);

   /lte_dif_cmi3_mem_in/lte_dif_cmi3_0_mem_in/
   /lte_dif_cmi3_mem_out/lte_dif_cmi3_0_mem_out/
 )


 ; # W : 0  - RXDU4 (3)
 ; # W : 1  - RSPU  (4)
 ; # W : 2  - IOSW  (5)
 (?rtl:lte_dif_cmi3_tpram_word_128x64x3
   /mem_wdata_1/cmi_wr_fifo_mem_wdata[255:192]/   ; # IN  STD_LOGIC_VECTOR(63 DOWNTO 0);
   /mem_wdata_2/cmi_wr_fifo_mem_wdata[319:256]/   ; # IN  STD_LOGIC_VECTOR(63 DOWNTO 0);
   /mem_wdata_3/cmi_wr_fifo_mem_wdata[383:320]/   ; # IN  STD_LOGIC_VECTOR(63 DOWNTO 0);
   /wmem_addr_1/cmi_wr_fifo_mem_waddr[27:21]/     ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /wmem_addr_2/cmi_wr_fifo_mem_waddr[34:28]/     ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /wmem_addr_3/cmi_wr_fifo_mem_waddr[41:35]/     ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /rmem_addr_1/cmi_wr_fifo_mem_raddr[27:21]/     ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /rmem_addr_2/cmi_wr_fifo_mem_raddr[34:28]/     ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /rmem_addr_3/cmi_wr_fifo_mem_raddr[41:35]/     ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /mem_wr_n_1/cmi_wr_fifo_mem_wr_n[3]/           ; # IN  STD_LOGIC;
   /mem_wr_n_2/cmi_wr_fifo_mem_wr_n[4]/           ; # IN  STD_LOGIC;
   /mem_wr_n_3/cmi_wr_fifo_mem_wr_n[5]/           ; # IN  STD_LOGIC;
   /wmem_en_n_1/cmi_wr_fifo_mem_en_n[3]/          ; # IN  STD_LOGIC;
   /wmem_en_n_2/cmi_wr_fifo_mem_en_n[4]/          ; # IN  STD_LOGIC;
   /wmem_en_n_3/cmi_wr_fifo_mem_en_n[5]/          ; # IN  STD_LOGIC;
   /rmem_en_n_1/cmi_wr_fifo_mem_en_n[3]/          ; # IN  STD_LOGIC;
   /rmem_en_n_2/cmi_wr_fifo_mem_en_n[4]/          ; # IN  STD_LOGIC;
   /rmem_en_n_3/cmi_wr_fifo_mem_en_n[5]/          ; # IN  STD_LOGIC;
   /mem_clk$/ph_ram_cmrw_4_clk/                   ; # IN  STD_LOGIC; -----------------------> BIST CLOCK
   /mem_clk_1/ph_ram_cmrw_4_clk/                  ; # IN  STD_LOGIC;
   /mem_clk_2/ph_ram_cmrw_5_clk/                  ; # IN  STD_LOGIC;
   /mem_clk_3/ph_ram_cmrw_6_clk/                  ; # IN  STD_LOGIC;
   /mem_rdata_1/cmi_wr_fifo_mem_rdata[255:192]/   ; # OUT STD_LOGIC_VECTOR(63 DOWNTO 0);
   /mem_rdata_2/cmi_wr_fifo_mem_rdata[319:256]/   ; # OUT STD_LOGIC_VECTOR(63 DOWNTO 0);
   /mem_rdata_3/cmi_wr_fifo_mem_rdata[383:320]/   ; # OUT STD_LOGIC_VECTOR(63 DOWNTO 0);

   /lte_dif_cmi3_mem_in/lte_dif_cmi3_1_mem_in/
   /lte_dif_cmi3_mem_out/lte_dif_cmi3_1_mem_out/
 )

 ; # W : 0  - PPIMON1 (6)
 ; # W : 1  - PPIMON2 (7)
 ; # W : 2  - PPIMON3 (8)
 (?rtl:lte_dif_cmi3_tpram_word_128x64x3
   /mem_wdata_1/cmi_wr_fifo_mem_wdata[447:384]/    ; # IN  STD_LOGIC_VECTOR(63 DOWNTO 0);
   /mem_wdata_2/cmi_wr_fifo_mem_wdata[511:448]/    ; # IN  STD_LOGIC_VECTOR(63 DOWNTO 0);
   /mem_wdata_3/cmi_wr_fifo_mem_wdata[575:512]/    ; # IN  STD_LOGIC_VECTOR(63 DOWNTO 0);
   /wmem_addr_1/cmi_wr_fifo_mem_waddr[48:42]/      ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /wmem_addr_2/cmi_wr_fifo_mem_waddr[55:49]/      ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /wmem_addr_3/cmi_wr_fifo_mem_waddr[62:56]/      ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /rmem_addr_1/cmi_wr_fifo_mem_raddr[48:42]/      ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /rmem_addr_2/cmi_wr_fifo_mem_raddr[55:49]/      ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /rmem_addr_3/cmi_wr_fifo_mem_raddr[62:56]/      ; # IN  STD_LOGIC_VECTOR(6 DOWNTO 0);
   /mem_wr_n_1/cmi_wr_fifo_mem_wr_n[6]/            ; # IN  STD_LOGIC;
   /mem_wr_n_2/cmi_wr_fifo_mem_wr_n[7]/            ; # IN  STD_LOGIC;
   /mem_wr_n_3/cmi_wr_fifo_mem_wr_n[8]/            ; # IN  STD_LOGIC;
   /wmem_en_n_1/cmi_wr_fifo_mem_en_n[6]/           ; # IN  STD_LOGIC;
   /wmem_en_n_2/cmi_wr_fifo_mem_en_n[7]/           ; # IN  STD_LOGIC;
   /wmem_en_n_3/cmi_wr_fifo_mem_en_n[8]/           ; # IN  STD_LOGIC;
   /rmem_en_n_1/cmi_wr_fifo_mem_en_n[6]/           ; # IN  STD_LOGIC;
