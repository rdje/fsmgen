      ber_2_recv_synchronized   ; * SLOW  # OUT STD_LOGIC;                                   -- Receiver synchronized
      ber_2_recv_error          ; * FAST  # OUT STD_LOGIC;                                   -- Receiver Error
      ber_2_counter_load_en>    ; * PULSE # IN STD_LOGIC;                                    -- Preload BER-counter (data_in)
      ber_2_counter_rst_en>     ; * PULSE # IN STD_LOGIC;                                    -- Reset BER-counter
      ber_2_counter<16          ; * FAST  # OUT STD_LOGIC_VECTOR ((ber_with_c-1) DOWNTO 0);  -- BER-Counter output
      ber_2_overflow            ; * SLOW  # OUT STD_LOGIC                                    -- BER Overflow output


