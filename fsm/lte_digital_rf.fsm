; #     (<retx_ena
; # 
; #      ; # (retx_dis     <- 1)
; #      (retx_ack     <- 0  <(| retx_req retx_rq_id=0 retx_frm_type retx_frm_lcid=000))
; #      (retx_frzmask <- 0  <retx_brq)
; # 
; #      (retx_frm_info_rd <= 0)
; # 
; #      (-> dummy)
; # 
; #     )
; #   )
; # 
; #  )
; # 
; # 
; #  (dummy  (-> dummy))
; # 
; # 
