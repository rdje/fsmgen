(?top:lte_dif_icu
  clk
  rst_n
  s_rst_n


  icu_ccmd_port_1<16
  icu_ccmd_port_1_wr_strb
  icu_ccmd_port_2<16
  icu_ccmd_port_2_wr_strb
  icu_ccmd_port_3<16
  icu_ccmd_port_3_wr_strb
  icu_ccmd_port_4<16
  icu_ccmd_port_4_wr_strb

  icu_req>
  icu_pl_data>16

  dig_pwr_en>
  dig_rst_n>
  ana_pwr_en>
  sys_clk_en>
  txon>
  digrf_en>

  tg_timestamp<19

  phy_write_access_start>
  phy_register_write_addr>8
  phy_write_data>16

  ; ### (?rtl:lte_dif_stream_adapter_m_le_n  :icu_pack_16_to_48
  ; ###   -m_imax_g=16                                       ; # -- Max input  stream bit-width (M)
  ; ###   -m_imin_g=16                                       ; # -- Min input  stream bit-width (M)
  ; ###   -n_omax_g=48                                       ; # -- Max output stream bit-width (N)
  ; ###   -n_omin_g=48                                       ; # -- Min output stream bit-width (N)
  ; ###   -msb_2lsb_g=0                                      ; # -- 1= Enables MSB to LSB translation 0= Disables it
  ; ###   -rt_ssibw_g=6                                      ; # -- Runtime stream size indicators bit-width (m)

  ; ###   /m_iss/6'16/                                       ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
  ; ###   /n_oss/6'48/                                       ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
  ; ###   /i_data/icu_ccmd_port/                             ; # IN  STD_LOGIC_VECTOR (m_imax_g-1 DOWNTO 0);
  ; ###   /i_valid/icu_ccmd_port_wr_strb/                    ; # IN  STD_LOGIC;
  ; ###   /i_last/0b0/                                       ; # IN  STD_LOGIC;
  ; ###   /i_next_o/open/                                    ; # OUT STD_LOGIC;
  ; ###   /o_data/pack_16_to_48_o_data/                      ; # OUT STD_LOGIC_VECTOR (n_omax_g-1 DOWNTO 0);
  ; ###   /o_valid/pack_16_to_48_o_valid/                    ; # OUT STD_LOGIC;
  ; ###   /o_last/open/                                      ; # OUT STD_LOGIC;
  ; ###   /o_stall_i/icc_queue_full/                         ; # IN  STD_LOGIC
  ; ### )

  icu_ccmd_port_wr>
  +endtop=move_port_2signal#icu_ccmd_port_wr   +declarch=decl_signal_from_port
  +beginarch=assign_add#{icu_ccmd_port_wr:icu_ccmd_port_4_wr_strb AND icu_ccmd_port_3_wr_strb AND icu_ccmd_port_2_wr_strb AND icu_ccmd_port_1_wr_strb}
  (?rtl:lte_dif_gfifo -wc_g=16 -dw_g=64 -aw_g=3  :icc_queue
    /wr/icu_ccmd_port_wr/
    "/wdata/{icu_ccmd_port_4 icu_ccmd_port_3 icu_ccmd_port_2 icu_ccmd_port_1}/"
    /rd$/icc_queue_rd/
    /rdata/icc_queue_rdata/
    /^full/open/
    /valid/icc_queue_valid/
    /^empty/open/
    /a_full$/open/
    /a_empty$/open/
    /thres/3'0/
  )

  (?top:lte_dif_icc_exec
    clk
    rst_n
    s_rst_n

    icc_queue_valid
    icc_queue_rdata<64
    icc_queue_rd>      +beginarch=assign_add#icc_queue_rd:icc_exec_on

    tg_timestamp<19

    phy_write_access_start>      +beginarch=assign_add#{phy_write_access_start:icc_action_decod (1)}
    phy_register_write_addr>8    +beginarch=assign_add#{phy_register_write_addr:icc_queue_rdata (23 DOWNTO 16)}
    phy_write_data>16            +beginarch=assign_add#{phy_write_data:icc_queue_rdata (15 DOWNTO 0)}


    icu_req>
    icu_pl_data>16

    icc_exec_on>
    g_ts_match>
    ts_match>
    ts_match_rise>
    icc_tsi>
    icc_type>2
    iclc_payload>16
    +endtop=move_port_2signal#icc_exec_on#ts_match#icc_tsi#icc_type#iclc_payload   +declarch=decl_signal_from_port
    +beginarch=assign_add#{ts_match:'1'  WHEN icc_queue_rdata (42 DOWNTO 24) = tg_timestamp  ELSE '0'}
    +beginarch=assign_add#{g_ts_match:ts_match_rise OR  NOT icc_tsi}#{icc_exec_on:icc_queue_valid AND g_ts_match}
    +beginarch=assign_add#{icc_tsi:icc_queue_rdata (45)}#{icc_type:icc_queue_rdata (47 DOWNTO 46)}
    +beginarch=assign_add#{iclc_payload:icc_queue_rdata(23 DOWNTO 8)}

    (?rtl:lte_dif_edges
     /sig/ts_match/
     /rise_edge/ts_match_rise/
     /fall_edge/open/
    )

    (?rtl:lte_dif_gdemux -bc_g=3  -sw_g=2  :icc_action_decod
      /bi/icc_exec_on/
      /sel/icc_type/
      /demux_o/icc_action_decod/
    )

    ; # ICLC command
    (?rtl:lte_dif_2to1_flop  -dw_g=16  :icu_pl_data
      /i_load/icc_action_decod[0]/
      /i_data/iclc_payload/
      /o_data/icu_pl_data/
      /o_next_data/open/
    )

    +endtop=move_port_2signal#_icu_req
    +beginarch=assign_add#{i_icu_req(0):icc_action_decod(0)}#{icu_req:o_icu_req(0)}
    (?rtl:lte_dif_flop   -iosz_g=1  :icu_req
     /di/i_icu_req/
     /do/o_icu_req/
    )

    ; # Dedicated External lines
    ext_lines_i_en>6  +beginarch=assign_add#{ext_lines_i_en:icc_queue_rdata (5 DOWNTO 0) AND (5 DOWNTO 0=> icc_action_decod(2))}
    ext_lines_i_v>6
