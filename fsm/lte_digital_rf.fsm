(?top:lte_dif_lcmiq_to_8b

  +endtop=move_port_2signal#txdu_iq_len_p1#pack_1_8_to_8_enable#pack_9_16_to_8_enable#lcmiq_fifo_w#txdu_iq_len_6bit
  +declarch=decl_signal_from_port
  +beginarch=assign_add#{txdu_iq_len_6bit:'0' & txdu_iq_len}
  +beginarch=assign_add#{txdu_iq_len_p1:txdu_iq_len_6bit + '1'}
  +beginarch=assign_add#{txdu_iq_len_p1_le_8:'1'  WHEN  txdu_iq_len_p1  <=  "001000"  ELSE  '0'}
  +beginarch=assign_add#{pack_1_8_to_8_enable:s_rst_n AND     txdu_iq_len_p1_le_8}
  +beginarch=assign_add#{pack_9_16_to_8_enable:s_rst_n AND NOT txdu_iq_len_p1_le_8}
  +beginarch=assign_add#{lcmiq_fifo_wr:le_lcmiq_fifo_wr      WHEN  txdu_iq_len_p1_le_8 = '1'  ELSE  gt_lcmiq_fifo_wr}
  +beginarch=assign_add#{lcmiq_fifo_wdata:le_lcmiq_fifo_wdata    WHEN  txdu_iq_len_p1_le_8 = '1'  ELSE  gt_lcmiq_fifo_wdata}


  txdu_iq_len_6bit>6
  txdu_iq_len<5
  txdu_iq_num<8

  txdu_iq_len_p1_le_8


 ; #  len_p1_le_8_o_i_next>
  +endtop=move_port_2signal#unpack_64_to_16_stall#pack9_16_buf_o_full    ; #len_p1_le_8_o_i_next
  ; # +beginarch=assign_add#{len_p1_le_8_o_i_next:txdu_iq_len_p1_le_8 OR pack_9_16_to_8_i_next}
  +beginarch=assign_add#{unpack_64_to_16_stall:lcmiq_fifo_full WHEN txdu_iq_len_p1_le_8 = '1' ELSE pack9_16_buf_o_full} ; #  NOT len_p1_le_8_o_i_next
  (?rtl:lte_dif_stream_adapter_m_ge_n :unpack_64_to_16
    -m_imax_g=64                       ; # -- Max input  stream bit-width (M)
    -m_imin_g=64                       ; # -- Min input  stream bit-width (M)
    -n_omax_g=16                       ; # -- Max output stream bit-width (N)
    -n_omin_g=16                       ; # -- Min output stream bit-width (N)
    -msb_2lsb_g=1                      ; # -- 1= Enables MSB to LSB translation 0= Disables it
    -rt_ssibw_g=7                      ; # -- Runtime stream size indicators bit-width (m)

    /m_iss/7'64/                       ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /n_oss/7'16/                       ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /i_data/txdu_pl_i_data/            ; # IN  STD_LOGIC_VECTOR (m_imax_g-1 DOWNTO 0);
    /i_valid/txdu_pl_i_valid/          ; # IN  STD_LOGIC;
    /i_last/0b0/                       ; # IN  STD_LOGIC;
    /i_next_o/txdu_pl_i_next_o/        ; # OUT STD_LOGIC;
    /o_data/unpack64_o_data/           ; # OUT STD_LOGIC_VECTOR (n_omax_g-1 DOWNTO 0);
    /o_valid/unpack64_o_valid/         ; # OUT STD_LOGIC;
    /o_last/open/                      ; # OUT STD_LOGIC;
    /o_stall_i/unpack_64_to_16_stall/  ; # IN  STD_LOGIC
  )

  
  +endtop=move_port_2signal#pack_1_8_to_8_i_next_o
  (?rtl:lte_dif_stream_adapter_m_le_n :pack_1_8_to_8
    -m_imax_g=8                      ; # -- Max input  stream bit-width (M)
    -m_imin_g=1                      ; # -- Min input  stream bit-width (M)
    -n_omax_g=8                      ; # -- Max output stream bit-width (N)
    -n_omin_g=8                      ; # -- Min output stream bit-width (N)
    -msb_2lsb_g=1                    ; # -- 1= Enables MSB to LSB translation 0= Disables it
    -rt_ssibw_g=6                    ; # -- Runtime stream size indicators bit-width (m)

    /s_rst_n/pack_1_8_to_8_enable/

    /m_iss/txdu_iq_len_p1/           ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /n_oss/6'8/                      ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /i_data/unpack64_o_data[15:8]/   ; # IN  STD_LOGIC_VECTOR (m_imax_g-1 DOWNTO 0);
    /i_valid/unpack64_o_valid/       ; # IN  STD_LOGIC;
    /i_last/txdu_pl_last_iq/         ; # IN  STD_LOGIC;
    /i_next_o/pack_1_8_to_8_i_next_o/; # OUT STD_LOGIC;
    /o_data/le_lcmiq_fifo_wdata/     ; # OUT STD_LOGIC_VECTOR (n_omax_g-1 DOWNTO 0);
    /o_valid/le_lcmiq_fifo_wr/       ; # OUT STD_LOGIC;
    /o_last/pack_1_8_to_8_o_last/    ; # OUT STD_LOGIC;
    /o_stall_i/lcmiq_fifo_full/      ; # IN  STD_LOGIC
  )

  (?rtl:lte_dif_gfifo  -wc_g=16  -aw_g=5  -dw_g=16 :pack9_16_buf
    /s_rst_n/pack_9_16_to_8_enable/
    /wr/unpack64_o_valid/
    /wdata/unpack64_o_data/
    /rd$/pack_9_16_to_8_i_next/
    /rdata/pack9_16_buf_rdata/
    /^full/pack9_16_buf_o_full/
    /valid/pack9_16_buf_valid/
    /^empty/open/
    /a_full$/open/
    /a_empty$/open/
    /thres/5'0/
  )

  (?rtl:lte_dif_stream_adapter_m_ge_n :pack_9_16_to_8
    -m_imax_g=16                     ; # -- Max input  stream bit-width (M)
    -m_imin_g=9                      ; # -- Min input  stream bit-width (M)
    -n_omax_g=8                      ; # -- Max output stream bit-width (N)
    -n_omin_g=8                      ; # -- Min output stream bit-width (N)
    -msb_2lsb_g=1                    ; # -- 1= Enables MSB to LSB translation 0= Disables it
    -rt_ssibw_g=6                    ; # -- Runtime stream size indicators bit-width (m)

    /s_rst_n/pack_9_16_to_8_enable/

    /m_iss/txdu_iq_len_p1/           ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /n_oss/6'8/                      ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /i_data/pack9_16_buf_rdata/      ; # IN  STD_LOGIC_VECTOR (m_imax_g-1 DOWNTO 0);
    /i_valid/pack9_16_buf_valid/     ; # IN  STD_LOGIC;
    /i_last/txdu_pl_last_iq/         ; # IN  STD_LOGIC;
    /i_next_o/pack_9_16_to_8_i_next/ ; # OUT STD_LOGIC;
    /o_data/gt_lcmiq_fifo_wdata/     ; # OUT STD_LOGIC_VECTOR (n_omax_g-1 DOWNTO 0);
    /o_valid/gt_lcmiq_fifo_wr/       ; # OUT STD_LOGIC;
    /o_last/pack_9_16_to_8_o_last/   ; # OUT STD_LOGIC;
    /o_stall_i/lcmiq_fifo_full/      ; # IN  STD_LOGIC
  )

  
  lcmiq_last_iq_valid>
  lcmiq_last_iq_incen>
  lcmiq_last_iq_next_o>
  ; # txdu_iq_num 0=1 pair 1=2 pairs  ... FF=256 pairs
  clear_last_iq_counter_n>
  txdu_iq_num_x2>9      +beginarch=assign_add#{txdu_iq_num_x2:txdu_iq_num & '0'}
  txdu_iq_num_x2_p1>9   +beginarch=assign_add#{txdu_iq_num_x2_p1:txdu_iq_num_x2 + '1'}
  txdu_iq_num_x2_p2>9   +beginarch=assign_add#{txdu_iq_num_x2_p2:txdu_iq_num_x2_p1 + '1'}
  +endtop=move_port_2signal#txdu_pl_last_iq#txdu_iq_num_x2#lcmiq_last_iq_valid#lcmiq_last_iq_incen#lcmiq_last_iq_next_o#last_iq_counter
  +endtop=move_port_2signal#clear_last_iq_counter_n
  +beginarch=assign_add#{lcmiq_last_iq_valid:unpack64_o_valid WHEN txdu_iq_len_p1_le_8 = '1' ELSE pack9_16_buf_valid}
  +beginarch=assign_add#{lcmiq_last_iq_next_o:pack_1_8_to_8_i_next_o WHEN txdu_iq_len_p1_le_8 = '1' ELSE pack_9_16_to_8_i_next}
  +beginarch=assign_add#{lcmiq_last_iq_incen:lcmiq_last_iq_valid AND lcmiq_last_iq_next_o}
  +beginarch=assign_add#{clear_last_iq_counter_n:NOT txdu_i_last}
  ; # (?fsmc: lte_dif_lcmiq_last
  ; #  /iq_valid/lte_dif_lcmiq_last_iq_valid/    ; # Was unpack64_o_valid
  ; #  /iq_dec/lte_dif_lcmiq_last_iq_dec/        ; # Was unpack64_o_valid
  ; #  /i_o_q_count_minus_1/txdu_iq_num_x2_p1/
  ; #  ; # /freeze/lcmiq_fifo_full/
  ; #  /last_iq/txdu_pl_last_iq/
  ; # )
  (?rtl:lte_dif_counter_pk_mod_m -dw_g=9    :last_iq_counter
    /s_rst_n/clear_last_iq_counter_n/
    /incen/lcmiq_last_iq_incen/  ; # IN  STD_LOGIC;
    /incr_k/9'1/                 ; # IN  STD_LOGIC_VECTOR(dw_g-1 DOWNTO 0);
    /mod_m/txdu_iq_num_x2_p2/    ; # IN  STD_LOGIC_VECTOR(dw_g-1 DOWNTO 0);
    /counter_o/last_iq_counter/  ; # OUT STD_LOGIC_VECTOR(dw_g-1 DOWNTO 0);
    /wrap_o/open/                ; # OUT STD_LOGIC
  )

  +beginarch=assign_add#{txdu_pl_last_iq:'1' WHEN last_iq_counter = txdu_iq_num_x2_p1 ELSE '0'}


  txdu_pl_o_last>
  txdu_pl_o_data>8

  txdu_i_last>
  lcmiq_fifo_wdata>8
  +endtop=move_port_2signal#txdu_i_last#pack_1_8_to_8_o_last#pack_9_16_to_8_o_last
  +beginarch=assign_add#{txdu_i_last:pack_1_8_to_8_o_last WHEN txdu_iq_len_p1_le_8 = '1' ELSE pack_9_16_to_8_o_last}
  (?rtl:lte_dif_gfifo  -wc_g=48  -aw_g=6  -dw_g=9  ; # 8-bit of DATA and 1 MSB bit of LAST indication
    /wr/lcmiq_fifo_wr/
    "/wdata/{txdu_i_last, lcmiq_fifo_wdata}/"
    /rd$/txdu_pl_o_next_i/
    "/rdata/{txdu_pl_o_last, txdu_pl_o_data}/"
    /^full/lcmiq_fifo_full/
    /valid/txdu_pl_o_valid/
    /^empty/open/
    /a_full$/open/
    /a_empty$/open/
    /thres/6'0/
  )

)


; # iq_valid
; # last_iq>
(?fsm:lte_dif_lcmiq_last
 (+size 
   (i_o_q_count_minus_1 9)
   (l_counter           9) 
 )

 (idle (<s_rst_n
   (<(& iq_valid iq_dec)
      (l_counter <- i_o_q_count_minus_1)
      (-> wait_4last)
     ; # (?i_o_q_count_minus_1
     ; #   (>8'0  (l_counter <- i_o_q_count_minus_1) 
     ; #          (-> wait_4last)
     ; #   )
     ; #   
     ; #   (=8'0  (last_iq = 1))
     ; # )
   )
  )
 )

 (wait_4last  (<s_rst_n
  (<(& iq_valid iq_dec)
   (?l_counter
    (!=9'0  (-- l_counter))
    ( =9'1  (last_iq = 1)
            (-> idle)
    )
   )
  )
  )
 )

  
 (-syncrst (<!s_rst_n
   (l_counter <- 9'0)
   (-> idle)
  )
 )
)






(?top:lte_dif_rfcu_afifo_to_8b

  (?rtl:lte_dif_stream_adapter_m_ge_n :unpack_32_to_8
