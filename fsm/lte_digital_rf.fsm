    (?top:lte_dif_ber_data_sync
      ber_1_loop_test_en>       ; * LEVEL # IN  STD_LOGIC;                                   -- Enable internal test loop
      ber_1_load_value>32       ; * 32b   # IN  STD_LOGIC_VECTOR ((data_with_c-1) DOWNTO 0); -- Data input for Loadable Start value
      ber_1_gen_load_en>        ; * PULSE # IN  STD_LOGIC;                                   -- Load Generator Start value (data_in)
      ber_1_generator_en>       ; * LEVEL # IN  STD_LOGIC;                                   -- Enable Generator
      ber_1_receiver_en>        ; * LEVEL # IN  STD_LOGIC;                                   -- Enable Receiver
      ber_1_recv_force_sync_en> ; * PULSE # IN  STD_LOGIC;                                   -- Receiver Force Synchronisation after beeing '1'
      ber_1_recv_synchronized   ; * SLOW  # OUT STD_LOGIC;                                   -- Receiver synchronized
      ber_1_recv_error          ; * FAST  # OUT STD_LOGIC;                                   -- Receiver Error
      ber_1_counter_load_en>    ; * PULSE # IN STD_LOGIC;                                    -- Preload BER-counter (data_in)
      ber_1_counter_rst_en>     ; * PULSE # IN STD_LOGIC;                                    -- Reset BER-counter
      ber_1_counter<16          ; * FAST  # OUT STD_LOGIC_VECTOR ((ber_with_c-1) DOWNTO 0);  -- BER-Counter output
      ber_1_overflow            ; * SLOW  # OUT STD_LOGIC                                    -- BER Overflow output

