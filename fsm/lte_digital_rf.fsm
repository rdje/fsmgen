; # (?top:lte_dif_rrobin_wrapper
; #  (?fsmc: lte_dif_rrobin_ctrl)
; # )
; # 
(?fsm:lte_dif_rrobin_ctrl
 (idle (<s_rst_n
   (<req
     (load_req_info  = 1)
     (-> wait_4ack)
   )
  )
 )

 (wait_4ack (<s_rst_n
   (-> idle  <ack)
  )
 )
 
 (-syncrst  (<!s_rst_n
   (-> idle)
  )
 )
)


; # ---------------------------------------------------------------------------------------------------------
; # --
; # --             Example of sequence of FSMGEN related commands
; # --
; # ---------------------------------------------------------------------------------------------------------
; ##    fsmgen   -rtl vhdl_compile.db                          \
; ##             -rtl iosocket.db                              \
; ##             -add common_cidl_lib.lte_cidl_common_pkg      \
; ##             -add lte_digital_rf_lib.lte_dif_iosocket_pkg  \
; ##             -add emp_common_lib.emp_dft_pkg               \
; ##             -add lte_digital_rf_lib.lte_dif_mem_pkg       \
; ##             -header ericsson_header.txt                   \
; ##             ~/project/fsm/afx/fx/fsm/lte_digital_rf.fsm
; ##
; ##
; ##    fxstart check4diff /dsync/ws_z0/qdjeric/lte/z0_lte_digital_rf/model/rtl
; ##
; ##    fxstart vhdl_compile components Wrappers CIDL_OUT/ win_cidl_iosocket_data  -o vc_lte_digital_rf.db
; ##    fxstart xdep_2ss   vc_lte_digital_rf.db vhdl_compile.db  -x ~/z0_lte_digital_rf_xdep_2ss.xls
; ##    fxstart entity_2ss vc_lte_digital_rf.db vhdl_compile.db  -x ~/z0_lte_digital_rf_entity_2ss.xls
; # ---------------------------------------------------------------------------------------------------------

