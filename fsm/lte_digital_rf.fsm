    /a_empty$/open/
    /thres/3'0/
  )

  +endtop=move_port_2signal#tasts_eq_tgts#tas_queue_rdata
  +beginarch=assign_add#{tasts_eq_tgts:tas_queue_valid  WHEN tas_queue_rdata (26 DOWNTO 8) = tg_timestamp  ELSE  '0'}

  (?rtl:lte_dif_flop_1b
   /di/tasts_eq_tgts/
   /do/tasts_eq_tgts_r/
  )

  +beginarch=assign_add#{l_tasu_send:tasts_eq_tgts AND NOT tasts_eq_tgts_r}
)




(?top:lte_dif_txdu

 ; # The two registers below are for giving extra marging when doing synthesis.
 ; # The start and end address parameters are quasi-static so flopping them once or even
 ; # twice won't change anything regarding the overall functionality
 (?rtl:lte_dif_flop     -iosz_g=20  :txdu_start_addr 
   /s_rst_n/txdu_enable/
   /di/txdu_start_addr/     
   /do/txdu_start_addr_r/
 )

 (?rtl:lte_dif_flop     -iosz_g=20  :txdu_end_addr 
   /s_rst_n/txdu_enable/
   /di/txdu_end_addr/     
   /do/txdu_end_addr_r/
 )

 (?top:lte_dif_txdu_drcv  ; #ports
   clk
   rst_n
   s_rst_n /s_rst_n/txdu_drcv_en/

   txdu_start_addr<20   /txdu_start_addr/txdu_start_addr_r/
   txdu_cur_addr>20
   txdu_end_addr<20     /txdu_end_addr/txdu_end_addr_r/
   txdu_lcm_burst_size<7

   cmi_txdu_rd_ready
   txdu_cmi_burst_rd_req>
   txdu_cmi_fifo_rd>
   cmi_txdu_fifo_empty
   txdu_cmi_burst_len_n_addr>64
   txdu_cmi_burst_size_rd>7
   txdu_cmi_last_word_rd>
   txdu_cmi_infinite_rd>
   txdu_cmi_bypass_rd>
   txdu_cmi_flush_rd>

   cmi_txdu_fifo_rdata<64

   txdu_fifo_full
   txdu_fifo_afull
   txdu_fifo_wr>
   txdu_fifo_afull_thres>8  +beginarch=assign_add#{txdu_fifo_afull_thres:txdu_lcm_burst_size_8b - '1'}
   txdu_fifo_wdata>64       +beginarch=assign_add#txdu_fifo_wdata:cmi_txdu_fifo_rdata

   txdu_lcm_burst_size_8b>8
   +endtop=move_port_2signal#txdu_lcm_burst_size_8b  +declarch=decl_signal_from_port
   +beginarch=assign_add#{txdu_lcm_burst_size_8b:'0' & txdu_lcm_burst_size}


   (?toplink:lte_dif_cmi_read
     /cmi_rd_ready/cmi_txdu_rd_ready/
     /cmi_burst_rd_req/txdu_cmi_burst_rd_req/
     /cmi_fifo_rd/txdu_cmi_fifo_rd/
     /cmi_fifo_empty/cmi_txdu_fifo_empty/

     /cmi_burst_len_n_addr/txdu_cmi_burst_len_n_addr/
     /cmi_burst_size_rd/txdu_cmi_burst_size_rd/
     /cmi_last_word_rd/txdu_cmi_last_word_rd/
     /cmi_infinite_rd/txdu_cmi_infinite_rd/
     /cmi_bypass_rd/txdu_cmi_bypass_rd/
     /cmi_flush_rd/txdu_cmi_flush_rd/

     /read_req/txdu_cm_read_rq/
     /read_ack/txdu_cm_read_ack/
     /burst_done/txdu_cm_burst_done/
     /rdata_valid/txdu_fifo_wr/
     /read_stop/0b0/   ; # FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME
     /read_wrap/open/

     /lcm_burst_size/txdu_lcm_burst_size/
     /lcm_length/16'0/
     /lcm_start_addr/txdu_start_addr/
     /lcm_end_addr/txdu_end_addr/
     /lcm_cur_addr/txdu_cur_addr/
   )

   (?fsmc: lte_dif_txdu_burst_fe)
 )

 (?rtl:lte_dif_edges            :txdu_enable_edges
  /s_rst_n/global_start/
  /sig/txdu_enable/
  /rise_edge/txdu_enable_rise_edge/
  /fall_edge/txdu_enable_fall_edge/
 )

 (?rtl:lte_dif_edges            :stopit_rise
  /s_rst_n/global_start/
  /sig/stop_it/
  /rise_edge/stop_it_rise_edge/
  /fall_edge/open/
 )

 (?rtl:lte_dif_toggle     -tw_g=2  :txdu_delayed_enable
  /s_rst_n/global_start/
  "/trig/{txdu_enable_rise_edge stop_it_rise_edge}/"
  /prev_toggle/txdu_delayed_enable/
  /toggle$/open/
 )

 tg_cntb0_tgl>
 +endtop=move_port_2signal#tg_cntb0      +declarch=decl_signal_from_port
 +beginarch=assign_add#{tg_cntb0_tgl:tg_cntb0_rise_edge OR tg_cntb0_fall_edge}
 (?rtl:lte_dif_edges
  /s_rst_n/global_start/
  /sig/tg_timestamp[0]/
  /rise_edge/tg_cntb0_rise_edge/
  /fall_edge/tg_cntb0_fall_edge/
 )

 ; # clk
 ; # rst_n
 ; # txdu_enable
 ; # txdu_stop_time<19
 ; # txdu_activation_immediate
 ; # txdu_activation_time<19
 ; # txdu_pc_modulus<16
 ; # tg_timestamp<19
 ; # txdu_drcv_en>
 ; # txdu_req>
 (?fsmc:lte_dif_txdu_reqgen
   lte_dif_txdu_reqstop
   lte_dif_txdu_reqmgnt
 )

)


(?fsm:lte_dif_txdu_reqstop
 (+size
   (tg_timestamp     19)
   (txdu_stop_time   19)
 )



 (idle (<txdu_enable_fall_edge
   (?tg_timestamp
    (!=txdu_stop_time  (-> wait_4stop))
    (=txdu_stop_time   (stop_it> <- 1) (-> stopped))
   )
  )
 )

 (wait_4stop  (<tg_timestamp=txdu_stop_time
   (stop_it <- 1)
   (-> stopped)
  )
 )


 (stopped  (<txdu_enable_rise_edge
   (stop_it <- 0)
   (-> idle)
  )
 )
)


(?fsm:lte_dif_txdu_reqmgnt
 (+size
   (tg_timestamp          19)
   (txdu_activation_time  19)
   (l_counter             16)
   (txdu_pc_modulus       16)
 )


 (idle  (<txdu_enable
   (?txdu_activation_immediate
    (=0 (?tg_timestamp
      (!=txdu_activation_time  (-> wait_2go))
      (=txdu_activation_time   (txdu_drcv_en> <- 1)  (-> send))
     )
    )

    (=1  (txdu_drcv_en <- 1)  (-> send))
   )
  )
 )


 (wait_2go  (?stop_it
   (=0 (<tg_timestamp=txdu_activation_time
      (txdu_drcv_en <- 1)
      (-> send)
     )
   )

   (=1  (-> idle))
  )
 )


 (send  (<stop_it
   (txdu_req  <- 0)
   (l_counter <- 16'0)
   (-> idle)
  )
 )


 (-misc
   (txdu_drcv_en <- 0  <stop_it)
   (txdu_req>    <- 0  <txdu_req)
 )

 (-req (?txdu_drcv_en
   (=0  (l_counter <- 16'0))
   (=1  (<tg_cntb0_tgl
          (?txdu_pc_modulus
           (!=l_counter (++ l_counter))
           (=l_counter  (l_counter <- 16'0)
	                (txdu_req  <- 1)
	   )

     )
    )
   )
  )
 )
)



(?fsm:lte_dif_txdu_burst_fe
 (idle  (<s_rst_n
   (<!txdu_fifo_afull
     (txdu_cm_read_rq <- 1)
     (-> bdone)
   )
  )
 )

 (bdone  (<s_rst_n
   (<txdu_cm_burst_done
    (?txdu_fifo_afull
     (=0 (txdu_cm_read_rq <- 1))
     (=1 (-> idle))
    )
   )
  )
 )

 (-misc (<s_rst_n
   (txdu_cm_read_rq <- 0 <txdu_cm_read_ack)
  )
 )

 (-syncrst (<!s_rst_n
   (txdu_cm_read_rq <- 0)
   (-> idle)
  )
 )
)


; # ------------- LTE_DIF_RFCU -------------
(?top:lte_dif_rfcu

  rfcu_stream_start_addr<20
  rfcu_stream_length<16

  cmi_rfcu_rd_ready
  rfcu_cmi_burst_rd_req>
  rfcu_cmi_fifo_rd>
  cmi_rfcu_fifo_empty
  rfcu_cmi_burst_len_n_addr>64
  rfcu_cmi_burst_size_rd>7
  rfcu_cmi_last_word_rd>
  rfcu_cmi_infinite_rd>
  rfcu_cmi_bypass_rd>
  rfcu_cmi_flush_rd>

  (?toplink:lte_dif_cmi_read
    /cmi_rd_ready/cmi_rfcu_rd_ready/
    /cmi_burst_rd_req/rfcu_cmi_burst_rd_req/
    /cmi_fifo_rd/rfcu_cmi_fifo_rd/
    /cmi_fifo_empty/cmi_rfcu_fifo_empty/

    /cmi_burst_len_n_addr/rfcu_cmi_burst_len_n_addr/
    /cmi_burst_size_rd/rfcu_cmi_burst_size_rd/
    /cmi_last_word_rd/rfcu_cmi_last_word_rd/
    /cmi_infinite_rd/rfcu_cmi_infinite_rd/
    /cmi_bypass_rd/rfcu_cmi_bypass_rd/
    /cmi_flush_rd/rfcu_cmi_flush_rd/

    /read_req/rfcu_cm_read_rq/
    /read_ack/rfcu_cm_read_ack/
    /burst_done/rfcu_cm_burst_done/
    /rdata_valid/rfcu_cm_data_valid/
    /read_stop/rfcu_read_stop/
    /read_wrap/open/

    /lcm_burst_size/rfcu_lcm_burst_size/
    /lcm_length/rfcu_stream_length/
    /lcm_start_addr/rfcu_stream_start_addr/
    /lcm_end_addr/20'0/
    /lcm_cur_addr/open/
  )


  (?top:lte_dif_rfcu_cpw_drv
    clk
    rst_n
    s_rst_n

    rfcu_mode
    stream_mode_done>  +beginarch=assign_add#stream_mode_done:stream_mode_end

    ; # Normal mode, aka, 64b from IOsocket
    rfcu_normal_data_port_1<16
    rfcu_data_wr_1
    rfcu_normal_data_port_2<16
    rfcu_data_wr_2
    rfcu_normal_data_port_3<16
    rfcu_data_wr_3
    rfcu_normal_data_port_4<16
    rfcu_data_wr_4

    rfcu_data_wr>
    rfcu_normal_data_port>64
    +endtop=move_port_2signal#rfcu_data_wr$#rfcu_normal_data_port$
    +beginarch=assign_add#{rfcu_data_wr:rfcu_data_wr_4 AND rfcu_data_wr_3 AND rfcu_data_wr_2 AND rfcu_data_wr_1}
    +beginarch=assign_add#{rfcu_normal_data_port:rfcu_normal_data_port_4 & rfcu_normal_data_port_3 & rfcu_normal_data_port_2 & rfcu_normal_data_port_1}

    ; # Stream mode, aka, 64b from Common Memory
    rfcu_cm_read_rq>
    rfcu_cm_read_ack
    rfcu_cm_burst_done
    rfcu_cm_data_valid
    cmi_rfcu_fifo_rdata<64


    h_wren>
    rfcu_h_full
    rfcu_h_fifo_data>16

    ts_wren>
    rfcu_ts_full
    rfcu_ts_fifo_data>24


    stream_ts>24

    +endtop=move_port_2signal#norm_ts#stream_ts
    +beginarch=assign_add#{rfcu_ts_fifo_data:stream_ts}



    rfcu_lcm_burst_size<7

    ; # Async FIFO CTRL WR I/F
    rfcu_fifo_full
    rfcu_fifo_afull
    rfcu_fifo_afull_thres>8   +beginarch=assign_add#{rfcu_fifo_afull_thres:rfcu_lcm_burst_size_8b - '1'}
    rfcu_fifo_wr>             +beginarch=assign_add#{rfcu_fifo_wr:stream_dvalid}
    rfcu_fifo_wdata>32        +beginarch=assign_add#{rfcu_fifo_wdata:stream_data}

    rfcu_lcm_burst_size_8b>8
    +endtop=move_port_2signal#rfcu_lcm_burst_size_8b  +declarch=decl_signal_from_port
    +beginarch=assign_add#{rfcu_lcm_burst_size_8b:'0' & rfcu_lcm_burst_size}



    +endtop=move_port_2signal#stream_enable#output_mux_sel#_64chuncks
    ; #### +endtop=move_port_2signal#pack_16_to_32_o_data#pack_16_to_32_o_valid#pack_8_to_32_o_valid
    ; # +beginarch=assign_add#{norm_enable:s_rst_n AND NOT rfcu_mode}
    +beginarch=assign_add#{stream_enable:s_rst_n AND rfcu_mode}


    rfcu_stream_length<16

    ; # rfcu_stream_length[15:3]
    raw_64chuncks>14                  +beginarch=assign_add#{raw_64chuncks:'0' & rfcu_stream_length(15 DOWNTO 3)}
    adjusted_64chuncks>14             +beginarch=assign_add#{adjusted_64chuncks:raw_64chuncks + '1'}
                                      +beginarch=assign_add#"rfcu_stream_length_64chuncks:raw_64chuncks WHEN rfcu_stream_length(2 DOWNTO 0) = (2 DOWNTO 0=>'0') ELSE adjusted_64chuncks"

    (?fsmc:lte_dif_rfcu_ctrl_fe
      ; #### lte_dif_rfcu_normctrl_fe

      lte_dif_rfcu_streamctrl_fe
      lte_dif_rfcu_stream_burst_fe      /stream_s_rst_n/stream_enable/

      ; # /norm_s_rst_n/norm_enable/
    )


    +endtop=move_port_2signal#stream_pack_16_to_32_o_data#stream_pack_16_to_32_o_valid
    +endtop=move_port_2signal#stream_pack_8_to_32_o_data#stream_pack_8_to_32_o_valid
    stream_data>32   +beginarch=assign_add#{stream_data:stream_pack_8_to_32_o_data   WHEN  stream_output_mux_sel = '1'  ELSE  stream_pack_16_to_32_o_data}
    stream_dvalid>   +beginarch=assign_add#{stream_dvalid:stream_pack_8_to_32_o_valid  WHEN  stream_output_mux_sel = '1'  ELSE  stream_pack_16_to_32_o_valid}

    +endtop=move_port_2signal#stream_fifo_rd$#stream_fifo_rd_fe#stream_data#stream_dvalid#unpack_64_to_8_i_next#unpack_64_to_16_i_next
    +beginarch=assign_add#{stream_fifo_rd:stream_fifo_rd_fe OR unpack_64_to_8_i_next OR unpack_64_to_16_i_next}

    rfcu_common_fifo_wdata>64
    rfcu_common_fifo_wr>
    stream_mode_wr>
    +endtop=move_port_2signal#rfcu_common_fifo_w#stream_mode_wr#stream_mode_end
    +beginarch=assign_add#{rfcu_common_fifo_wdata:rfcu_normal_data_port  WHEN rfcu_mode = '0' ELSE  cmi_rfcu_fifo_rdata}
    +beginarch=assign_add#{stream_mode_wr:rfcu_cm_data_valid AND NOT stream_mode_end}
    +beginarch=assign_add#{rfcu_common_fifo_wr:rfcu_data_wr  WHEN rfcu_mode = '0' ELSE  stream_mode_wr}
    (?top:lte_dif_rfcu_stream
      clk
      rst_n
      s_rst_n

      stream_pack_8_to_32_i_valid_en
      stream_pack_16_to_32_i_valid_en

      stream_fifo_rdata>64
      stream_fifo_valid>
      +beginarch=assign_add#stream_fifo_valid:local_common_fifo_valid
      +beginarch=assign_add#stream_fifo_rdata:local_common_fifo_rdata

      (?rtl:lte_dif_gfifo -wc_g=7 -dw_g=64 -aw_g=3  :common_fifo
        /wr/rfcu_common_fifo_wr/
        /wdata/rfcu_common_fifo_wdata/
        /rd$/stream_fifo_rd/
        /rdata/local_common_fifo_rdata/
        /^full/open/
        /valid/local_common_fifo_valid/
        /^empty/open/
        /a_full$/rfcu_read_stop/
        /a_empty$/open/
        /a_full_thres/3'1/
        /a_empty_thres/3'0/
      )

      (?rtl:lte_dif_stream_adapter_m_ge_n :unpack_64_to_8
        -m_imax_g=64
        -m_imin_g=64
        -n_omax_g=8
        -n_omin_g=8
        -msb_2lsb_g=0
        -rt_ssibw_g=7

        /s_rst_n/unpack_64_to_8_enable/

        /m_iss/7'64/
        /n_oss/7'8/
        /i_data/local_common_fifo_rdata/
        /i_valid/local_common_fifo_valid/
        /i_last/0b0/
        /i_next_o/unpack_64_to_8_i_next/
        /o_data/unpack_64_to_8_o_data/
        /o_valid/unpack_64_to_8_o_valid/
        /o_last/open/
        /o_stall_i/0b0/
      )

      stream_pack_8_to_32_i_valid>
      +endtop=move_port_2signal#local_stream_pack_8_to_32_i_valid#unpack_64_to_8_o_valid#local_common_fifo_valid   +declarch=decl_signal_from_port
      +beginarch=assign_add#{local_stream_pack_8_to_32_i_valid:unpack_64_to_8_o_valid AND stream_pack_8_to_32_i_valid_en}
      +beginarch=assign_add#stream_pack_8_to_32_i_valid:local_stream_pack_8_to_32_i_valid
      (?rtl:lte_dif_stream_adapter_m_le_n  :stream_pack_8_to_32
        -m_imax_g=8
        -m_imin_g=8
        -n_omax_g=32
        -n_omin_g=32
        -msb_2lsb_g=0
        -rt_ssibw_g=7

        /s_rst_n/stream_pack_8_to_32_enable/

        /m_iss/7'8/
        /n_oss/7'32/
        /i_data/unpack_64_to_8_o_data/
        /i_valid/local_stream_pack_8_to_32_i_valid/
        /i_last/stream_pack_8_to_32_i_last/
        /i_next_o/open/
        /o_data/stream_pack_8_to_32_o_data/
        /o_valid/stream_pack_8_to_32_o_valid/
        /o_last/open/
        /o_stall_i/0b0/
      )


      (?rtl:lte_dif_stream_adapter_m_ge_n  :unpack_64_to_16
        -m_imax_g=64
        -m_imin_g=64
        -n_omax_g=16
        -n_omin_g=16
        -msb_2lsb_g=0
        -rt_ssibw_g=7

        /s_rst_n/unpack_64_to_16_enable/

        /m_iss/7'64/
        /n_oss/7'16/
        /i_data/local_common_fifo_rdata/
        /i_valid/local_common_fifo_valid/
        /i_last/0b0/
        /i_next_o/unpack_64_to_16_i_next/
        /o_data/unpack_64_to_16_o_data/
        /o_valid/unpack_64_to_16_o_valid/
        /o_last/open/
        /o_stall_i/0b0/
      )

      stream_pack_16_to_32_i_valid>
      +endtop=move_port_2signal#local_stream_pack_16_to_32_i_valid#unpack_64_to_16_o_valid
      +beginarch=assign_add#{local_stream_pack_16_to_32_i_valid:unpack_64_to_16_o_valid AND stream_pack_16_to_32_i_valid_en}
      +beginarch=assign_add#stream_pack_16_to_32_i_valid:local_stream_pack_16_to_32_i_valid
      (?rtl:lte_dif_stream_adapter_m_le_n  :stream_pack_16_to_32
        -m_imax_g=16
        -m_imin_g=16
        -n_omax_g=32
        -n_omin_g=32
        -msb_2lsb_g=0
        -rt_ssibw_g=6

        /s_rst_n/stream_pack_16_to_32_enable/

        /m_iss/6'16/
        /n_oss/6'32/
        /i_data/unpack_64_to_16_o_data/
        /i_valid/local_stream_pack_16_to_32_i_valid/
        /i_last/stream_pack_16_to_32_i_last/
        /i_next_o/open/
        /o_data/stream_pack_16_to_32_o_data/
        /o_valid/stream_pack_16_to_32_o_valid/
        /o_last/open/
        /o_stall_i/0b0/
      )
    )
  )


  (?rtl:lte_dif_gfifo -wc_g=5 -dw_g=16 -aw_g=3  :rfcu_cpwheader_fifo
    /wr/h_wren/
    /wdata/rfcu_h_fifo_data/
    /rd$/h_rd/
    /rdata/rfcu_cpwheader/
    /^full/rfcu_h_full/
    /valid/h_valid/
    /^empty/open/
    /a_full$/open/
    /a_empty$/open/
    /thres/3'0/
  )

  ; # clk
  ; # rst_n
  ; # s_rst_n

  ; # h_valid
  ; # rfcu_cpwheader<16
  ; # h_rd>

  ; # tg_timestamp<19

  ; # ts_valid
  ; # c_time_stamp<24
  ; # ts_rd>

  ; # rfcu_req>

  ; # rfcu_len>8
  ; # rfcu_lcid>3
  (?fsmc: lte_dif_rfcu_reqgen)


  (?rtl:lte_dif_gfifo -wc_g=5 -dw_g=24 -aw_g=3  :rfcu_timestamp_fifo
    /wr/ts_wren/
    /wdata/rfcu_ts_fifo_data/
    /rd$/ts_rd/
    /rdata/c_time_stamp/
    /^full/rfcu_ts_full/
    /valid/ts_valid/
    /^empty/open/
    /a_full$/open/
    /a_empty$/open/
    /thres/3'0/
  )

)


(?fsm:lte_dif_rfcu_reqgen
 (+size  (c_time_stamp_18_dt_0 19)
         (c_time_stamp         24)
	 (rfcu_cpwheader       16)
         (tg_timestamp         19)
         (h_byte_count         8 )
 )

 (idle (<s_rst_n
   (<h_valid
    (?rfcu_tsi
     (=0  (rfcu_req> <- 1)
          (h_rd   = 1)
	  (rfcu_len'8 <- h_byte_count)
     )

     (=1 (?ts_valid
           (=1 (?c_time_stamp_18_dt_0
	         (=tg_timestamp  
		      (rfcu_req  <- 1)
                      (rfcu_len <- h_byte_count (-= 3))
		      (h_rd   = 1)
		      (ts_rd  = 1)
		 )

		 (!=tg_timestamp  (-> wait_ts_match))
	       )
	   )

           (=0 (-> wait_ts_valid))
       )

     )
    )

    (rfcu_lcid <- rfcu_cpwheader[2:0])
   )
  )
 )


 (wait_ts_match  (<s_rst_n
   (<c_time_stamp_18_dt_0=tg_timestamp
     (rfcu_req  <- 1)
     (rfcu_len  <- h_byte_count (-= 3))
     (h_rd   = 1)
     (ts_rd  = 1)
     (-> idle)
   )
  )
 )

 (wait_ts_valid  (<s_rst_n
   (<ts_valid
     (?c_time_stamp_18_dt_0
        (=tg_timestamp  
	     (rfcu_req  <- 1)
             (rfcu_len <- h_byte_count (-= 3))
             (h_rd   = 1)
             (ts_rd  = 1)
	     (-> idle)
        )

        (!=tg_timestamp  (-> wait_ts_match))
      )
   )
  )
 )

 (-misc
  (rfcu_tsi = rfcu_cpwheader[7])
  (c_time_stamp_18_dt_0 = c_time_stamp[18:0])
  (h_byte_count = rfcu_cpwheader[15:8])
 )


 (-pls
  (rfcu_req  <- 0  <rfcu_req)
 )

 (-syncrst (<!s_rst_n
   (rfcu_req  <- 0)
   (-> idle)
  )
 )
)



(?fsm:lte_dif_rfcu_streamctrl_fe
(+size  (stream_fifo_rdata  64) (sa_shift_count  3))

 (idle  (<s_rst_n

   (<stream_fifo_valid
     (h_wren  = 1)              (rfcu_h_fifo_data'16 = stream_fifo_rdata[63:48])
     (ts_wren = 1 <stream_tsi)  (stream_ts'24        = stream_fifo_rdata[47:24])

     (byte_count'8  <- stream_fifo_rdata[63:56]  <stream_tsi)

     (<!stream_tsi
       (?stream_fifo_rdata_b56
         (=1  (tbyte_count'7 <- stream_fifo_rdata_s63_57  (+= 1)))
         (=0  (tbyte_count   <- stream_fifo_rdata_s63_57        ))
       )
     )

     (unpack_64_to_8_enable  <= 1  <stream_tsi)
     (unpack_64_to_16_enable <= 1  <!stream_tsi)


     (stream_output_mux_sel <= stream_fifo_rdata[55])

     (<stream_tsi
      (sa_shift_count        <- 3'3)
      (-> sa_shift)
     )

     (<!stream_tsi
      (stream_pack_16_to_32_enable     <- 1)
      (stream_pack_16_to_32_i_valid_en <- 1)
      (-> wait_4last)
     )
   )
  )
 )


 (sa_shift (<s_rst_n
   (?sa_shift_count
    (!=3'0  (-- sa_shift_count))

    ( =3'0
      (-=3  byte_count)
      (stream_pack_8_to_32_enable     <- 1)
      (stream_pack_8_to_32_i_valid_en <- 1)
      (-> wait_4last)
    )
   )
  )
 )


 (wait_4last  (<s_rst_n
   (<stream_pack_8_to_32_i_last
     (unpack_64_to_8_enable          <= 0)
     (sa_shift_count                 <- 3'0)
     (byte_count                     <- 8'0)
     (stream_pack_8_to_32_enable     <- 0)
     (stream_pack_8_to_32_i_valid_en <- 0)
     (stream_fifo_rd_fe               = 1)
     (-> idle)
   )

   (<stream_pack_16_to_32_i_last
     (tbyte_count                     <- 7'0)
     (unpack_64_to_16_enable          <= 0)
     (stream_fifo_rd_fe                = 1)
     (stream_pack_16_to_32_enable     <- 0)
     (stream_pack_16_to_32_i_valid_en <- 0)
     (stream_fifo_rd_fe                = 1)
     (-> idle)
   )


  )
 )


 (-misc    (<s_rst_n

   (<(& stream_pack_8_to_32_i_valid  byte_count>8'0)   (-- byte_count))
   (<(& stream_pack_16_to_32_i_valid tbyte_count>7'0)  (-- tbyte_count))

   (stream_pack_8_to_32_i_last>  = 1 <(& stream_pack_8_to_32_i_valid  byte_count=8'1))
   (stream_pack_16_to_32_i_last> = 1 <(& stream_pack_16_to_32_i_valid tbyte_count=7'1))

   (stream_tsi               = stream_fifo_rdata[55])
   (stream_fifo_rdata_b56    = stream_fifo_rdata[56])
   (stream_fifo_rdata_s63_57 = stream_fifo_rdata[63:57])
  )
 )

 (-syncrst  (<!s_rst_n
     (stream_pack_16_to_32_i_valid_en <- 0)
     (stream_pack_8_to_32_i_valid_en  <- 0)
     (unpack_64_to_8_enable  <= 0)
     (unpack_64_to_16_enable <= 0)
     (stream_output_mux_sel  <= 0)
     (sa_shift_count         <- 3'0)
     ; # FIXME FIXME (byte_count             <- 8'0)
     ; # FIXME FIXME (tbyte_count            <- 7'0)
     (-> idle)
  )
 )
)


(?fsm:lte_dif_rfcu_stream_burst_fe
 (+size  
   (rfcu_stream_length_64chuncks  14)
 )

 (idle  (<stream_s_rst_n
   (stream_64count'14 <- rfcu_stream_length_64chuncks <!count_latched)
   (count_latched <- 1 <!count_latched)

   (<!rfcu_fifo_afull
    (rfcu_cm_read_rq   <- 1)
    (-> bdone)
   )
  )
 )

 (bdone  (<stream_s_rst_n
   (<rfcu_cm_burst_done
    (?stream_mode_end
     (=0 (?rfcu_fifo_afull
          (=0 (rfcu_cm_read_rq <- 1))
          (=1 (-> idle))
         )
     )

     (=1  (-> stream_end))
    )
   )
  )
 )

 (stream_end  (<stream_s_rst_n 
   (-> stream_end)
  )
 )

 (-misc (<stream_s_rst_n
   (rfcu_cm_read_rq <- 0 <rfcu_cm_read_ack)
   (<(& rfcu_cm_data_valid stream_64count>14'0)  (-- stream_64count))
   (stream_mode_end> <- 1  <(& rfcu_cm_data_valid stream_64count=14'1))
  )
 )


 (-syncrst  (<!stream_s_rst_n
    (rfcu_cm_read_rq <- 0)
    (stream_mode_end <- 0)
    (count_latched   <- 0)
    (-> idle)
  )
 )
)


(?top:lte_dif_cmi_read
  clk
  rst_n
  s_rst_n

  cmi_rd_ready
  cmi_burst_rd_req>
  cmi_fifo_rd>
  cmi_fifo_empty

  cmi_burst_len_n_addr>64
  cmi_burst_size_rd>7
  cmi_last_word_rd>=0b0
  cmi_infinite_rd>=0b0
  cmi_bypass_rd>=0b0
  cmi_flush_rd>=0b0

  read_req
  read_ack>
  burst_done>
  rdata_valid>
  read_stop
  read_wrap>


  inc_add_en>
  +endtop=move_port_2signal#cmi_burst_addr#lcm_burst_len#inc_add_en   +declarch=decl_signal_from_port
  +beginarch=assign_add#{cmi_burst_len_n_addr:  X"000" & lcm_burst_len & X"000" & cmi_burst_addr}
  +beginarch=assign_add#{lcm_burst_len:"00000000000" & lcm_burst_size & "00"}
  +beginarch=assign_add#cmi_burst_size_rd:lcm_burst_size

  lcm_burst_size<7
  lcm_length<16      ; # If needed, In Byte
  lcm_start_addr<20
  lcm_end_addr<20
  lcm_cur_addr>20     +beginarch=assign_add#lcm_cur_addr:cmi_burst_addr

  lcm_burst_size_minus_1>7   +endtop=move_port_2signal#lcm_burst_size_minus_1
  +beginarch=assign_add#{lcm_burst_size_minus_1:lcm_burst_size - '1'}
  (?toplink:lte_dif_cmi_addgen
    /start_addr/lcm_start_addr/
    /end_addr/lcm_end_addr/
    /cur_addr/cmi_burst_addr/
    "/length/{5'0, lcm_length[15:1]}/"   ; # lcm_length[15:1]  = the length expressed in 2B
    /incr/lcm_burst_len/
    /incen/inc_add_en/
    /wrap_on/read_wrap/
  )


  (?fsmc: lte_dif_cmi_burst_read)
)



(?fsm:lte_dif_cmi_burst_read

 (init (<s_rst_n

   (<read_req
     (?cmi_rd_ready
      (=0  (-> rdy_wait))
      (=1  (cmi_burst_rd_req> <- 1)
	   (read_ack   <- 1)
	   (burst_cnt'7 <- lcm_burst_size_minus_1)
	   (->  rdy_low)
      )
     )
   )
  )
 )


 (rdy_wait (<s_rst_n
    (<cmi_rd_ready
      (cmi_burst_rd_req <- 1)
      ; # (inc_add_en = 1)
      (read_ack>   <- 1)
      (burst_cnt'7 <- lcm_burst_size_minus_1)
      (->  rdy_low)
    )
  )
 )


 (rdy_low  (<s_rst_n
   (<!cmi_rd_ready
     (<!cmi_fifo_empty
       (cmi_fifo_rd>  =  1)
       (-> rcv)
     )
   )
  )
 )


 (rcv  (<s_rst_n
   ; # (rdata_valid> = 1)
   (cmi_fifo_rd = 1  <(& !cmi_fifo_empty  !read_stop))
   (-> empty_wait    <(& cmi_fifo_empty !burst_done))
   (-> init          <burst_done)
  )
 )


 (empty_wait  (<s_rst_n
   (<!cmi_fifo_empty
     (cmi_fifo_rd = 1)
     (-> rcv)
   )
  )
 )

 (-syncrst  (<!s_rst_n
   (cmi_burst_rd_req <- 0)
   (read_ack   <- 0)
   (-> init)
  )
 )


 (-pls
   (read_ack         <- 0 <read_ack)
   (cmi_burst_rd_req <- 0 <cmi_burst_rd_req)
   (rdata_valid>     <- 0 <rdata_valid)
 )

 (-misc
  (<(& rdata_valid burst_cnt!=7'0)    (-- burst_cnt))
  (burst_done>  = 1 <burst_cnt=7'0)
  (rdata_valid <- 1 <cmi_fifo_rd)
  (inc_add_en   = cmi_burst_rd_req)
 )

)


(?top:lte_dif_cmi_write
  clk
  rst_n
  s_rst_n


  ; # write_req
  ; # write_ack>
  burst_ack>
  burst_done>


  burst_threshold>7
  burst_aempty
  burst_rdata<64

  cmi_wr_ready
  cmi_burst_wr_req>
  cmi_fifo_wr>
  cmi_fifo_full

  cmi_len_addr_or_data>64

  cmi_burst_size_wr>7=7'0    ; # CMI requires this when in BYPASS mode
  cmi_last_word_wr>=0b0
  cmi_infinite_wr>=0b0
  cmi_bypass_wr>
  cmi_flush_wr>=0b0
  cmi_word_wr_en>4=0x0


  cmi_burst_len_n_addr>64
  inc_add_en>
  +endtop=move_port_2signal#cmi_burst_addr#lcm_burst_len#inc_add_en#cmi_burst_len_n_addr   +declarch=decl_signal_from_port
  +beginarch=assign_add#{cmi_burst_len_n_addr:  X"000" & lcm_burst_len & X"000" & cmi_burst_addr}
  +beginarch=assign_add#{lcm_burst_len:"00000000000" & lcm_burst_size & "00"}
  +beginarch=assign_add#{cmi_len_addr_or_data:cmi_burst_len_n_addr WHEN l_cmi_burst_wr_req = '1' ELSE burst_rdata}
  +beginarch=assign_add#burst_threshold:lcm_burst_size_minus_1

  lcm_burst_size<7
  lcm_length<16      ; # If needed, In Byte
  lcm_start_addr<20
  lcm_end_addr<20
  lcm_cur_addr>20     +beginarch=assign_add#lcm_cur_addr:cmi_burst_addr

  lcm_burst_size_minus_1>7   +endtop=move_port_2signal#lcm_burst_size_minus_1
  +beginarch=assign_add#{lcm_burst_size_minus_1:lcm_burst_size - '1'}
  (?toplink:lte_dif_cmi_addgen
    /start_addr/lcm_start_addr/
    /end_addr/lcm_end_addr/
    /cur_addr/cmi_burst_addr/
    "/length/{5'0, lcm_length[15:1]}/"   ; # lcm_length[15:1]  = the length is expressed in 2B
    /incr/lcm_burst_len/
    /incen/inc_add_en/
    /wrap_on/open/
  )


  +endtop=move_port_2signal#l_cmi_burst_wr_req
  +beginarch=assign_add#cmi_burst_wr_req:l_cmi_burst_wr_req#cmi_bypass_wr:l_cmi_burst_wr_req
  (?fsmc: lte_dif_cmi_burst_write
   /cmi_burst_wr_req/l_cmi_burst_wr_req/
  )
)

; # burst_aempty acts as the 'write_req' signal
(?fsm:lte_dif_cmi_burst_write
(+size     (burst_cnt  7))

 (init (<s_rst_n

   (<!burst_aempty
     (?cmi_wr_ready
      (=0  (-> rdy_wait))
      (=1  (cmi_burst_wr_req> <- 1)
           (inc_add_en   = 1)
	   (burst_ack   <- 1)
	   (burst_rd    <- 1)
	   (burst_on    <- 1)
	   (burst_cnt'7 <- lcm_burst_size_minus_1)
	   (->  drv)
      )
     )
   )

  )
 )


 (rdy_wait (<s_rst_n
    (<cmi_wr_ready
      (cmi_burst_wr_req <- 1)
      (inc_add_en  = 1)
      (burst_on   <- 1)
      (burst_ack  <- 1)
      (burst_cnt  <- lcm_burst_size_minus_1)
      (->  drv)
    )
  )
 )


 (drv  (<s_rst_n
   (<burst_done

     (<!burst_aempty
       (?cmi_wr_ready
        (=0  (-> rdy_wait))
        (=1  (cmi_burst_wr_req> <- 1)
             (inc_add_en   = 1)
             (burst_on    <- 1)
             (burst_ack   <- 1)
             (burst_rd    <- 1)
             (burst_cnt'7 <- lcm_burst_size_minus_1)
             (->  drv)
        )
       )
     )

   )
  )
 )


 (-pls
   (burst_ack>       <- 0 <burst_ack)
   (burst_done       <- 0 <burst_done)
   (cmi_burst_wr_req <- 0 <cmi_burst_wr_req)
 )

 (-misc
  (cmi_fifo_wr <- 1 <cmi_burst_wr_req)
  (cmi_fifo_wr <- 0 <burst_done)
  (burst_on    <- 0 <burst_done)

  (<burst_on
    (?burst_cnt
      (=7'0  (burst_done> <- 1) (burst_rd <- 0))
      ; # (=7'1  (burst_rd <- 0))
      (!=7'0 (-- burst_cnt))
    )
  )
 )


 (-syncrst  (<!s_rst_n
   (cmi_burst_wr_req <- 0)
   (burst_ack   <- 0)
   (burst_on    <- 0)
   (burst_done  <- 0)
   (burst_rd    <- 0)
   (burst_cnt   <- 7'0)
   (cmi_fifo_wr <- 0 )

   (-> init)
  )
 )

)



; # -------------------- LTE_DIF_TXIF --------------------
(?top:lte_dif_txif

  tx_code>8
  tx_kcode>
  tx_timeshift>2
  tx_burst_req>
  tx_burst_ack
  tx_phyevt<3
  tx_phymon<8


  ; # FIXME FIXME FIXME
  (?rtl:lte_dif_flop   -iosz_g=8
   /clk/tx_clk/                       ; #  IN  STD_LOGIC;
   /^rst_n/tx_rst_n/                  ; #  IN  STD_LOGIC;
   /s_rst_n/tx_global_start/          ; #  IN  STD_LOGIC;
   /di/txmain_bo/
   /do/tx_code/                       ; #  FIXME Just a temporary output expression FIXME
  )
  ; # FIXME FIXME FIXME


  rx_raclc_ackonack
  rx_raclc_cri<4
  (?rtl:lte_dif_pm_async_x2y_fifo -wc_g=13  -aw_g=4  -dw_g=5  -plsc_g=32  -plscw_g=6   :raclc_x2y_reqinfo
    /x_clk/dif_104_clk/                               ; # IN  STD_LOGIC;
    /x_rst_n/dif_rst_n/                               ; # IN  STD_LOGIC;
    /x_s_rst_n/global_start/                          ; # IN  STD_LOGIC;
    /x_pulsin/rx_raclc_retx_req/                      ; # IN  STD_LOGIC;
    "/x_i_data/{rx_raclc_ackonack rx_raclc_cri}/"     ; # IN  STD_LOGIC_VECTOR(dw_g-1 DOWNTO 0);
    /y_clk/tx_clk/                                    ; # IN  STD_LOGIC;
    /y_rst_n/tx_rst_n/                                ; # IN  STD_LOGIC;
    /y_s_rst_n/tx_global_start/                       ; # IN  STD_LOGIC;
    /y_i_rd/raclc_valid/                              ; # IN  STD_LOGIC;
    /y_o_valid/raclc_valid/                           ; # OUT STD_LOGIC;
    "/y_o_data/{raclc_ackonack raclc_cri}/"           ; # OUT STD_LOGIC_VECTOR(dw_g-1 DOWNTO 0);
  )

  raclc_ackonack>
  +endtop=move_port_2signal#raclc_ack_valid#raclc_nack_valid#^raclc_ackonack  +declarch=decl_signal_from_port
  +beginarch=assign_add#{raclc_nack_valid:raclc_valid AND raclc_ackonack}


