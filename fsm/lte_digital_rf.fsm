 (?rtl:cmc_interface

  -cmi_width_g=64
  -number_rd_fifo_g=6
  -fifo_depth_rd_g=128

  -number_wr_fifo_g=9
  -fifo_depth_wr_g=128

  /clk/cg_dif_104_clk/
  /rst_n/dif_rst_n/

  /cmi_cm_rdy/cm_dif_rdy/
  /cmi_cm_rqst/dif_cm_rqst/
  /cmi_cm_wr$/dif_cm_wr/
  /cmi_cm_wr_data/dif_cm_wr_data/
  /cmi_cm_rd_data/cm_dif_rd_data/

  =cmi_rd_fifo_mem_raddr>42
  =cmi_rd_fifo_mem_waddr>42
  =cmi_wr_fifo_mem_raddr>63
  =cmi_wr_fifo_mem_waddr>63
  =cmi_burst_size_wr<63         "/cmi_burst_size_wr/{rx_cmi_burst_size_wr[62:42] ios_cmi_burst_size_wr rx_cmi_burst_size_wr[34:0]}/"
  =cmi_burst_size_rd<42         "/cmi_burst_size_rd/{ios_cmi_burst_size_rd tx_cmi_burst_size_rd[34:0]}/"
  =cmi_fifo_counter_rd>42  /cmi_fifo_counter_rd/open/
  =cmi_fifo_counter_wr>63  /cmi_fifo_counter_wr/open/

  "/cmi_last_word_wr/{rx_cmi_last_word_wr[8:6] ios_cmi_last_word_wr rx_cmi_last_word_wr[4:0]}/"
  "/cmi_wr_data_rd_port/{ios_cmi_wr_data_rd_port tx_cmi_wr_data_rd_port[319:0]}/"
  "/cmi_word_wr_en/{rx_cmi_word_wr_en[35:24] ios_cmi_word_wr_en rx_cmi_word_wr_en[19:0]}/"
  "/cmi_rqst_rd_port/{ios_cmi_rqst_rd_port tx_cmi_rqst_rd_port[4:0]}/"
  "/cmi_rd_fifo_rd/{ios_cmi_rd_fifo_rd tx_cmi_rd_fifo_rd[4:0]}/"
  "/cmi_last_word_rd/{ios_cmi_last_word_rd tx_cmi_last_word_rd[4:0]}/"
  "/cmi_infinite_rd/{ios_cmi_infinite_rd tx_cmi_infinite_rd[4:0]}/"
  "/cmi_infinite_wr/{rx_cmi_infinite_wr[8:6] ios_cmi_infinite_wr rx_cmi_infinite_wr[4:0]}/"
  "/cmi_flush_rd/{ios_cmi_flush_rd tx_cmi_flush_rd[4:0]}/"
  "/cmi_bypass_wr/{rx_cmi_bypass_wr[8:6] ios_cmi_bypass_wr rx_cmi_bypass_wr[4:0]}/"
  "/cmi_flush_wr/{rx_cmi_flush_wr[8:6] ios_cmi_flush_wr rx_cmi_flush_wr[4:0]}/"
  "/cmi_wr_data_wr_port/{rx_cmi_wr_data_wr_port[575:384] ios_cmi_wr_data_wr_port rx_cmi_wr_data_wr_port[319:0]}/"
  "/cmi_wr_fifo_wr/{rx_cmi_wr_fifo_wr[8:6] ios_cmi_wr_fifo_wr rx_cmi_wr_fifo_wr[4:0]}/"
  "/cmi_bypass_rd/{ios_cmi_bypass_rd tx_cmi_bypass_rd[4:0]}/"
  "/cmi_rqst_wr_port/{rx_cmi_rqst_wr_port[8:6] ios_cmi_rqst_wr_port rx_cmi_rqst_wr_port[4:0]}/"
 )



 ; # Reset synchronizers for TX, RX lane #1 and RX lane #2
 (?rtl:rst_sync
   /async_rst_n/dif_rst_n/
   /clk/tx_clk/
   /^rst_n/tx_rst_n/
   /test_reset_bypass/dft_ctrl_in[?dft_ctrl_rstsync_bypass_c]/
 )

 (?rtl:rst_sync
   /async_rst_n/dif_rst_n/
   /clk/rx_1_clk/
   /^rst_n/rx_1_rst_n/
   /test_reset_bypass/dft_ctrl_in[?dft_ctrl_rstsync_bypass_c]/
 )

 (?rtl:rst_sync
   /async_rst_n/dif_rst_n/
   /clk/rx_2_clk/
   /^rst_n/rx_2_rst_n/
   /test_reset_bypass/dft_ctrl_in[?dft_ctrl_rstsync_bypass_c]/
 )


 (?toplink:lte_dif_buffers)
 (?toplink:lte_dif_clkgen)

 (?rtl:lte_dif_enables
   global_start
   rxdu_1_start
   rxdu_2_start
   rxdu_3_start
   rxdu_4_start
   txdu_1_start
   txdu_2_start
   rfcu_1_start
   rfcu_2_start
   rfcu_3_start
   rx_ppimon_1_start
   rx_ppimon_2_start
   tx_ppimon_start
   rspu_start
   icu_start
   tasu_1_start
   tasu_2_start
   tasu_3_start

   rxdu_1_enable>
   rxdu_1_mem_en_n>
   rxdi_1_mem_en_n>

   rxdu_2_enable>
   rxdu_2_mem_en_n>
   rxdi_2_mem_en_n>

   rxdu_3_enable>
   rxdu_3_mem_en_n>
   rxdi_3_mem_en_n>

   rxdu_4_enable>
   rxdu_4_mem_en_n>
   rxdi_4_mem_en_n>


   txdu_1_enable>
   txdu_1_mem_en_n>

   txdu_2_enable>
   txdu_2_mem_en_n>

   rfcu_1_enable>
   rfcu_1_mem_en_n>

   rfcu_2_enable>
   rfcu_2_mem_en_n>

   rfcu_3_enable>
   rfcu_3_mem_en_n>

   rspu_enable>
   rspu_mem_en_n>

   tasu_1_enable>
   tasu_2_enable>
   tasu_3_enable>

   icu_enable>

   rxif_1_enable>  /rxif_1_enable/open/   ; # FIXME PORT TO BE REMOVED FIXME
   rxif_2_enable>  /rxif_2_enable/open/   ; # FIXME PORT TO BE REMOVED FIXME

   rxif_1_mem_en_n>
   rxif_2_mem_en_n>

   retx_mem_en_n>
   rord_mem_en_n>


   fcrc_mem_en_n>

   rx_ppimon_1_enable>
   rx_ppimon_1_mem_en_n>
   rx_ppimon_2_enable>
   rx_ppimon_2_mem_en_n>
   tx_ppimon_enable>
   tx_ppimon_mem_en_n>
 )

 (?top:lte_dif_core

   sof_kcode<8   /sof_kcode/0xbc/
   eof_kcode<8   /eof_kcode/0x7c/
   eot_kcode<8   /eot_kcode/0xdc/


   tx_kcode>  +beginarch=assign_add#tx_kcode:local_tx_kcode
   tx_code>8  +beginarch=assign_add#tx_code:local_tx_code

   /dif_104_clk/cg_dif_104_clk/
   /dif_208_clk/cg_dif_208_clk/
   /rx_1_clk/cg_rx_1_clk/
   /rx_2_clk/cg_rx_2_clk/
   /tx_clk/cg_tx_clk/

   /dig_pwr_en/extlines_dig_pwr_en/
   /dig_rst_n/extlines_dig_rst_n/
   /ana_pwr_en/extlines_ana_pwr_en/
   /sys_clk_en/extlines_sys_clk_en/
   /txon/extlines_txon/
   /digrf_en/extlines_digrf_en/


   (?rtl:sync_s ; #1
    /clk/rx_1_clk/
    /rst_n/rx_1_rst_n/
    /test_en/dft_ctrl_in[?dft_ctrl_sync_bypass_c]/
    /async_signal/rx_ppimon_1_enable/
    /synced_signal/rx_ppimon_1_enable_sync/
   )

   (?rtl:sync_s ; #2
    /clk/rx_2_clk/
    /rst_n/rx_2_rst_n/
    /test_en/dft_ctrl_in[?dft_ctrl_sync_bypass_c]/
    /async_signal/rx_ppimon_2_enable/
    /synced_signal/rx_ppimon_2_enable_sync/
   )

   (?rtl:sync_s ; #3
    /clk/tx_clk/
    /rst_n/tx_rst_n/
    /test_en/dft_ctrl_in[?dft_ctrl_sync_bypass_c]/
    /async_signal/tx_ppimon_enable/
    /synced_signal/tx_ppimon_enable_sync/
   )

   (?rtl:sync_s   :tx_idle_mode_en_sync  ; #4
    /clk/tx_clk/
    /rst_n/tx_rst_n/
    /test_en/dft_ctrl_in[?dft_ctrl_sync_bypass_c]/
    /async_signal/ios_tx_idle_mode_en/
    /synced_signal/tx_idle_mode_en/
   )


   (?top:lte_dif_tx

     tx_ticlc_id_code<3        /tx_ticlc_id_code/3'0/
     tx_taslc_id_code<3        /tx_taslc_id_code/3'1/
     tx_cwclc_id_code<3        /tx_cwclc_id_code/3'2/
     tx_crclc_id_code<3        /tx_crclc_id_code/3'3/
     tx_taclc_id_code<3        /tx_taclc_id_code/3'4/
     tx_thlclc_id_code<3       /tx_thlclc_id_code/3'5/
     tx_reservedclc_id_code<3  /tx_reservedclc_id_code/3'6/
     tx_tsclc_id_code<3        /tx_tsclc_id_code/3'7/


     cmi_rd_data_rd_port<384
     cmi_rd_fifo_empty<6
     cmi_rdy_rd<6

     cmi_flush_rd>6          /cmi_flush_rd/tx_cmi_flush_rd/
     cmi_rqst_rd_port>6      /cmi_rqst_rd_port/tx_cmi_rqst_rd_port/
     cmi_bypass_rd>6         /cmi_bypass_rd/tx_cmi_bypass_rd/
     cmi_rd_fifo_rd>6        /cmi_rd_fifo_rd/tx_cmi_rd_fifo_rd/
     cmi_burst_size_rd>42    /cmi_burst_size_rd/tx_cmi_burst_size_rd/
     cmi_wr_data_rd_port>384 /cmi_wr_data_rd_port/tx_cmi_wr_data_rd_port/

     cmi_last_word_rd>6      /cmi_last_word_rd/tx_cmi_last_word_rd/
     cmi_infinite_rd>6       /cmi_infinite_rd/tx_cmi_infinite_rd/


     /tx_code/local_tx_code/
     /tx_kcode/local_tx_kcode/

     (?toplink:lte_dif_icu
       /^clk/dif_104_clk/
       /^rst_n/dif_rst_n/
       /s_rst_n/icu_enable/
     )

     (?toplink:lte_dif_tasu #1
      /clk/dif_104_clk/
      /^rst_n/dif_rst_n/
      /s_rst_n/tasu_1_enable/
      /tasu_data_wr_1/tasu_1_data_port_1_wr_strb/
      /tasu_data_port_1/tasu_1_data_port_1/
      /tasu_data_wr_2/tasu_1_data_port_2_wr_strb/
      /tasu_data_port_2/tasu_1_data_port_2/
      /tasu_send/tasu_1_send/
