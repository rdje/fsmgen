(?top:lte_dif_rspu   rspu_fifo_clear     rspu_fifo_status>2=0b00
  clk
  rst_n
  s_rst_n

  rspu_cmi_last_word_wr>
  rspu_cmi_infinite_wr>
  rspu_cmi_word_wr_en>4

  rspu_fifo_slow_valid
  rspu_fifo_empty


  (?rtl:lte_dif_stream_adapter_m_le_n  :rspu_pack_8to16
    -m_imax_g=8                         ; # -- Max input  stream bit-width (M)
    -m_imin_g=8                         ; # -- Min input  stream bit-width (M)
    -n_omax_g=16                        ; # -- Max output stream bit-width (N)
    -n_omin_g=16                        ; # -- Min output stream bit-width (N)
    -msb_2lsb_g=0                       ; # -- 1= Enables MSB to LSB translation 0= Disables it
    -rt_ssibw_g=5                       ; # -- Runtime stream size indicators bit-width (m)

    /m_iss/5'8/                         ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /n_oss/5'16/                        ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /i_data/rspu_ctrl_data/             ; # IN  STD_LOGIC_VECTOR (m_imax_g-1 DOWNTO 0);
    /i_valid/rspu_ctrl_valid/           ; # IN  STD_LOGIC;
    /i_last/rspu_ctrl_last/             ; # IN  STD_LOGIC;
    /i_next_o/open/                     ; # OUT STD_LOGIC;
    /o_data/rspu_fifo_wdata/            ; # OUT STD_LOGIC_VECTOR (n_omax_g-1 DOWNTO 0);
    /o_valid/rspu_fifo_wr/              ; # OUT STD_LOGIC;
    /o_last/open/                       ; # OUT STD_LOGIC;
    /o_stall_i/rspu_fifo_full/          ; # IN  STD_LOGIC
  )


  ; # Header and TimeStamp
  (?top:lte_dif_rspu_hts
    clk
    rst_n
    s_rst_n

    rspu_ctrl_lcid<3
    rspu_ctrl_size<8
    rspu_ctrl_valid
    rspu_ctrl_last

    tg_timestamp<19


    rspu_hts_full
    rspu_hts_wr>             +beginarch=assign_add#{rspu_hts_wr:hts_tgl_en AND hts_tgl}


    hts_tgl_en>
    +beginarch=assign_add#{nxt_hts_wdata(39 DOWNTO 32):rspu_ctrl_size}
    +beginarch=assign_add#{nxt_hts_wdata(31 DOWNTO 24):"10000" & rspu_ctrl_lcid}
    +beginarch=assign_add#{nxt_hts_wdata(23 DOWNTO  0):"00000" & tg_timestamp}

    +endtop=move_port_2signal#hts_tgl#hts_data_load#nxt_hts_wdata  +declarch=decl_signal_from_port
    +beginarch=assign_add#{hts_data_load:hts_tgl_en AND NOT hts_tgl}
    +beginarch=assign_add#{hts_tgl_en:rspu_ctrl_last  WHEN hts_tgl = '1' ELSE rspu_ctrl_valid}
    +beginarch=assign_add#{nxt_hts_tgl:hts_tgl_en XOR hts_tgl}
    (?rtl:lte_dif_flop_1b
     /di/nxt_hts_tgl/
     /do/hts_tgl/
    )

    (?rtl:lte_dif_2to1_flop  -dw_g=40  :hts_wdata
      /i_load/hts_data_load/
      /i_data/nxt_hts_wdata/
      /o_data/rspu_hts_wdata/
      /o_next_data/open/
    )
  )

  (?rtl:lte_dif_gfifo  -wc_g=8  -aw_g=4  -dw_g=40  :rspu_hts
    /wr/rspu_hts_wr/
    /wdata/rspu_hts_wdata/
    /rd$/rspu_hts_rd/
    /rdata/rspu_hts_rdata/
    /^full/rspu_hts_full/
    /valid/rspu_hts_valid/
    /^empty/open/
    /a_full$/open/
    /a_empty$/open/
    /thres/4'0/
  )


  rspu_fifo_rd>
  +endtop=move_port_2signal#rspm_first_#rspm_mux_sel     +declarch=decl_signal_from_port
  +beginarch=assign_add#rspu_fifo_rd:rspu_unpack_16to8_rspu_fifo_rd
  (?top:lte_dif_rspu_start_cpw
    clk
    rst_n
    s_rst_n



    rspu_cpw_64w_full

    rspu_hts_valid
    rspu_hts_rdata<40
    rspu_hts_rd>


    rspm_fifo_wr            /rspm_fifo_wr/l_rspm_fifo_wr/

    rspm_fifo_full
    rspm_first_64b_data>64   +beginarch=assign_add#{rspm_first_64b_data:rspu_hts_bc_p3 & rspu_hts_rdata(31 DOWNTO 0) & rspu_pack_8to24_o_data}
    rspm_first_64b_wr>       +beginarch=assign_add#{rspm_first_64b_wr:cpw_header_closed AND rspu_pack_8to24_en}
    rspm_mux_sel>            +beginarch=assign_add#{rspm_mux_sel:cpw_header_closed AND rspu_pack_8to24_en}

    rspu_hts_bc_p3>8         +beginarch=assign_add#{rspu_hts_bc_p3:rspu_hts_bc + "00000011"}

    +endtop=move_port_2signal#rspu_pack_8to24_o_data          +declarch=decl_signal_from_port

    (?rtl:lte_dif_stream_adapter_m_le_n  :rspu_pack_8to24
      -m_imax_g=8                            ; # -- Max input  stream bit-width (M)
      -m_imin_g=8                            ; # -- Min input  stream bit-width (M)
      -n_omax_g=24                           ; # -- Max output stream bit-width (N)
      -n_omin_g=24                           ; # -- Min output stream bit-width (N)
      -msb_2lsb_g=0                          ; # -- 1= Enables MSB to LSB translation 0= Disables it
      -rt_ssibw_g=5                          ; # -- Runtime stream size indicators bit-width (m)

      /s_rst_n/rspu_pack_8to24_en/

      /m_iss/5'8/                            ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
      /n_oss/5'24/                           ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
      /i_data/rspu_unpack_16to8_o_data/      ; # IN  STD_LOGIC_VECTOR (m_imax_g-1 DOWNTO 0);
      /i_valid/rspu_unpack_16to8_o_valid/    ; # IN  STD_LOGIC;
      /i_last/cpw_closed/                    ; # IN  STD_LOGIC;
      /i_next_o/open/                        ; # OUT STD_LOGIC;
      /o_data/rspu_pack_8to24_o_data/        ; # OUT STD_LOGIC_VECTOR (n_omax_g-1 DOWNTO 0);
      /o_valid/cpw_header_closed/            ; # OUT STD_LOGIC;
      /o_last/open/                          ; # OUT STD_LOGIC;
      /o_stall_i/0b0/                        ; # IN  STD_LOGIC
    )
    
    +endtop=move_port_2signal#rspu_hts_bc
    +beginarch=assign_add#{rspu_hts_bc_m1:rspu_hts_rdata(39 DOWNTO 32) - '1'}
    +beginarch=assign_add#{rspu_hts_bc:rspu_hts_rdata(39 DOWNTO 32)}

    (?fsmc: lte_dif_rspu_cpw)
  )

  rspm_fifo_wdata>64
  rspm_fifo_wr>         +beginarch=assign_add#rspm_fifo_wr:l_rspm_fifo_wr

  l_rspm_fifo_wr>
  +beginarch=assign_add#{rspm_fifo_wdata:rspu_pack_8to64_o_data WHEN rspm_mux_sel = '0' ELSE rspm_first_64b_data}
  +beginarch=assign_add#{l_rspm_fifo_wr:rspu_pack_8to64_o_valid WHEN rspm_mux_sel = '0' ELSE rspm_first_64b_wr}


  +endtop=move_port_2signal#rspu_unpack_16to8_rspu_fifo_rd#l_rspm_fifo_wr
  (?rtl:lte_dif_stream_adapter_m_ge_n  :rspu_unpack_16to8
    -m_imax_g=16                               ; # -- Max input  stream bit-width (M)
    -m_imin_g=16                               ; # -- Min input  stream bit-width (M)
    -n_omax_g=8                                ; # -- Max output stream bit-width (N)
    -n_omin_g=8                                ; # -- Min output stream bit-width (N)
    -msb_2lsb_g=0                              ; # -- 1= Enables MSB to LSB translation 0= Disables it
    -rt_ssibw_g=5                              ; # -- Runtime stream size indicators bit-width (m)

    /s_rst_n/rspu_unpack_16to8_en/

    /m_iss/5'16/                               ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /n_oss/5'8/                                ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /i_data/rspu_fifo_rdata/                   ; # IN  STD_LOGIC_VECTOR (m_imax_g-1 DOWNTO 0);
    /i_valid/rspu_fifo_slow_valid/             ; # IN  STD_LOGIC;
    /i_last/0b0/                               ; # IN  STD_LOGIC;
    /i_next_o/rspu_unpack_16to8_rspu_fifo_rd/  ; # OUT STD_LOGIC;
    /o_data/rspu_unpack_16to8_o_data/          ; # OUT STD_LOGIC_VECTOR (n_omax_g-1 DOWNTO 0);
    /o_valid/rspu_unpack_16to8_o_valid/        ; # OUT STD_LOGIC;
    /o_last/open/                              ; # OUT STD_LOGIC;
    /o_stall_i/0b0/                            ; # IN  STD_LOGIC  <-----FIXME-FIXME-FIXME-FIXME-FIXME-FIXME-FIXME
  )


  +endtop=move_port_2signal#rspu_pack_8to64_i_valid#rspu_pack_8to64_o_data#rspu_pack_8to64_o_valid
  +beginarch=assign_add#{rspu_pack_8to64_i_valid:rspu_unpack_16to8_o_valid AND rspu_pack_8to64_i_valid_enable}
  (?rtl:lte_dif_stream_adapter_m_le_n  :rspu_pack_8to64
    -m_imax_g=8                         ; # -- Max input  stream bit-width (M)
    -m_imin_g=8                         ; # -- Min input  stream bit-width (M)
    -n_omax_g=64                        ; # -- Max output stream bit-width (N)
    -n_omin_g=64                        ; # -- Min output stream bit-width (N)
    -msb_2lsb_g=0                       ; # -- 1= Enables MSB to LSB translation 0= Disables it
    -rt_ssibw_g=7                       ; # -- Runtime stream size indicators bit-width (m)

    /s_rst_n/rspu_pack_8to64_en/

    /m_iss/7'8/                         ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /n_oss/7'64/                        ; # IN  STD_LOGIC_VECTOR (rt_ssibw_g -1 DOWNTO 0);
    /i_data/rspu_unpack_16to8_o_data/   ; # IN  STD_LOGIC_VECTOR (m_imax_g-1 DOWNTO 0);
    /i_valid/rspu_pack_8to64_i_valid/   ; # IN  STD_LOGIC;
    /i_last/rspu_pack_8to64_i_last/     ; # IN  STD_LOGIC;
    /i_next_o/open/                     ; # OUT STD_LOGIC;
    /o_data/rspu_pack_8to64_o_data/     ; # OUT STD_LOGIC_VECTOR (n_omax_g-1 DOWNTO 0);
    /o_valid/rspu_pack_8to64_o_valid/   ; # OUT STD_LOGIC;
    /o_last/open/                       ; # OUT STD_LOGIC;
    /o_stall_i/rspm_fifo_full/          ; # IN  STD_LOGIC
  )

  (?rtl:lte_dif_gfifo  -wc_g=16  -aw_g=5  -dw_g=8  :rspu_cpw_64w
    /wr/rspu_cpw_64w_wr/
    /wdata/rspu_cpw_64w_wdata/
    /rd$/rspu_cpw_64w_rd/
    /rdata/rspu_cpw_64w_rdata/
    /^full/rspu_cpw_64w_full/
    /valid/rspu_cpw_64w_valid/
    /^empty/open/
    /a_full$/open/
    /a_empty$/open/
    /thres/5'0/
  )

  (?top:lte_dif_rspu_ctrlmsg_2cm
    clk
    rst_n
    s_rst_n


    rspu_cpw_64w_valid
    rspu_cpw_64w_rdata<8
    rspu_cpw_64w_rd>           +beginarch=assign_add#rspu_cpw_64w_rd:rspu_burst_ack


    tg_timestamp<19
    rspu_flush_time<19
    rspu_flush_time_on
    rspu_flush_now

    rspm_fifo_slow_valid
    rspm_fifo_empty
    rspm_fifo_aempty
    rspm_fifo_aempty_thres>8   +beginarch=assign_add#{rspm_fifo_aempty_thres:'0' & rspm_burst_threshold}
    rspm_fifo_rd>              +beginarch=assign_add#{rspm_fifo_rd:l_rspm_fifo_rd AND rd_cut_n}
    rspm_fifo_rdata<64

    cmi_rdy_wr
    cmi_wr_fifo_full
    rspu_cmi_burst_size_wr>7
    rspu_cmi_bypass_wr>
    rspu_cmi_flush_wr>
    rspu_cmi_rqst_wr_port>
    rspu_cmi_wr_fifo_wr>                  +beginarch=assign_add#rspu_cmi_wr_fifo_wr:l_rspu_cmi_wr_fifo_wr
    rspu_cmi_wr_data_wr_port>64
    rspu_cmi_last_word_wr>
    rspu_cmi_infinite_wr>
    rspu_cmi_word_wr_en>4

    rspu_start_addr<20
    rspu_end_addr<20
    rspu_cur_addr>20
    rspu_lcm_burst_size<7


    +endtop=move_port_2signal#rspm_burst_threshold#ft_eq_ts#cpw_flush
    +endtop=move_port_2signal#l_rspu_cmi_wr_fifo_wr#rspu_burst_ack#l_rspm_fifo_rd
    +declarch=decl_signal_from_port

    (?toplink:lte_dif_cmi_write
      /burst_done/rspu_burst_done/
      /burst_ack/rspu_burst_ack/
      /burst_aempty/flush_req_n/               ; # Was rspm_fifo_aempty
      /burst_threshold/rspm_burst_threshold/   ; # Was rspm_fifo_aempty_thres/
      /burst_rdata/rspm_fifo_rdata/
      /burst_rd$/l_rspm_fifo_rd/

      /cmi_wr_ready/cmi_rdy_wr/
      /cmi_burst_wr_req/rspu_cmi_rqst_wr_port/
      /cmi_fifo_wr/l_rspu_cmi_wr_fifo_wr/
      /cmi_fifo_full/cmi_wr_fifo_full/
      /cmi_len_addr_or_data/rspu_cmi_wr_data_wr_port/
      /cmi_burst_size_wr/rspu_cmi_burst_size_wr/
      /cmi_last_word_wr/rspu_cmi_last_word_wr/
      /cmi_infinite_wr/rspu_cmi_infinite_wr/
      /cmi_bypass_wr/rspu_cmi_bypass_wr/
      /cmi_flush_wr/rspu_cmi_flush_wr/
      /cmi_word_wr_en/rspu_cmi_word_wr_en/

      /lcm_burst_size/rspu_lcm_burst_size/
      /lcm_length/16'0/
      /lcm_start_addr/rspu_start_addr/
      /lcm_end_addr/rspu_end_addr/
      /lcm_cur_addr/rspu_cur_addr/
    )

    +beginarch=assign_add#{ft_eq_ts:'1' WHEN rspu_flush_time = tg_timestamp ELSE '0'}
    +beginarch=assign_add#{cpw_flush:ft_eq_ts_rise WHEN rspu_flush_time_on = '1' ELSE rspu_flush_now}
    (?rtl:lte_dif_edges            :flush_time_match
     /sig/ft_eq_ts/
     /rise_edge/ft_eq_ts_rise/
     /fall_edge/open/
    )

    (?top:lte_dif_ctrlmsg_flush_cnt
      cpw_flush
      rspu_burst_ack
     

      +endtop=move_port_2signal#cnt#nxt_valid
      +declarch=decl_signal_from_port
     
      +beginarch=assign_add#{nxt_cnt:cnt + cpw_flush - rspu_burst_ack}
      (?rtl:lte_dif_flop     -iosz_g=8  :cnt
        /di/nxt_cnt/     
        /do/cnt/
      )

      +beginarch=assign_add#"nxt_valid:'1' WHEN  nxt_cnt /= (cnt'RANGE=> '0')  ELSE '0'"
      (?rtl:lte_dif_flop_1b
        /di/nxt_valid/     
        /do/flush_valid/
      )
    )

    ctrl_64wcnt_minus_1>8   
    +endtop=move_port_2signal#ctrl_64wcnt_minus_1#rd_cut_n
    +beginarch=assign_add#{ctrl_64wcnt_minus_1:rspu_cpw_64w_rdata - '1'}
    (?fsmc: lte_dif_rspu_cmsg_bc
     /cmi_wr_fifo_wr/l_rspu_cmi_wr_fifo_wr/
     /rspm_fifo_rd/l_rspm_fifo_rd/
    )

  )
)


(?fsm:lte_dif_rspu_cmsg_bc
 (idle (<s_rst_n
   (<cpw_n_flush_valid
     (w64_wcnt'8 <- ctrl_64wcnt_minus_1)
     (w64_rcnt'8 <- ctrl_64wcnt_minus_1)
     (rd_cut_n   <- 1)
     (flush_req_n = 0)
     (-> dec)
   )
  )
 )

 (dec (<s_rst_n
   (<(& cmi_wr_fifo_wr w64_wcnt!=8'0)   (-- w64_wcnt))

   (<rspu_burst_done 
     (?w64_wcnt
      ( =8'0 (?cpw_n_flush_valid
               (=1 (w64_wcnt <- ctrl_64wcnt_minus_1)
                   (w64_rcnt <- ctrl_64wcnt_minus_1)
                   (rd_cut_n <- 1)
                   (flush_req_n = 0)
	       )

	       (=0  (-> idle))
	     )
      ) 

      (!=8'0 (flush_req_n = 0)) 
     )
   )

   (?w64_rcnt
    (!=8'0 (<rspm_fifo_rd (-- w64_rcnt)))
    ( =8'0 (rd_cut_n <- 0  <rspm_fifo_rd))
   )

  )
 )


 (-cb
  (cpw_n_flush_valid  = 1  <(& rspu_cpw_64w_valid  flush_valid))
 )

 (-sr (<!s_rst_n
   (rd_cut_n <- 0)
   (w64_wcnt <- 8'0)
   (w64_rcnt <- 8'0)
   (-> idle)
  )
 )
)


(?fsm:lte_dif_rspu_cpw
(+size
 (rspu_hts_rdata    40)
 (bytecnt            8)
 (rspu_cpw_64w_wdata 8)
 (rspu_hts_bc        8)
 (rspu_hts_bc_m1     8)
)

 (idle (<s_rst_n
   (<rspu_hts_valid
    (rspu_unpack_16to8_en = 1)
    (rspu_pack_8to24_en    = 1)

    (?rspu_hts_bc
      (=8'1 (rspu_hts_rd        = 1)
            (rspu_cpw_req2send <- 1)
            (-> reqpls)
      )

      (>8'1 (bytecnt <- rspu_hts_bc_m1)
            (-> hd)
      )
    )
   )
  )
 )


 (hd (<s_rst_n
   (rspu_unpack_16to8_en = 1)
   (rspu_pack_8to24_en   = 1)

   (<cpw_header_closed
    (<rspu_hts_bc>8'3  (-> pl))
    (<rspu_hts_bc<=8'3 (rspu_hts_rd        = 1)
                       (rspu_cpw_req2send <- 1)
                       (-> reqpls)
    )
   )
  )
 )


 (pl (<s_rst_n
   (rspu_pack_8to64_en             = 1)
   (rspu_pack_8to64_i_valid_enable = 1)

   (?cpw_closed
    (=0 (rspu_unpack_16to8_en = 1))
    
    (=1  (rspu_unpack_16to8_en   = 0)
         (rspu_pack_8to64_i_last = 1)
         (rspu_hts_rd            = 1)
	 (rspu_cpw_req2send     <- 1)
         (-> reqpls)
    )
   )
  )
 )


 (reqpls (<s_rst_n
    (rspu_cpw_64w_wr     = 1)
    (rspu_cpw_64w_wdata <- 8'0)

    (-> idle)
  )
 )

 (-cb (<s_rst_n
    (<(& rspu_unpack_16to8_o_valid bytecnt!=8'0) (-- bytecnt))
    (cpw_closed>         = 1 <(& rspu_unpack_16to8_o_valid bytecnt=8'1))
    (rspu_cpw_req2send> <- 0 <rspu_cpw_req2send)

    (<rspm_fifo_wr (++ rspu_cpw_64w_wdata))
  )
 )

 (-sr (<!s_rst_n
   (bytecnt            <- 8'0)
   (rspu_cpw_64w_wdata <- 8'0)
   (-> idle)
  )
 )
)



(?top:lte_dif_rxdu   rxdu_fifo_clear  rxdu_fifo_status>2=2'0   ; # FIXME FIXME FIXME FIXME FIXME FIXME FIXME FIXME
