(?top:lte_dif_ppimon
 clk
 rst_n
 s_rst_n


 ppimon_mode
 ppimon_start_time<19
 ppimon_stop_time<19
 tg_timestamp<19

 ppimon_start_addr<20
 ppimon_end_addr<20
 ppimon_cur_addr>20
 ppimon_lcm_burst_size<7


 cmi_rdy_wr
 cmi_wr_fifo_full
 ppimon_cmi_burst_size_wr>7
 ppimon_cmi_last_word_wr>
 ppimon_cmi_infinite_wr>
 ppimon_cmi_word_wr_en>4
 ppimon_cmi_bypass_wr>
 ppimon_cmi_flush_wr>
 ppimon_cmi_rqst_wr_port>
 ppimon_cmi_wr_fifo_wr>
 ppimon_cmi_wr_data_wr_port>64


 ; # ppimon_fifo_full
 ; # ppimon_fifo_wr>
 ; # ppimon_mem_wdata>64
 ppimon_fifo_valid
 ppimon_fifo_empty
 ppimon_fifo_aempty
 ppimon_fifo_aempty_thres>9
 ppimon_fifo_rd>
 ppimon_mem_rdata<64

 aempty_thres>7 +endtop=move_port_2signal#^aempty_thres  +declarch=decl_signal_from_port
 +beginarch=assign_add#{ppimon_fifo_aempty_thres:"00" & aempty_thres}

 (?toplink:lte_dif_cmi_write
   /burst_done/open/              ; # FIXME FIXME FIXME
   /burst_ack/open/
   /burst_aempty/ppimon_fifo_aempty/
   /burst_threshold/aempty_thres/
   /burst_rdata/ppimon_mem_rdata/
   /burst_rd$/ppimon_fifo_rd/

   /cmi_wr_ready/cmi_rdy_wr/
   /cmi_burst_wr_req/ppimon_cmi_rqst_wr_port/
   /cmi_fifo_wr/ppimon_cmi_wr_fifo_wr/
   /cmi_fifo_full/cmi_wr_fifo_full/
   /cmi_len_addr_or_data/ppimon_cmi_wr_data_wr_port/
