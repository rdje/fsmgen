; Bounded AMBA AHB requester/master model in active FSMGen ?fsm syntax.
; Scope:
; - requester side only
; - one local command active at a time
; - arbitration through HBUSREQ / HGRANT
; - supports SINGLE, INCR, INCR4/8/16, WRAP4/WRAP8/WRAP16
; - first beat uses HTRANS=NONSEQ, later beats use HTRANS=SEQ
; - wait states handled via HREADY
; - response handling for OKAY / ERROR / RETRY / SPLIT
; - richer local-side interface through cmd_* inputs and status outputs

(?fsm:amba_requester

  (+system
    (clock clk)
    (asreset rstn)
  )

  (:= addr_q=32'h00000000)
  (:= write_q=0)
  (:= size_q=3'b010)
  (:= prot_q=4'b0001)
  (:= lock_q=0)
  (:= burst_q=3'b000)
  (:= len_q=5'b00001)
  (:= beats_total_q=5'b00001)
  (:= beats_remaining_q=5'b00001)
  (:= beat_index_q=5'b00000)
  (:= addr_step_q=32'h00000004)
  (:= wrap_mode_q=0)
  (:= burst_active_q=0)
  (:= wrap_span_q=32'h00000000)
  (:= wrap_base_q=32'h00000000)
  (:= wrap_high_q=32'h00000000)
  (:= wdata_q=32'h00000000)
  (:= wdata_step_q=32'h00000000)
  (:= last_error=0)
  (:= last_retry=0)
  (:= last_split=0)
  (:= last_resp=2'b00)
  (:= last_read_data=32'h00000000)

  (+size
    (cmd_valid 1)
    (cmd_write 1)
    (cmd_addr 32)
    (cmd_wdata 32)
    (cmd_wdata_step 32)
    (cmd_size 3)
    (cmd_prot 4)
    (cmd_lock 1)
    (cmd_burst 3)
    (cmd_len 5)
    (HGRANT 1)
    (HREADY 1)
    (HRESP 2)
    (HRDATA 32)
    (HBUSREQ 1)
    (HLOCK 1)
    (HADDR 32)
    (HTRANS 2)
    (HWRITE 1)
    (HSIZE 3)
    (HBURST 3)
    (HPROT 4)
    (HWDATA 32)
    (cmd_ready 1)
    (busy 1)
    (beat_done 1)
    (done 1)
    (burst_active 1)
    (wrap_active 1)
    (beat_index 5)
    (beats_remaining 5)
    (active_addr 32)
    (active_hburst 3)
    (last_error 1)
    (last_retry 1)
    (last_split 1)
    (last_resp 2)
    (last_read_data 32)
    (addr_q 32)
    (write_q 1)
    (size_q 3)
    (prot_q 4)
    (lock_q 1)
    (burst_q 3)
    (len_q 5)
    (beats_total_q 5)
    (beats_remaining_q 5)
    (beat_index_q 5)
    (addr_step_q 32)
    (wrap_mode_q 1)
    (burst_active_q 1)
    (wrap_span_q 32)
    (wrap_base_q 32)
    (wrap_high_q 32)
    (wdata_q 32)
    (wdata_step_q 32)
  )

  (idle
    (HBUSREQ> = 0)
    (HLOCK> = 0)
    (HADDR> = 32'h00000000)
    (HTRANS> = 2'b00)
    (HWRITE> = 0)
    (HSIZE> = 3'b010)
    (HBURST> = 3'b000)
    (HPROT> = 4'b0001)
    (HWDATA> = 32'h00000000)
    (cmd_ready> = 1)
    (busy> = 0)
    (beat_done> = 0)
    (done> = 0)
    (burst_active> = 0)
    (wrap_active> = 0)
    (beat_index> = 5'b00000)
    (beats_remaining> = 5'b00000)
    (active_addr> = 32'h00000000)
    (active_hburst> = 3'b000)

    (<cmd_valid
      (addr_q <= cmd_addr)
      (write_q <= cmd_write)
      (size_q <= cmd_size)
      (prot_q <= cmd_prot)
      (lock_q <= cmd_lock)
      (burst_q <= cmd_burst)
      (len_q <= cmd_len)
      (wdata_q <= cmd_wdata)
      (wdata_step_q <= cmd_wdata_step)
      (beat_index_q <= 5'b00000)
      (last_error> <= 0)
      (last_retry> <= 0)
      (last_split> <= 0)
      (last_resp> <= 2'b00)
      (-> decode_burst)
    )
  )

  (decode_burst
    (HBUSREQ> = 0)
    (HLOCK> = 0)
    (HADDR> = addr_q)
    (HTRANS> = 2'b00)
    (HWRITE> = write_q)
    (HSIZE> = size_q)
    (HBURST> = burst_q)
    (HPROT> = prot_q)
    (HWDATA> = wdata_q)
    (cmd_ready> = 0)
    (busy> = 1)
    (beat_done> = 0)
    (done> = 0)
    (burst_active> = burst_active_q)
    (wrap_active> = wrap_mode_q)
    (beat_index> = beat_index_q)
    (beats_remaining> = beats_remaining_q)
    (active_addr> = addr_q)
    (active_hburst> = burst_q)

    (?burst_q
      (=3'b000
        (beats_total_q <= 5'b00001)
        (beats_remaining_q <= 5'b00001)
        (wrap_mode_q <= 0)
        (burst_active_q <= 0)
        (-> decode_size)
      )
      (=3'b001
        (<len_q=5'b00000
          (beats_total_q <= 5'b00001)
          (beats_remaining_q <= 5'b00001)
        )
        (<len_q!=5'b00000
          (beats_total_q <= len_q)
          (beats_remaining_q <= len_q)
        )
        (wrap_mode_q <= 0)
        (burst_active_q <= 1)
        (-> decode_size)
      )
      (=3'b010
        (beats_total_q <= 5'b00100)
        (beats_remaining_q <= 5'b00100)
        (wrap_mode_q <= 1)
        (burst_active_q <= 1)
        (-> decode_size)
      )
      (=3'b011
        (beats_total_q <= 5'b00100)
        (beats_remaining_q <= 5'b00100)
        (wrap_mode_q <= 0)
        (burst_active_q <= 1)
        (-> decode_size)
      )
      (=3'b100
        (beats_total_q <= 5'b01000)
        (beats_remaining_q <= 5'b01000)
        (wrap_mode_q <= 1)
        (burst_active_q <= 1)
        (-> decode_size)
      )
      (=3'b101
        (beats_total_q <= 5'b01000)
        (beats_remaining_q <= 5'b01000)
        (wrap_mode_q <= 0)
        (burst_active_q <= 1)
        (-> decode_size)
      )
      (=3'b110
        (beats_total_q <= 5'b10000)
        (beats_remaining_q <= 5'b10000)
        (wrap_mode_q <= 1)
        (burst_active_q <= 1)
        (-> decode_size)
      )
      (=3'b111
        (beats_total_q <= 5'b10000)
        (beats_remaining_q <= 5'b10000)
        (wrap_mode_q <= 0)
        (burst_active_q <= 1)
        (-> decode_size)
      )
    )
  )

  (decode_size
    (HBUSREQ> = 0)
    (HLOCK> = 0)
    (HADDR> = addr_q)
    (HTRANS> = 2'b00)
    (HWRITE> = write_q)
    (HSIZE> = size_q)
    (HBURST> = burst_q)
    (HPROT> = prot_q)
    (HWDATA> = wdata_q)
    (cmd_ready> = 0)
    (busy> = 1)
    (beat_done> = 0)
    (done> = 0)
    (burst_active> = burst_active_q)
    (wrap_active> = wrap_mode_q)
    (beat_index> = beat_index_q)
    (beats_remaining> = beats_remaining_q)
    (active_addr> = addr_q)
    (active_hburst> = burst_q)

    (?size_q
      (=3'b000
        (addr_step_q <= 32'h00000001)
        (-> decode_wrap)
      )
      (=3'b001
        (addr_step_q <= 32'h00000002)
        (-> decode_wrap)
      )
      (=3'b010
        (addr_step_q <= 32'h00000004)
        (-> decode_wrap)
      )
      (=3'b011
        (addr_step_q <= 32'h00000008)
        (-> decode_wrap)
      )
      (=3'b100
        (addr_step_q <= 32'h00000010)
        (-> decode_wrap)
      )
      (=3'b101
        (addr_step_q <= 32'h00000020)
        (-> decode_wrap)
      )
      (=3'b110
        (addr_step_q <= 32'h00000040)
        (-> decode_wrap)
      )
      (=3'b111
        (addr_step_q <= 32'h00000080)
        (-> decode_wrap)
      )
    )
  )

  (decode_wrap
    (HBUSREQ> = 0)
    (HLOCK> = 0)
    (HADDR> = addr_q)
    (HTRANS> = 2'b00)
    (HWRITE> = write_q)
    (HSIZE> = size_q)
    (HBURST> = burst_q)
    (HPROT> = prot_q)
    (HWDATA> = wdata_q)
    (cmd_ready> = 0)
    (busy> = 1)
    (beat_done> = 0)
    (done> = 0)
    (burst_active> = burst_active_q)
    (wrap_active> = wrap_mode_q)
    (beat_index> = beat_index_q)
    (beats_remaining> = beats_remaining_q)
    (active_addr> = addr_q)
    (active_hburst> = burst_q)

    (<wrap_mode_q
      (wrap_span_q <= (* beats_total_q addr_step_q))
      (wrap_base_q <= (- addr_q (% addr_q (* beats_total_q addr_step_q))))
      (wrap_high_q <= (+ (- addr_q (% addr_q (* beats_total_q addr_step_q))) (* beats_total_q addr_step_q)))
      (-> request)
    )
    (<!wrap_mode_q
      (wrap_span_q <= 32'h00000000)
      (wrap_base_q <= 32'h00000000)
      (wrap_high_q <= 32'h00000000)
      (-> request)
    )
  )

  (request
    (HBUSREQ> = 1)
    (HLOCK> = lock_q)
    (HADDR> = addr_q)
    (HTRANS> = 2'b00)
    (HWRITE> = write_q)
    (HSIZE> = size_q)
    (HBURST> = burst_q)
    (HPROT> = prot_q)
    (HWDATA> = wdata_q)
    (cmd_ready> = 0)
    (busy> = 1)
    (beat_done> = 0)
    (done> = 0)
    (burst_active> = burst_active_q)
    (wrap_active> = wrap_mode_q)
    (beat_index> = beat_index_q)
    (beats_remaining> = beats_remaining_q)
    (active_addr> = addr_q)
    (active_hburst> = burst_q)

    (<HGRANT
      (<HREADY
        (<beat_index_q=5'b00000
          (-> transfer_nseq)
        )
        (<beat_index_q!=5'b00000
          (-> transfer_seq)
        )
      )
    )
  )

  (transfer_nseq
    (HBUSREQ> = 1)
    (HLOCK> = lock_q)
    (HADDR> = addr_q)
    (HTRANS> = 2'b10)
    (HWRITE> = write_q)
    (HSIZE> = size_q)
    (HBURST> = burst_q)
    (HPROT> = prot_q)
    (HWDATA> = wdata_q)
    (cmd_ready> = 0)
    (busy> = 1)
    (beat_done> = 0)
    (done> = 0)
    (burst_active> = burst_active_q)
    (wrap_active> = wrap_mode_q)
    (beat_index> = beat_index_q)
    (beats_remaining> = beats_remaining_q)
    (active_addr> = addr_q)
    (active_hburst> = burst_q)

    (<HREADY
      (?HRESP
        (=2'b00
          (beat_done> = 1)
          (last_resp> <= 2'b00)
          (<!write_q
            (last_read_data> <= HRDATA)
          )
          (<beats_remaining_q=5'b00001
            (done> = 1)
            (burst_active_q <= 0)
            (-> idle)
          )
          (<beats_remaining_q!=5'b00001
            (beats_remaining_q <= (- beats_remaining_q 1))
            (beat_index_q <= (+ beat_index_q 1))
            (<write_q
              (wdata_q <= (+ wdata_q wdata_step_q))
            )
            (<wrap_mode_q
              (<(== (+ addr_q addr_step_q) wrap_high_q)
                (addr_q <= wrap_base_q)
              )
              (<!(== (+ addr_q addr_step_q) wrap_high_q)
                (addr_q <= (+ addr_q addr_step_q))
              )
            )
            (<!wrap_mode_q
              (addr_q <= (+ addr_q addr_step_q))
            )
            (-> transfer_seq)
          )
        )
        (=2'b01
          (done> = 1)
          (last_error> <= 1)
          (last_resp> <= 2'b01)
          (burst_active_q <= 0)
          (-> idle)
        )
        (=2'b10
          (last_retry> <= 1)
          (last_resp> <= 2'b10)
          (-> request)
        )
        (=2'b11
          (last_split> <= 1)
          (last_resp> <= 2'b11)
          (-> request)
        )
      )
    )
  )

  (transfer_seq
    (HBUSREQ> = 1)
    (HLOCK> = lock_q)
    (HADDR> = addr_q)
    (HTRANS> = 2'b11)
    (HWRITE> = write_q)
    (HSIZE> = size_q)
    (HBURST> = burst_q)
    (HPROT> = prot_q)
    (HWDATA> = wdata_q)
    (cmd_ready> = 0)
    (busy> = 1)
    (beat_done> = 0)
    (done> = 0)
    (burst_active> = burst_active_q)
    (wrap_active> = wrap_mode_q)
    (beat_index> = beat_index_q)
    (beats_remaining> = beats_remaining_q)
    (active_addr> = addr_q)
    (active_hburst> = burst_q)

    (<HREADY
      (?HRESP
        (=2'b00
          (beat_done> = 1)
          (last_resp> <= 2'b00)
          (<!write_q
            (last_read_data> <= HRDATA)
          )
          (<beats_remaining_q=5'b00001
            (done> = 1)
            (burst_active_q <= 0)
            (-> idle)
          )
          (<beats_remaining_q!=5'b00001
            (beats_remaining_q <= (- beats_remaining_q 1))
            (beat_index_q <= (+ beat_index_q 1))
            (<write_q
              (wdata_q <= (+ wdata_q wdata_step_q))
            )
            (<wrap_mode_q
              (<(== (+ addr_q addr_step_q) wrap_high_q)
                (addr_q <= wrap_base_q)
              )
              (<!(== (+ addr_q addr_step_q) wrap_high_q)
                (addr_q <= (+ addr_q addr_step_q))
              )
            )
            (<!wrap_mode_q
              (addr_q <= (+ addr_q addr_step_q))
            )
            (-> transfer_seq)
          )
        )
        (=2'b01
          (done> = 1)
          (last_error> <= 1)
          (last_resp> <= 2'b01)
          (burst_active_q <= 0)
          (-> idle)
        )
        (=2'b10
          (last_retry> <= 1)
          (last_resp> <= 2'b10)
          (-> request)
        )
        (=2'b11
          (last_split> <= 1)
          (last_resp> <= 2'b11)
          (-> request)
        )
      )
    )
  )
)
