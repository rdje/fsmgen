#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=../scripts/project_data_locality_env.sh
source "$REPO_ROOT/scripts/project_data_locality_env.sh"

cd "$REPO_ROOT"

MODE="full"
RUN_BOOK=1
DRY_RUN=0
HOSTED_FILE_SHARD=""
HOSTED_DEDICATED_SHARD=""
HOSTED_DYNAMIC_SHARD=""
HOSTED_CORPUS_SHARD=""

HOSTED_DEDICATED_COUNT=5
HOSTED_DEDICATED_TEST_0="t/1436-ial2-ppif-parser-cli.t"
HOSTED_DEDICATED_TEST_1="t/1437-axi-ial2-manager-capacity-status-generator.t"
HOSTED_DEDICATED_TEST_2="t/1598-vial-vhdl-osvvm-emission.t"
HOSTED_DEDICATED_TEST_3="t/1648-vial-architecture-scale-backend-emission-osvvm.t"
HOSTED_DEDICATED_TEST_4="t/1650-vial-architecture-scale-backend-emission-family-qualification.t"
HOSTED_DYNAMIC_TEST="t/1438-axi-ial2-manager-dynamic-transaction-id-focused.t"
HOSTED_CORPUS_TEST_296="t/296-regression-corpus-supported-behavior.t"
HOSTED_CORPUS_TEST_301="t/301-check-json-supported-corpus.t"
HOSTED_CORPUS_TEST_303="t/303-normalized-semantic-json-supported-corpus.t"
HOSTED_CORPUS_TEST_1884="t/1884-semantic-source-query-runner.t"

QUICK_TESTS=(
  t/01-regression.t
  t/03-assignment-intent-metadata.t
  t/13-composition-source-classification.t
  t/29-language-contract-core-forms.t
  t/84-composition-external-fsm-child-sources.t
  t/1091-isf-parser-apb-requester.t
  t/1094-isf-scheduler-module-header.t
  t/1112-isf-public-interface-contract.t
)

# Closed, reviewed downstream checks; exhaustive scenario families stay in full.
# Changed behavior also needs its own focused checks before the publication gate.
PRE_PUSH_TESTS=(
  "${QUICK_TESTS[@]}"
  t/208-enable-graph-ast-support.t
  t/1183-ci-regression-tier-selection.t
  t/1435-axi-ial2-valid-ready-generator.t
  t/1473-ial2-ahb-requester.t
  t/1475-ial2-ahb-subordinate.t
  t/1500-ial2-axi-w-driver.t
  t/1505-ial2-axi-r-beat-acceptor.t
  t/1548-source-hir-phase-control.t
  t/1555-vial-public-source-tooling.t
  t/1556-vial-public-planning-artifacts.t
  t/1867-isf-apb-completion-outputs.t
  t/1885-semantic-source-query-oracles.t
  t/1892-explicit-reset-hdl-behavior.t
  t/2302-process-group-admission-order.t
)

shopt -s nullglob
ISF_TESTS=(t/109[1-9]-isf*.t t/11[0-9][0-9]-isf*.t t/12[0-9][0-9]-isf*.t t/13[0-9][0-9]-isf*.t)
shopt -u nullglob
IFS=$'\n' ISF_TESTS=($(printf '%s\n' "${ISF_TESTS[@]}" | sort))
unset IFS

usage() {
  cat <<'USAGE'
Usage: ./bin/ci-regression [pre-push|quick|smoke|isf|vial-gate|full] [options]

Modes:
  pre-push
         Critical downstream compilation, public contracts, protocol timing,
         VIAL tooling and containment checks, an APB target CLI check, and book.
         Run focused checks for changed behavior too; full coverage stays in CI.
  quick  Curated smoke set for fast turnaround across direct FSM,
         composition classification, one composition child path, ISF parse,
         ISF schedule, and the ISF public contract.
  smoke  Alias for quick.
  isf    All ISF-focused tests in the 109x, 11xx, 12xx, and 13xx numbered bands.
  vial-gate
         Selected-important-step execution of the authenticated, guarded VIAL
         regression-promotion gate lifecycle without the ordinary Perl suite.
  full   Complete Perl regression suite. This is the default.

Options:
  --no-book                     Skip mdBook build for this invocation.
  --dry-run                     Print selected steps without executing them.
  --hosted-file-shard I/N       Run file shard I of N, excluding the separately
                                scheduled dedicated, corpus, and dynamic tests.
  --hosted-dedicated-shard I/5  Run one exact long/provider-dependent test.
  --hosted-dynamic-shard I/N    Run case shard I of N from the dynamic
                                transaction-ID focused test.
  --hosted-corpus-shard T:I/N   Run entry shard I of N from supported-corpus
                                test T, where T is 296, 301, 303, or 1884.
  --list                        Print the concrete quick, ISF and pre-push lists.
  --help                        Show this help text.

Hosted shard options are full-mode CI plumbing. They are zero-based, mutually
exclusive, require --no-book, and bypass the unsharded local gate lifecycle.
Full local regression and corpus test 1884 select every supported source query;
ambient source filters, corpus list-only mode and shard coordinates are refused.
USAGE
}

list_modes() {
  printf 'quick tests:\n'
  printf '  %s\n' "${QUICK_TESTS[@]}"
  printf 'isf tests:\n'
  printf '  %s\n' "${ISF_TESTS[@]}"
  printf 'selected important step:\n'
  printf '  vial-gate\n'
  printf 'pre-push tests:\n'
  printf '  %s\n' "${PRE_PUSH_TESTS[@]}"
  printf 'pre-push public CLI:\n'
  printf '  ./bin/fsmgen --quiet --strict --check --json ppif/apb_completer.ppif\n'
  printf '  ./bin/fsmgen --quiet --strict --verify-hdl ppif/apb_completer.ppif\n'
}

require_tool() {
  local tool="$1"
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf 'ci-regression: missing required tool: %s\n' "$tool" >&2
    exit 1
  fi
}

run_step() {
  local label="$1"
  shift
  printf '==> %s\n' "$label"
  if (( DRY_RUN )); then
    printf '    %q' "$@"
    printf '\n'
    return 0
  fi
  "$@"
}

run_vial_regression_promotion_gate_lifecycle() {
  local primary_status=0
  local cleanup_status=0

  run_step "VIAL regression-promotion evidence materialization" \
    perl scripts/materialize_vial_regression_promotion_gate_evidence.pl \
    materialize || return $?

  run_step "VIAL regression-promotion current-corpus validation" \
    perl scripts/verify_vial_regression_promotion_current_corpus.pl \
    || primary_status=$?
  if (( primary_status == 0 )); then
    run_step "VIAL regression-promotion budget-qualification validation" \
      perl scripts/verify_vial_regression_promotion_budget_qualification.pl \
      || primary_status=$?
  fi
  if (( primary_status == 0 )); then
    run_step "VIAL regression-promotion guarded gate" \
      scripts/run_with_ram_guard.sh -- \
      scripts/run_vial_regression_promotion_gate.pl --run \
      || primary_status=$?
  fi

  run_step "VIAL regression-promotion evidence cleanup" \
    perl scripts/materialize_vial_regression_promotion_gate_evidence.pl \
    cleanup || cleanup_status=$?

  if (( primary_status != 0 )); then
    if (( cleanup_status != 0 )); then
      printf 'ci-regression: evidence cleanup failed with status %s after gate lifecycle status %s\n' \
        "$cleanup_status" "$primary_status" >&2
    fi
    return "$primary_status"
  fi
  return "$cleanup_status"
}

require_test_files() {
  local test_file
  for test_file in "$@"; do
    if [[ ! -f "$test_file" ]]; then
      printf 'ci-regression: selected test file does not exist: %s\n' "$test_file" >&2
      exit 1
    fi
  done
}

validate_shard_spec() {
  local option="$1"
  local spec="$2"
  local index
  local count

  if [[ ! "$spec" =~ ^([0-9]+)/([1-9][0-9]*)$ ]]; then
    printf 'ci-regression: %s requires zero-based I/N integers: %s\n' "$option" "$spec" >&2
    exit 2
  fi

  index="${BASH_REMATCH[1]}"
  count="${BASH_REMATCH[2]}"
  if (( index >= count )); then
    printf 'ci-regression: %s index %s is outside shard count %s\n' "$option" "$index" "$count" >&2
    exit 2
  fi
}

validate_hosted_corpus_spec() {
  local spec="$1"
  local test_id
  local shard_spec

  if [[ ! "$spec" =~ ^(296|301|303|1884):([0-9]+/[1-9][0-9]*)$ ]]; then
    printf 'ci-regression: --hosted-corpus-shard requires T:I/N with T in 296,301,303,1884: %s\n' "$spec" >&2
    exit 2
  fi

  test_id="${BASH_REMATCH[1]}"
  shard_spec="${BASH_REMATCH[2]}"
  validate_shard_spec "--hosted-corpus-shard $test_id" "$shard_spec"
}

hosted_corpus_test_file() {
  case "$1" in
    296) printf '%s\n' "$HOSTED_CORPUS_TEST_296" ;;
    301) printf '%s\n' "$HOSTED_CORPUS_TEST_301" ;;
    303) printf '%s\n' "$HOSTED_CORPUS_TEST_303" ;;
    1884) printf '%s\n' "$HOSTED_CORPUS_TEST_1884" ;;
    *)
      printf 'ci-regression: unknown hosted corpus test id: %s\n' "$1" >&2
      exit 2
      ;;
  esac
}

validate_hosted_dedicated_spec() {
  local spec="$1"
  local count="${spec#*/}"

  validate_shard_spec --hosted-dedicated-shard "$spec"
  if (( count != HOSTED_DEDICATED_COUNT )); then
    printf 'ci-regression: --hosted-dedicated-shard requires I/%s: %s\n' \
      "$HOSTED_DEDICATED_COUNT" "$spec" >&2
    exit 2
  fi
}

hosted_dedicated_test_file() {
  case "$1" in
    0) printf '%s\n' "$HOSTED_DEDICATED_TEST_0" ;;
    1) printf '%s\n' "$HOSTED_DEDICATED_TEST_1" ;;
    2) printf '%s\n' "$HOSTED_DEDICATED_TEST_2" ;;
    3) printf '%s\n' "$HOSTED_DEDICATED_TEST_3" ;;
    4) printf '%s\n' "$HOSTED_DEDICATED_TEST_4" ;;
    *)
      printf 'ci-regression: unknown hosted dedicated test index: %s\n' "$1" >&2
      exit 2
      ;;
  esac
}

is_separately_hosted_test() {
  case "$1" in
    "$HOSTED_DEDICATED_TEST_0"|\
    "$HOSTED_DEDICATED_TEST_1"|\
    "$HOSTED_DEDICATED_TEST_2"|\
    "$HOSTED_DEDICATED_TEST_3"|\
    "$HOSTED_DEDICATED_TEST_4"|\
    "$HOSTED_DYNAMIC_TEST"|\
    "$HOSTED_CORPUS_TEST_296"|\
    "$HOSTED_CORPUS_TEST_301"|\
    "$HOSTED_CORPUS_TEST_303"|\
    "$HOSTED_CORPUS_TEST_1884") return 0 ;;
    *) return 1 ;;
  esac
}

select_hosted_file_shard() {
  local spec="$1"
  local index="${spec%/*}"
  local count="${spec#*/}"
  local ordinary_index=0
  local test_file
  local -a full_tests=()
  local -a selected_tests=()

  require_tool git
  while IFS= read -r test_file; do
    full_tests+=("$test_file")
  done < <(git ls-files 't/*.t' | LC_ALL=C sort)

  require_test_files "${full_tests[@]}"
  for test_file in "${full_tests[@]}"; do
    if is_separately_hosted_test "$test_file"; then
      continue
    fi
    if (( ordinary_index % count == index )); then
      selected_tests+=("$test_file")
    fi
    ((ordinary_index += 1))
  done

  if (( ${#selected_tests[@]} == 0 )); then
    printf 'ci-regression: hosted file shard %s selected no tests\n' "$spec" >&2
    exit 1
  fi

  run_step "Perl regression file shard $spec" prove -I perl "${selected_tests[@]}"
}

run_hosted_dedicated_shard() {
  local spec="$1"
  local index="${spec%/*}"
  local test_file

  test_file="$(hosted_dedicated_test_file "$index")"
  require_test_files "$test_file"
  run_step "Perl dedicated test $index/$HOSTED_DEDICATED_COUNT" \
    prove -I perl "$test_file"
}

run_hosted_dynamic_shard() {
  local spec="$1"
  local index="${spec%/*}"
  local count="${spec#*/}"

  require_test_files "$HOSTED_DYNAMIC_TEST"
  require_tool env
  run_step "Perl dynamic transaction-ID case shard $spec" \
    env \
    "FSMGEN_DYNAMIC_CASE_SHARD_INDEX=$index" \
    "FSMGEN_DYNAMIC_CASE_SHARD_COUNT=$count" \
    prove -I perl "$HOSTED_DYNAMIC_TEST"
}

run_hosted_corpus_shard() {
  local spec="$1"
  local test_id="${spec%%:*}"
  local shard_spec="${spec#*:}"
  local index="${shard_spec%/*}"
  local count="${shard_spec#*/}"
  local test_file

  test_file="$(hosted_corpus_test_file "$test_id")"
  require_test_files "$test_file"
  require_tool env
  if [[ "$test_id" == 1884 ]]; then
    run_step "Perl supported-corpus test $test_id entry shard $shard_spec" \
      env \
      "FSMGEN_HOSTED_CORPUS_SHARD_INDEX=$index" \
      "FSMGEN_HOSTED_CORPUS_SHARD_COUNT=$count" \
      FSMGEN_SOURCE_QUERY_ALL=1 \
      prove -I perl "$test_file"
    return
  fi
  run_step "Perl supported-corpus test $test_id entry shard $shard_spec" \
    env \
    "FSMGEN_HOSTED_CORPUS_SHARD_INDEX=$index" \
    "FSMGEN_HOSTED_CORPUS_SHARD_COUNT=$count" \
    prove -I perl "$test_file"
}

while (($#)); do
  case "$1" in
    quick|smoke|isf|vial-gate|full|pre-push)
      MODE="$1"
      ;;
    --no-book)
      RUN_BOOK=0
      ;;
    --dry-run)
      DRY_RUN=1
      ;;
    --hosted-file-shard)
      if (($# < 2)); then
        printf 'ci-regression: --hosted-file-shard requires I/N\n' >&2
        exit 2
      fi
      HOSTED_FILE_SHARD="$2"
      shift
      ;;
    --hosted-file-shard=*)
      HOSTED_FILE_SHARD="${1#*=}"
      ;;
    --hosted-dedicated-shard)
      if (($# < 2)); then
        printf 'ci-regression: --hosted-dedicated-shard requires I/5\n' >&2
        exit 2
      fi
      HOSTED_DEDICATED_SHARD="$2"
      shift
      ;;
    --hosted-dedicated-shard=*)
      HOSTED_DEDICATED_SHARD="${1#*=}"
      ;;
    --hosted-dynamic-shard)
      if (($# < 2)); then
        printf 'ci-regression: --hosted-dynamic-shard requires I/N\n' >&2
        exit 2
      fi
      HOSTED_DYNAMIC_SHARD="$2"
      shift
      ;;
    --hosted-dynamic-shard=*)
      HOSTED_DYNAMIC_SHARD="${1#*=}"
      ;;
    --hosted-corpus-shard)
      if (($# < 2)); then
        printf 'ci-regression: --hosted-corpus-shard requires T:I/N\n' >&2
        exit 2
      fi
      HOSTED_CORPUS_SHARD="$2"
      shift
      ;;
    --hosted-corpus-shard=*)
      HOSTED_CORPUS_SHARD="${1#*=}"
      ;;
    --list)
      list_modes
      exit 0
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      printf 'ci-regression: unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [[ -n "$HOSTED_FILE_SHARD" ]]; then
  validate_shard_spec --hosted-file-shard "$HOSTED_FILE_SHARD"
fi
if [[ -n "$HOSTED_DEDICATED_SHARD" ]]; then
  validate_hosted_dedicated_spec "$HOSTED_DEDICATED_SHARD"
fi
if [[ -n "$HOSTED_DYNAMIC_SHARD" ]]; then
  validate_shard_spec --hosted-dynamic-shard "$HOSTED_DYNAMIC_SHARD"
fi
if [[ -n "$HOSTED_CORPUS_SHARD" ]]; then
  validate_hosted_corpus_spec "$HOSTED_CORPUS_SHARD"
fi
hosted_shard_family_count=0
if [[ -n "$HOSTED_FILE_SHARD" ]]; then
  ((hosted_shard_family_count += 1))
fi
if [[ -n "$HOSTED_DEDICATED_SHARD" ]]; then
  ((hosted_shard_family_count += 1))
fi
if [[ -n "$HOSTED_DYNAMIC_SHARD" ]]; then
  ((hosted_shard_family_count += 1))
fi
if [[ -n "$HOSTED_CORPUS_SHARD" ]]; then
  ((hosted_shard_family_count += 1))
fi
if (( hosted_shard_family_count > 1 )); then
  printf 'ci-regression: hosted shard families are mutually exclusive\n' >&2
  exit 2
fi
if (( hosted_shard_family_count > 0 )) && [[ "$MODE" != "full" ]]; then
  printf 'ci-regression: hosted shards require full mode\n' >&2
  exit 2
fi
if (( hosted_shard_family_count > 0 )) && [[ "$RUN_BOOK" -ne 0 ]]; then
  printf 'ci-regression: hosted shards require --no-book; the workflow builds the book separately\n' >&2
  exit 2
fi

# A full qualification must not inherit a developer's narrower source filter,
# list-only shortcut, or stale shard coordinates. Explicit hosted coordinates
# below are the sole authority for partitioning the complete query cohort.
if [[ "$MODE" == full ]] && { (( hosted_shard_family_count == 0 )) || [[ "$HOSTED_CORPUS_SHARD" == 1884:* ]]; }; then
  for source_query_selector in FSMGEN_SOURCE_QUERY_SOURCES FSMGEN_HOSTED_CORPUS_LIST_ONLY \
      FSMGEN_HOSTED_CORPUS_SHARD_INDEX FSMGEN_HOSTED_CORPUS_SHARD_COUNT; do
    if [[ -n "${!source_query_selector+x}" ]]; then
      printf 'ci-regression: full source-query coverage refuses ambient %s; use direct focused prove for developer selection\n' \
        "$source_query_selector" >&2
      exit 2
    fi
  done
fi

if (( ! DRY_RUN )); then
  if [[ "$MODE" == "pre-push" ]]; then
    for native_tool in verilator yosys; do
      require_tool "$native_tool"
    done
    # Darwin's legacy Verilator guard stays intact. Require the existing GHDL
    # reset witness instead of accepting a gate with no native timing coverage.
    if [[ "$(uname -s)" == Darwin ]] \
        && [[ "${FSMGEN_DARWIN_VERILATOR_TEST_RUNTIME:-}" != 1 ]]; then
      if [[ -z "${FSMGEN_RESET_GHDL:-}" ]] && ! command -v ghdl >/dev/null 2>&1; then
        reset_provider='.artifacts/cache/providers/ghdl/6.0.0/llvm-jit-tool/ghdl-llvm-jit-6.0.0-macos15-aarch64/bin/ghdl'
        if [[ -x "$reset_provider" ]]; then
          export FSMGEN_RESET_GHDL="$reset_provider"
        fi
      fi
      require_tool "${FSMGEN_RESET_GHDL:-ghdl}"
    fi
  fi
  if [[ "$MODE" != "vial-gate" ]]; then
    require_tool prove
  fi
  if [[ "$MODE" == "vial-gate" ]] \
      || { [[ "$MODE" == "full" ]] && (( hosted_shard_family_count == 0 )); }; then
    require_tool perl
  fi
  if (( RUN_BOOK )); then
    require_tool mdbook
  fi
fi

case "$MODE" in
  pre-push)
    require_test_files "${PRE_PUSH_TESTS[@]}"
    run_step "Perl critical downstream suite" prove -I perl "${PRE_PUSH_TESTS[@]}"
    run_step "APB target public strict CLI" \
      ./bin/fsmgen --quiet --strict --check --json ppif/apb_completer.ppif
    run_step "APB target external HDL validation" \
      ./bin/fsmgen --quiet --strict --verify-hdl ppif/apb_completer.ppif
    ;;
  quick|smoke)
    require_test_files "${QUICK_TESTS[@]}"
    run_step "Perl quick smoke suite" prove -I perl "${QUICK_TESTS[@]}"
    ;;
  isf)
    require_test_files "${ISF_TESTS[@]}"
    run_step "Perl ISF regression suite" prove -I perl "${ISF_TESTS[@]}"
    ;;
  vial-gate)
    run_vial_regression_promotion_gate_lifecycle
    ;;
  full)
    if [[ -n "$HOSTED_FILE_SHARD" ]]; then
      select_hosted_file_shard "$HOSTED_FILE_SHARD"
    elif [[ -n "$HOSTED_DEDICATED_SHARD" ]]; then
      run_hosted_dedicated_shard "$HOSTED_DEDICATED_SHARD"
    elif [[ -n "$HOSTED_DYNAMIC_SHARD" ]]; then
      run_hosted_dynamic_shard "$HOSTED_DYNAMIC_SHARD"
    elif [[ -n "$HOSTED_CORPUS_SHARD" ]]; then
      run_hosted_corpus_shard "$HOSTED_CORPUS_SHARD"
    else
      require_tool env
      run_step "Perl regression suite" env FSMGEN_SOURCE_QUERY_ALL=1 prove -I perl t
      run_vial_regression_promotion_gate_lifecycle
    fi
    ;;
esac

if (( RUN_BOOK )); then
  run_step "mdBook build" mdbook build docs/book
fi
