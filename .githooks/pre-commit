#!/usr/bin/env bash
# Local pre-commit gates (E3 of DOCTRINE_ENFORCEMENT.md).
# Activate once per clone: git config core.hooksPath .githooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

# Regenerate the Knowledge Map derived artifact and stage it before the doctrine
# driver checks sync. See knowledge-map/hooks/pre-commit.snippet.
"$ROOT/knowledge-map/scripts/gen_knowledge_map.sh" >/dev/null
git add "$("$ROOT/knowledge-map/scripts/gen_knowledge_map.sh" --print-map-path)" 2>/dev/null || true

"$ROOT/scripts/check_doctrines.sh"
