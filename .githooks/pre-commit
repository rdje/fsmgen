#!/usr/bin/env bash
# Local pre-commit gates (E3 of DOCTRINE_ENFORCEMENT.md).
# Activate once per clone: git config core.hooksPath .githooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

# Regenerate the bounded Knowledge Map root/topic shards and stage additions or
# removals before the doctrine driver checks sync.
"$ROOT/knowledge-map/scripts/gen_knowledge_map.sh" >/dev/null
mapfile -t knowledge_map_paths < <(
  "$ROOT/knowledge-map/scripts/gen_knowledge_map.sh" --print-generated-paths
)
git add -A -- "${knowledge_map_paths[@]}"

"$ROOT/scripts/check_doctrines.sh"
