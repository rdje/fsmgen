#!/usr/bin/env bash
# Local pre-commit gates (E3 of DOCTRINE_ENFORCEMENT.md).
# Activate once per clone: git config core.hooksPath .githooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

# Regenerate the bounded Knowledge Map root/topic shards and stage additions or
# removals before the doctrine driver checks sync.
"$ROOT/knowledge-map/scripts/gen_knowledge_map.sh" >/dev/null
mapfile -t knowledge_map_paths < <(
  "$ROOT/knowledge-map/scripts/gen_knowledge_map.sh" --print-generated-paths
)
git add -A -- "${knowledge_map_paths[@]}"

# Keep the complete focused/ancillary classification projection synchronized
# with the surface registry and current collection membership.
"$ROOT/scripts/focused_document_index.pl" generate >/dev/null
focused_document_index="$("$ROOT/scripts/focused_document_index.pl" --print-output)"
git add -A -- "$focused_document_index"

"$ROOT/scripts/check_doctrines.sh"
